!--------------------------------------------------
! Page 44
!--------------------------------------------------

[StatE_RecordPhrase]
type=log
logmsg="Admin Record"
Next=SetOptionalGreeting

[RecordMainMenu]
type=menu
msg="RecordMainMenu"
OnKey1=SetDailyReportingInstructions
OnKey2=SetOptionalGreeting
OnKey3=SetPhraseToRecord
OnKey9=Exit
OnKeyPound=RecordMainMenu
OnKeyStar=RecordMainMenu

[SetDailyReportingInstructions]
type=changeVariable
PhraseToRecord="DailyReportingInstructions"
Next=RecordMenu

[SetOptionalGreeting]
type=changeVariable
PhraseToRecord="OptionalGreeting"
Next=RecordMenu

[SetPhraseToRecord]
type=VariableManager
VarList="PhraseToRecord"
OnError=LogPhraseToRecordVMFailure
Next=RecordMenu

[LogPhraseToRecordVMFailure]
type=log
logmsg="Error getting Phrase To Record from Variable Manager"

[PlayVMErrorMessage]
type=play
msg="SystemProblem"
Next=RecordMainMenu

!--------------------------------------------------
! Page 45
!--------------------------------------------------

[RecordMenu]
type=log
logmsg="RecordPath = "%RecordPath%", PhraseToRecord = "%PhraseToRecord

[PlayRecordingOptGreeting]
type=play
msg="RecordingOptGreeting"

[RecordMenuBlock]
type=menu
msg="RecordMenu"
OnKey1=RecordMessage
OnKey2=PlayRecordedMessage
OnKey3=RecordMainMenu
OnKey4=Exit
OnKey5=Exit
OnKey9=Exit
OnKeyPound=RecordMenu
OnKeyStar=RecordMenu

[RecordMessage]
type=Record
msg="RecordPrompt"
FlushKeys=1
PlayBeep=1
MaxRecordingSec=600
WaitForMsg=1
FileName=RecordPath%PhraseToRecord
Next=RecordMenu

[PlayRecordedMessage]
type=play
msg=PhraseToRecord
Next=RecordMenu


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!! Quick Record  !!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[QuickRecordFile]
type=Record
msg="QuickRecordPrompt"
!Terminator="#"
FlushKeys=True
PlayBeep=True
!TimeoutSec=300
MaxRecordingSec=600
!VoxTimeoutSec=5
WaitForMsg=True
FileName="RecordedPhrase"
Next=PlayRecordedFile

[PlayRecordedFile]
type=play
msg="RecordedPhrase"
next=Exit

