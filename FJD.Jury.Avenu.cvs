!=================================================
! Sheriff
! 
[U_SheriffMenu]
type=menu
msg="SheriffMenu"
OnKey1=U_SetSheriff
OnKey2=U_SetNotSheriff
OnKeyStar=U_SheriffMenu

[U_SetSheriff]
type=changeVariable
Q6Answer="1"
DisqReason6="DisqualSheriff"
Increment=AnswerSum
Next=U_CurrentCaseMenu

[U_SetNotSheriff]
type=changeVariable
Q6Answer="0"
Next=U_CurrentCaseMenu

!=================================================
! Current Case before the court
! 
[U_CurrentCaseMenu]
type=menu
msg="PartyToCaseMenu"
OnKey1=U_SetCurrentCase
OnKey2=U_SetNotCurrentCase
OnKeyStar=U_CurrentCaseMenu

[U_SetCurrentCase]
type=changeVariable
Q7Answer="1"
DisqReason7="DisqualParty"
Increment=AnswerSum
Next=U_FelonyMenu

[U_SetNotCurrentCase]
type=changeVariable
Q7Answer="0"
Next=U_FelonyMenu

!=================================================
! Felony menu
!=================================================
[U_FelonyMenu]
type=menu
msg="FelonyMenu"
OnKey1=U_SetFelon
OnKey2=U_SetNotAFelon

[U_SetNotAFelon]
type=changeVariable
Q8Answer="0"
Next=U_SubmitQualificationResponses

[U_SetFelon]
type=changeVariable
Q8Answer="1"
DisqReason5="DisqualFelon"
Increment=AnswerSum
DisqualPendingMessage="UFelonInfo"
Next=U_SubmitQualificationResponses

!======================================
! Submit Qualification Responses
! 
[U_SubmitQualificationResponses]
type=log

[CheckAnswerSum]
type=Branch
var=AnswerSum
!0=U_ExecuteProcessQualification
0=DisqualificationConfirmation
OnAboveRange=PlayDisqualificationConfirmation

[PlayDisqualificationConfirmation]
type=play
msg="MayNotBeQualified"
msg=DisqReason1
msg=DisqReason2
msg=DisqReason3
msg=DisqReason4
msg=DisqReason5
msg=DisqReason6
msg=DisqReason7
msg=DisqReason8

[DisqualificationConfirmation]
type=menu
Msg="PerjuryMenuDTMF"
OnKey1=LogQualInput
OnKey2=SendBackToInterview
OnKeyStar=DisqualificationConfirmation
OnKeyPound=PlayDisqualificationConfirmation

[LogQualInput]
type=log
!var=JurorID,DisqReason1,DisqReason2,DisqReason3,DisqReason4,DisqReason5,DisqReason6GJ,DisqReason6,DisqReason7,DisqReason8

[U_ExecuteProcessQualification]
type=log
Next=LogQualOutput

[LogJsErrorPQ]
type=log
var=@Result,@ResultMessage
Next=StatE_SystemError

[LogQualOutput]
type=log
var=CT_JurorID,CT_DOB

[CheckExecPQResult]
type=branch
var=CT_ResultCode
0=U_CheckQualificationStatus

[LogPQProblem]
type=log
logmsg="Execute Process Qualification Failed"
var=CT_ResultCode,CT_ResultMessage
Next=StatE_SystemError

[U_CheckQualificationStatus]
type=branch
var=CT_QualificationStatus
"Qualified"=U_CompletedQualified
"Disqualified"=U_CompletedDisqualified
"Pending Review"=U_CompletedDisqualPendingReview
Next=StatE_SystemError

!--------------------------------
! Completed Questionnaire, Qualfied
! 
[U_CompletedQualified]
type=play
WaitForMsg=true
msg="ThanksQualified"
!msg="UBeSureToCall1"
!msgString=CourtPhoneNumber
!msg="UBeSureToCall2"
msg="PleaseHoldRecordRefresh"
Next=GetJurorRecord

!-----------------------------------
! Completed Questionnaire, Disqualified
! 
[U_CompletedDisqualified]
type=play
msg="UThanks"
msg="PleaseHoldRecordRefresh"
WaitForMsg=true
Next=GetJurorRecord

!----------------------------------------
! Completed Questionnaire, pending review of disqual request
! 
[U_CompletedDisqualPendingReview]
type=play
WaitForMsg=true
msg="DisqualRequestReceived"

[U_CheckDisqualPendingMessage]
type=Branch
var=DisqualPendingMessage
"None"=GetJurorRecord

[U_DisqualPendingMessage]
type=menu
msg=DisqualPendingMessage
msg="DisqualPendingMenu"
OnKeyStar=U_CompletedDisqualPendingReview
OnKey1=GetJurorRecord
OnKey9=Exit
OnKey0=SetScreenMsgForDisqualPending
Next=GetJurorRecord


[SetScreenMsgForDisqualPending]
type=ChangeVariable
ScreenMsg="Requested Agent: Disqual Pending"
Next=ACDAvailable

!----------------------------------------------
! Reset Qualification interview

[SendBackToInterview]
type=changeVariable
increment=RetryCounter

[CheckInterviewRetry]
type=branch
var=RetryCounter
2=UnableCompleteRegistration

[PlayTakeYouBack]
type=play
msg="BackThruInterview"

[ResetInterviewAnswers]
type=changeVariable
Q1Answer=""
Q2Answer=""
Q3Answer=""
Q4Answer=""
Q5Answer=""
Q6Answer=""
Q7Answer=""
Q8Answer=""
AnswerSum=0
DisqReason1=""
DisqReason2=""
DisqReason3=""
DisqReason4=""
DisqReason5=""
DisqReason6=""
DisqReason7=""
DisqReason8=""
DisqualPendingMessage="None"
Next=UnqualifiedInterviewRetry

[UnableCompleteRegistration]
type=log

[PlaySorryUnableComplete]
type=play
msg="Sorry"
Next=ACDAvailable

! 
! End Eligibility & Bio Info Questionnaire
!=========================================================


