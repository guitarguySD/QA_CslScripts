OnKey7=FAQs
OnKey8=ReturnFromFAQ
OnKey9=Exit
OnKey0=StatE_Transfer
OnKeyStar=SetFAQ2
OnKeyPound=PlayFAQ2Menu

[SetFAQ3]
type=changeVariable
FAQMessage = "FAQ3"
Next=PlayFAQMessage

[SetFAQ4]
type=changeVariable
FAQMessage = "FAQ4"
Next=PlayFAQMessage

[SetFAQ5]
type=changeVariable
FAQMessage = "FAQ5"
Next=PlayFAQMessage

[SetFAQ6]
type=changeVariable
FAQMessage = "FAQ6"
Next=PlayFAQMessage

[SetFAQ7]
type=changeVariable
FAQMessage = "FAQ7"
Next=PlayFAQMessage

[SetFAQ8]
type=changeVariable
FAQMessage = "FAQ8"
Next=PlayFAQMessage

!--------------------------------------------------
! Page 42 - Play FAQ Message
!--------------------------------------------------

[PlayFAQMessage]
type=play
msg=FAQMessage

[PlayFAQMenu]
type=menu
msg="FAQReturnMenu"
OnKey7=FAQs
OnKey8=ReturnFromFAQ
OnKey9=Exit
OnKey0=StatE_Transfer
OnKeyStar=PlayFAQMessage
OnKeyPound=PlayFAQMenu

[ReturnFromFAQ]
type=Branch
var=CT_JurorState
"UNKNOWN"=JurorMenu
"ERROR"=StatE_Transfer
"UNDELIVERABLE"=StatE_Transfer
Next=JurorMenu
!============================================
! ACD Call
!============================================
[ACDAvailable]
type=log
Next=SetForAssistanceAvailable

[SetForAssistanceAvailable]
type=VariableManager
OnError=LogACDAvailableVMFailure
VarList="AssistanceAvailable"

[CheckOfficeOpenForJuryOperator]
Type=Branch
Var=AssistanceAvailable
0=NoOperator
1=PleaseHold
Next=LogACDAvailableVMFailure

[NoOperator]
type=Play
msg="NoOperators1"
msgstring=OperatorOpen%"|D|h:n a/p"
msg="And"
msgstring=OperatorClosed%"|D|h:n a/p"
msg="MondayThruFriday"
WaitForMsg=true
Next=Exit    

[LogACDAvailableVMFailure]
type=log
logmsg="ACD Var Man Failure"
next=PleaseHold

[PleaseHold]
type=log
Next=StatE_Transfer

!--------------------------------------------------
! Page 43 - Admin
!--------------------------------------------------
[StatE_Admin]
type=log
logmsg="Admin"

[AdminFunctions]
type=GetDigits
Var=EnteredRecordPassword
!msg="EnterPassword"
msg="Silence"
MinDigits=4
MaxDigits=4
Terminator=""
MaxTimeouts=0
TimeoutSec=6
OnMaxTimeouts=HangupCall
OnKeyPound=HangupCall
OnKeyStar=HangupCall

[CompareAdminPassword]
type=branch
var=EnteredRecordPassword
RecordPassword=StatE_RecordPhrase
"2222"=TestCallInWindow
"3333"=TestServing
"4444"=TestDisqualified
"5555"=TestPostponed
"6666"=TestServiceEnded
"7777"=TestExcused
"8888"=TestReportingWeek
"9999"=TestRequiredToReport
Next=Goodbye

