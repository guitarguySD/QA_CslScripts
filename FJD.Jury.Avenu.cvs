!--------------------------------------------------
! Pg.  - Process Excusal Request
!--------------------------------------------------
[ProcessExcusalRequest]
type=log

[CheckExtendedInfo]
type=branch
var=ExcusalInfoMsg2
""=PlayExcuseVerify
Next=PlayBasicExcuseMsg

[PlayExcuseVerify]
type=play
msg=ExcusalInfoMsg
msg=ExcusalInfoMsg2
msgstring=CourtFaxNumber%"|C"
msg=ExcusalInfoMsg3
Next=ExcusalPerjuryMenu

[PlayBasicExcuseMsg]
type=play
msg=ExcusalInfoMsg
Next=ExcusalPerjuryMenu

[ExcusalPerjuryMenu]
type=menu
msg="PerjuryMenuDTMF"
OnKey1=LogExcusalInput
OnKey2=CancelExcusal
Onkey3=CancelExcusalMainMenu
OnKey0=ACDAvailable

[CancelExcusal]
type=changeVariable
ExcusalInfoMsg=""
ExcusalInfoMsg2=""
CT_ReasonCode=""
CT_ReasonType=""
Next=RequestExcusalMenu

[CancelExcusalMainMenu]
type=changeVariable
ExcusalInfoMsg=""
ExcusalInfoMsg2=""
ExcusalInfoMsg3=""
CT_ReasonCode=""
CT_ReasonType=""
Next=JurorMenu

! Process the Excusal request
[LogExcusalInput]
type=log
!var=CT_JurorID,CT_DOB,CT_TypeCode,CT_ReasonCode

[ExecuteProcessExcusal]
type=log

[LogExcusalOutput]
type=log
var=CT_JurorID,CT_DOB

[LogProcessExcusalOutput]
type=log
var=CT_JurorID,CT_EligibleToExcuse,CT_IneligibleReason,CT_ExcuseExemptRequestStatus,CT_ResultCode,CT_ResultMessage
Next=CheckExcusalResult

[LogJsErrorExcusal]	! Exit on Javascript error
type=log
var=@Result,@ResultMessage
Next=StatE_SystemError

[CheckExcusalResult]	! Check process errors
type=branch
var=CT_ResultCode
0=CheckExcusalRequestStatus
Next=LogExcusalResult

[LogExcusalResult]
type=log
var=CT_ResultCode,CT_ResultMessage
Next=StatE_SystemError

[CheckExcusalRequestStatus]	! Check Request Status
type=branch
var=CT_ExcuseExemptRequestStatus
"Approved"=GetJurorRecord
"Pending Review"=ExcusalPendingReview
"Ineligible"=ExcusalIneligible

