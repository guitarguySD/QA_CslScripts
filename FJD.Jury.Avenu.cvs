dialstring="3333"
logblock=true
UseInbandDtmf=false
Next=HangupCall

!===================================
! End Routines
!===================================
[EndCall]
type=log

[Exit]
type=play
msg="ThankYou"
WaitForMsg=True

[Goodbye]
type=play
msg="Goodbye"
WaitForMsg=True
Next=HangupCall

[HangupCall]
type=CallControl
Command=Disconnect

[TerminateCall]
type=Terminate
