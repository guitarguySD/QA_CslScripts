type=Recognize
PromptMsg="Silence"
PromptMsgDTMF="ToHearAgain","JurorMenu1"|X|1,"JurorMenu2","JurorMenu3"|X|3,"JurorMenu4"|X|4,"JurorMenu5"|X|5,"JurorMenu6"|X|6,"JurorMenuLast"
OnKey1=StatE_RequestDeferral
