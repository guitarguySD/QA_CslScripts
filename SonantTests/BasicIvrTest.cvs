!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!              MainMenu 6: Acd Test                       !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdTestMenu]
type=Menu
msg="AcdTests"
msg="AcdTestsMenu"
OnKey1=AcdRouteTest			! Route caller to ACD
OnKey2=AcdRouteTestCallback	! Route caller to ACD with Callback option
OnKey3=AcdRouteTestTimer    ! Route caller to ACD. 10 sec call timer.
OnKey4=AcdMobileLogIn		! Mobile agent wants login
OnKey5=AcdMobileLogOut		! Mobile agent wants logout
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="AcdTestsMenu"
MaxTimeOuts=10
next=RunAnotherTest

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 6.1 - Route call to SonantTest
!  Caller is routed after "PleaseHold" completes. !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdRouteTest]
type=play
msg="PleaseHoldGeneric"
WaitForMsg=TRUE

[SetAcdCallReference]
type=ChangeVariable
@CallReference="AcdCall"
CheckRtpStats=0

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller.  Note that this block never
!  falls through and executes the Next block.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[RouteCaller]
type=ACD
Command=RouteCall
OriginationNumber=8588641450
RouteName="SonantTest"
RecordAgentCall=False
OnError=AcdRouteError
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnTimeout=RouteTimeout

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call Enters Queue
!   Offer Callback to caller?
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallRouted]
type=Branch
var=CallbackOption
1=EnteredQueueWithCallbackOption

!  Caller will not be offered Callback option
[EnteredQueueNoCallbackOption]
type=Acd
Command=CheckCallStatus
OnError=CheckCallStatusError

![LogAcdCallStatus]
!type=Log
!var=@ACD_CALL_STATUS,@ACD_GROUP_NAME,@ACD_GROUP_STATUS,@ACD_POSITION_IN_QUEUE,@ACD_GROUP_ASA_MIN,@ACD_TIME_IN_QUEUE,@ACD_EST_HOLD_TIME
!next=StartMusicOnHold

[CheckCallStatusError]
type=Log
next=StartMusicOnHold


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Entered Queue With Callback Option
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[EnteredQueueWithCallbackOption]
type=Play
msg="CallIsInQueue"

[EnteredQueueGetCallbackInfo]
type=Acd
command=GetCallbackInfo
FifoEnabledVar=CallbackFifoEnabled
FifoEstimatedTimeVar=CallbackFifoEstimatedTime
ScheduledEnabledVar=CallbackScheduledEnabled
ScheduledFirstTimeVar=CallbackScheduledFirstTime
ScheduledLastTimeVar=CallbackScheduledLastTime
OnError=LogCallbackInfoError

[LogCallbackInfo]
type=Log
Var=CallbackFifoEnabled,CallbackFifoEstimatedTime,CallbackScheduledEnabled,CallbackScheduledFirstTime,CallbackScheduledLastTime,@AcdEstHoldTimeMin

[CheckFifoCallbackEnabled]
type=Branch
var=CallbackFifoEnabled
0=FifoCallbackNotEnabled

! Reach here when ACD reports that FIFO callback is enabled
[PlayFifoCallbackInfo]
type=Play
Msg="CallbackFifoInfo1"
MsgString=@AcdEstHoldTimeMin%"|N"
Msg="CallbackFifoInfo2"
MsgString=CallbackFifoEstimatedTime%"|D|h:n a/p"

! Give caller the option to take a FIFO callback
[ChooseCallbackMenu]
type=Menu
msg="ChooseCallbackMenu"
OnKey1=CallerWantsCallback	
TimeoutSec=10
TimeOutMsg="Silence"
MaxTimeOuts=0

[CallerDoesNotWantCallback]
type=Play
Msg="DidNotRequestCallback"
next=StartMusicOnHold

[CallerWantsCallback]
type=Play
Msg="RequestedCallback"

[RequestFifoCallback]
type=Acd
command=RequestCallback
CallbackType=FIFO
CallbackNumberVar=CallbackNumber
OriginationNumber=CallbackOrigNumber
OnError=LogCallbackInfoError

! Did ACD accept the callback?
[CheckFifoCallbackCallState]
type=Branch
var=@AcdCallStatus
12=FifoCallbackStatusOk

[LogCallbackInfoError]
type=Play
Msg="AcdError"
next=AcdTestMenu

!  Callback status is good.  Inform caller and drop call
[FifoCallbackStatusOk]
type=Play
Msg="TerminatingInboundCall"
WaitforMsg=True
next=EndCall

! Fifo Callback is not enabled in ACD.  Play music and keep in queue.
[FifoCallbackNotEnabled]
type=Log

[StartMusicOnHold]
type=Play
msg="Music"
WaitForMsg=TRUE
Next=StartMusicOnHold

[WaitForAcdServer]
type=Pause
next=WaitForAcdServer


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Call is connecting to ACD Agent.  Play ring. 
!     Queue 4 rings (4X6 sec) to limit logging.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnecting]
type=Play
msg="RingTone"
msg="RingTone"
msg="RingTone"
msg="RingTone"
WaitForMsg=TRUE
Next=AcdAgentConnecting


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call is connected to ACD Agent
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnected]
type=Pause
PauseSec=6
Next=AcdAgentConnected2

{
[DoWeNeedToCheckRtpStats]
type=branch
var=CheckRtpStats=0
1=CheckRxPacketCount
next=AcdAgentConnected

! Optional RTP Stat check six seconds into call
[CheckRxPacketCount]
type=Utility
Command="GetRtpStats"
Parameter="RtpStatAudioPacketsRx"

[CheckRtpPacketCount]
type=branch
var=RtpStatAudioPacketsRx
100=LogLowPacketCount
OnAboveRange=AcdAgentConnected

[LogLowPacketCount]
type=Log
LogMsg="*** Low Rx Packet Count ***"
}

[AcdAgentConnected2]
type=Pause
PauseSec=30
next=AcdAgentConnected


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Inbound Call has returned from ACD 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnFromAcd]
type=Branch
var=@AcdRouteCode
0=CallReturnNoRoute
1=CallReturnErrorRoute
2=CallReturnDefaultRoute
3=CallReturnQueueShutdown
4=CallReturnQueueOverload
5=CallReturnEndCall	
6=CallReturnAgentTransfer	
7=CallReturnReleaseKeyPressed
8=CallReturnConferenceConnected
9=CallReturnAgentAwol
12=AgentRouteToTestMenu

! Falling through means an unknown RouteCode  
[PlayCallReturnUnknown]
type=Play
msg="AcdCallReturn"
msg="CallReturnUnexpectedRouteCode"
MsgString=@AcdRouteCode%"|N|0"
next=ThankYouGoodbyeExit

[CallReturnNoRoute]
type=Play
msg="AcdCallReturn"
msg="CallReturnNoRoute"
next=ThankYouGoodbyeExit

[CallReturnErrorRoute]
type=Log
LogMsg="Error Route"
next=ThankYouGoodbyeExit

[CallReturnDefaultRoute]
type=Log
LogMsg="DefaultRoute"
next=ThankYouGoodbyeExit

[CallReturnQueueShutdown]
type=Play
msg="AcdCallReturn"
msg="CallReturnQueueShutdown"
next=ThankYouGoodbyeExit

[CallReturnQueueOverload]
type=Log
LogMsg="Queue Overload"
next=ThankYouGoodbyeExit

! Agent ended call
[CallReturnEndCall]
type=Play
msg="AcdCallReturn"
msg="CallReturnEndCall"
next=RunAnotherTest
	
[CallReturnAgentTransfer]
type=Play
msg="AcdCallReturn"
msg="CallReturnAgentTransfer"
next=StartMusicOnHold
	
[CallReturnReleaseKeyPressed]
type=Play
msg="AcdCallReturn"
msg="CallReturnReleaseKeyPressed"
next=ThankYouGoodbyeExit

[CallReturnConferenceConnected]
type=Log
LogMsg="ConferenceConnected"
next=ThankYouGoodbyeExit

[RouteTimeout]
type=Play
msg="AcdTimeout"
next=RunAnotherTest

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller after AWOL
!  Uses Urgent priority.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnAgentAwol]
type=Play
msg="AcdCallReturn"
msg="CallReturnAgentAwol"

[RouteCallerAfterAwol]
type=ACD
Command=RouteCall
OriginationNumber=8588641450
RouteName="SonantTest"
Priority="Urgent"
OnError=AcdRouteError
next=StartMusicOnHold

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Agent Routes
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AgentRouteToTestMenu]
type=Log
LogMsg="Call routed by agent to BPP Menu"
next=ThankYouGoodbyeExit


[AcdRouteError]
type=Play
FlushPlayQueue=True
Msg="AcdRouteError"
Next=ThankYouGoodbyeExit

[AcdError]
type=Play
FlushPlayQueue=True
msg="SystemProblem"
WaitForMsg=TRUE
Next=ThankYouGoodbyeExit


