!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!! Test 9.1.1  Test Play Options   !!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

! This test has two parts:
! 	Part 1: Allow option 1 and not allow option 2
!   Part 2: Not allow option 1 and allow option 2
!
! The typical test scenario would be to press the disallowed option 2 at the first menu.
! This should fail. Now press allowed option 1 and this should pass.  You'll now be at
! the second part where you can test diallowed option 1 and allowed option 2.
[TestPlayOption]

type=changeVariable
@playOption1=1
@playOption2=0
@playOption3=0

[Test1Option1Only]
type=recognize
PromptMsgDTMF="YourOptionsAre","Option1Allowed"|X|1,"Option2NotAllowed"|X|2,"Option3NotAllowed"|X|3,"AndNoOtherOptions"
OnKey1=Option1Entered
OnKey2=Test1Option2NotAllowed
OnKey3=TestOption3NotAllowed
BadKeyMsg="Option2NotAllowed"
OnDtmfError=OptionsTestDtmfError
Next=TestScriptFeatures

[Option1Entered]
type=Play
Msg="Option1Entered"

! Part 2: Not allow option 1 and allow option 2
[SetPlayOption2Only]
type=changeVariable
@playOption1=0
@playOption2=1

[Test2Option2Only]
type=recognize
PromptMsgDTMF="YourOptionsAre","Option1NotAllowed"|X|1,"Option2Allowed"|X|2,"AndNoOtherOptions"
OnKey1=Test2Option1NotAllowed
OnKey2=Test2Option2Allowed
BadKeyMsg="Option1NotAllowed"
OnDtmfError=OptionsTestDtmfError
Next=TestScriptFeatures

[Test2Option2Allowed]
type=Play
Msg="Option2Allowed"
Next=TestScriptFeatures

[TestOption3NotAllowed]
type=Play
Msg="Option3NotAllowed"
Next=TestScriptFeatures
! Play Option Test Error blocks

! Test 1 Fails: Allows Option 2
[Test1Option2NotAllowed]
type=Play
Msg="Option2NotAllowed"
Next=Test1Option1Only

! Test 2 Fails: Allows Option 1
[Test2Option1NotAllowed]
type=Play
Msg="Option1NotAllowed"
Next=Test2Option2Only

[OptionsTestDtmfError]
type=Play
Msg="OptionsTestDtmfError"
Next=TestScriptFeatures



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!! Test 9.2   TestFileCache  !!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TestFileCache]
type=play
msg="TestCache"
WaitForMsg=TRUE
next=TestFileCache	! Loop forever while manually changing/deleting the file

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[RunAnotherTest]
type=Play
msg="Silence"
next=MainMenu



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Start ACD Callback Call
!	  Load script vars from inbound call and set 'On' vars.
!     Unlike RouteCall, this command does go to Next block.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[StartAcdCallback]
type=Acd
Command=StartCallback
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcdCallback
OnError=CallbackVarError

! Log to test that callback vars were loaded
[LogCallbackVars]
type=Log
Var=CallbackNumber,CallbackOrigNumber

[CallbackStatusCalling]
type=Acd
Command=UpdateCallbackStatus
Parameter=Calling
OnError=CallbackStatusError

[MakeCallbackCall]
type=Call
DestinationNumber=CallbackNumber
OriginationNumber=CallbackOrigNumber
CallReference="CallbackCall"
NoAnswerTimeoutSec=15
OnCallError=CallbackCallError

! Production scripts would wait for an answer here ...
[WaitForCallbackParty]
type=Pause
PauseSec=1

! Callback party is connected ...
[CallbackStatusConnected]
type=Acd
Command=UpdateCallbackStatus
Parameter=Answered
OnError=CallbackStatusError

[StartCallbackDialog]
type=Play
msg="CallbackMsg"
waitforMsg=True

[GetCallbackFinalStatus]
type=GetDigits
msg="CallbackFinalStatusMenu"
Var=CallbackFinalStatus
MinDigits=1
Terminator="@"
TimeOutSec=1
MaxTimeouts=1
OnMaxTimeouts=CallbackFinalStatusError
Next=CallbackStatusReady

[CallbackFinalStatusError]
type=ChangeVariable
CallbackFinalStatus=1

! Setting status to Party_Ready will make call eligible for agent
[CallbackStatusReady]
type=Acd
Command=UpdateCallbackStatus
Parameter=PartyReady
OnError=CallbackStatusError

[WaitForCallbackAgent]
type=Pause
PauseSec=300
Next=Goodbye 

[CallbackVarError]
type=Log
LogMsg="Callback vars could not be loaded. Terminating callback"
Next=FinalBlock

[CallbackCallError]
type=Log
LogMsg="Callback error"
Next=FinalBlock

[CallbackStatusError]
type=Log
LogMsg="Callback Status error"
Next=FinalBlock


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Callback Call has returned from ACD
!   This section updates the callback status.  If
!   the call returns due to normal agent disconnect,
!   terminate the callback call.  Other routes,
!   especially Agent user routes are handled just like
!   non-callback calls. 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnFromAcdCallback]
type=Branch
var=CallbackFinalStatus
1=CallbackComplete
2=CallbackLeftMessage
3=CallbackWrongParty
4=CallbackPartyAbandoned
5=CallbackPartyCancelled
next=EndCall

[CallbackComplete]
type=Acd
Command=UpdateCallbackStatus
Parameter=CallbackComplete
OnError=CallbackReturnStatusError
next=EndCallbackCallWhenAgentTerminates

[CallbackLeftMessage]
type=Acd
Command=UpdateCallbackStatus
Parameter=LeftMessage
OnError=CallbackReturnStatusError
next=EndCallbackCallWhenAgentTerminates

[CallbackWrongParty]
type=Acd
Command=UpdateCallbackStatus
Parameter=WrongParty
OnError=CallbackReturnStatusError
next=EndCallbackCallWhenAgentTerminates

[CallbackPartyAbandoned]
type=Acd
Command=UpdateCallbackStatus
Parameter=PartyAbandoned
OnError=CallbackReturnStatusError
next=EndCallbackCallWhenAgentTerminates

[CallbackPartyCancelled]
type=Acd
Command=UpdateCallbackStatus
Parameter=PartyCancelled
OnError=CallbackReturnStatusError
next=EndCallbackCallWhenAgentTerminates


[EndCallbackCallWhenAgentTerminates]
type=Branch
var=@AcdRouteCode
5=EndCall	
Next=CallReturnFromAcd

[CallbackReturnStatusError]
type=Log
LogMsg="Callback Return Status error"
Next=EndCall


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Start Maintenance Mode Call
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[MaintenanceMode]
type=Log
LogType=ScriptEvent
LogMsg="MaintenanceMode"

[PlayMaintenanceMode]
type=Play
msg="MaintenanceModeMsg"
waitforMsg=True
next=Goodbye



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Start Overload Mode Call
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[OverloadMode]
type=Play
msg="OverloadModeMsg"
waitforMsg=True
next=Goodbye


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	TestComplete
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TestComplete]
type=Log

[ThankYouGoodbyeExit]
type=play
msg="Thankyou"

[Goodbye]
type=play
msg="Goodbye"
WaitForMsg=TRUE
Next=EndCall

[MenuError]
type=log
next=Goodbye

[ExitOnMaxCallSec]
type=log
next=Goodbye

[ExitOnMaxCallErrors]
type=log
next=Goodbye

[ExitOnScriptError]
type=log
next=Goodbye

[EndCallWithDisconnectHandler]                                 
type=SetGlobals
AllowOnDisconnect=False
next=EndCall

[CallDisconnectHandler]
type=Log

! Disable OnDisconnect
[EndCall]
type=SetGlobals
AllowOnDisconnect=False

! Branch here to end call with the disconnect handler
[EndCall2]                                 
type=CallControl
Command=Disconnect

[FinalBlock]
type=Terminate
LogMsg="Terminating ..."

[FinalFinalBlock]
type=Terminate

! Comment
