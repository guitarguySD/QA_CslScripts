!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!  Script file for application "BasicIvrTest" in department "SystemTests"  !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

! CVS(VoIP) Test Script 
! Murray Judy
! Version 3.1  04/05/2019
!
! 
!Asterisk Basic IVR Test script
!removed vap file test and added TestHelpMenu msg, PlaybackTestMenu msg and CvsTestScriptMenu msg	eb	20250429
!
 
!========================================
!Setup
!========================================

[ScriptSetup]
type=SetGlobals
TTSFilePath="D:\Sonant\VoiceFiles\TTSFiles\"	!deprecated
Language="English"
MaxCallSec=2000
OnMaxCallSec=ExitOnMaxCallSec
MaxCallErrors=12
OnMaxCallErrors=ExitOnMaxCallErrors
OnCallDisconnect=CallDisconnectHandler
!OnMissingMsg=ThankYouGoodbyeExit
OnScriptError=ExitOnScriptError
AllowOnDisconnect=True
!OnDtmfA=IgnoreBlock	!not in scripting guide
LogTrace=True

!========================================
! Set System Defaults
!========================================

[BlockDefaults]
Type=SetDefaults
DefaultIgnoreMissingMsg=FALSE
DefaultFlushKeys=False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=MenuError
DefaultTimeOutSec=10
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=MenuError
DefaultOnMaxBadValues=MenuError
DefaultLogCall=True
DefaultLogMenu=True
DefaultLogGetDigits=True
DefaultLogPlay=True
DefaultTerminator=""

!========================================
! Define Variables
!========================================
[CreateVariables]
type=DefineVars
ACD_OriginationAddress="8588641450"
Array_Var1=""
Array_Var2=""
BasicTest_LogText=""		! Used by the DLL test
BasicTest_Variable="A"		! Used by the DLL test
BasicTest_IntVariable="1"

BasicTestJs_Status=""		! Used by the JavaScript test
BasicTestJs_ScriptInput="1"
BasicTestJs_ScriptOutput=""
BridgeTimerSec=30
CallbackFinalStatus=0
CheckRtpStats=0
CountValue=0
CtiTestData="Example CTI Data from script"

DigitEntry=""
DtmfString="0123456789*#ABCD"
! HPS Test Outbound Calling Number.
HpsTestPhoneNumber="205" 
!HpsTestPhoneNumber="8005553333@199.244.102.231"
!4144549572@199.244.102.232"    ! ShoreTel Chicago data center
!HpsTestPhoneNumber="4144549572@199.244.103.231"    ! ShoreTel NYC data center
HpsTransferID="0004336"
HoldTimerSec=6
JavaScriptTestMode=0

QuestionNumber=0
QueueShutdown="QueueShutdown"
RecordBlockResult=""
RtpStatAudioPacketsRx=0

! Default Outbound Calling Number.
TestPhoneNumber="204"
!TestPhoneNumber="8588641453@192.168.5.252"
!TestPhoneNumber="1453@192.168.5.252"
!TestPhoneNumber="5551111@192.168.5.31"

!  Variable Manager Test vars
TestVmVar1=0
TestVmVar2=0
TestVmVar3=0

TransferToCallId=""
UserInput=""

!
! Define ACD Variables
!
[CreateAcdVariables]
type=DefineVars
ACD_RouteCode=0				! Denotes why call routed back to CVS
AgentCredentials=""
AgentTransfer=0
AssistanceAvailable=1
CallbackOption=0

!
! Define CTI Variables
!
Department="Test Department"
CallerLanguage="English"
PT_AssessmentNumber="123456"
ScreenMsg="Hello"

!
! Define ACD Callback Variables
!
CallbackFifoEnabled=""
CallbackFifoEstimatedTime=""
CallbackScheduledEnabled=""
CallbackScheduledFirstTime=""
CallbackScheduledLastTime=""
CallbackTime=""
CallbackNumber="204"
CallbackOrigNumber="8005551212"

!========================================
! Define REST API Test Variables
!========================================
[CreateRestApiVars]
type=DefineVars
ApiStatusCode=""
ApiSuccess=""
ApiError=""
ApiCasesJson=""
ApiCaseCount="0"
ApiCaseIdx="0"
ApiCaseNumberResult=""
ApiCaseCategory=""
ApiCaseType=""
ApiCaseEligible=""
ApiCaseStatus=""
ApiPayorsJson=""
ApiPayorCount="0"
ApiPayorIdx="0"
ApiPayorName=""
ApiPayorEligible=""
ApiPayorAmount=""

! Default Call Reference stored in Calls table. Changed in some script paths.
[SetBasicCallReference]
type=ChangeVariable
@CallReference="BasicIvrScript"

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!   Handle Call Type
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[BranchOnCallType]
type=Branch
var=@CallType
1=LogLocationVariables		! Normal inbound call start
3=MaintenanceMode
4=OverloadMode
10=StartAcdCallback


[LogLocationVariables]
type=Log
Var=@CallType,@InCallLocationType,@InCallLocationAreaCode,@InCallLocationDesc,@InCallLocationTZOffset

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!    Main Menu   !!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[MainMenu]
type=Menu
Msg="CvsTestScript"
Msg="CvsTestScriptMenu"
OnKey1=ContinuousFilePlaybackTest  ! Play continuous until key pressed
OnKey2=PlaybackTestMenu	           ! A set of play tests
OnKey3=CallControlTestMenu	       ! CallControl Menu. Various outbound and transfer tests
OnKey4=RecordFile  		           ! Record a file: "TestRecording.vox"
OnKey5=MiscTests                   ! Misc Tests
OnKey6=AcdTestMenu                 ! ACD Tests
OnKey7=CvpBlockTests               ! Test various blocks
OnKey9=DevTests                    ! Developer Tests Menu
OnKeyStar=TestHelp
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10

[TestMenuTimeout]
type=Pause
PauseMsec=50
next=TestComplete


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!    MainMenu *: Help         !!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TestHelp]
type=Play
Msg="TestHelpMenu"
next=MainMenu

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 1 PlaybackTest: Continuous File Play !!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Loop until a digit is pressed
[ContinuousFilePlaybackTest]
type=GetDigits
msg="PlaybackTestMessage"
Var=DigitEntry
MinDigits=1
Terminator="#"
TimeOutSec=1
MaxTimeouts=1
OnMaxTimeouts=ContinuousFilePlaybackTest
Next=MainMenu


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!   Test 2: PlaybackTest      !!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[PlaybackTestMenu]
type=Menu
!Msg="PlaybackTest"
Msg="PlaybackTestMenu"
OnKey1=SimpleFilePlaybackTest	! Play a single vox file
!OnKey2=VapFilePlaybackTest		! Plays the first three segments of the system vap file: 1,2,3
OnKey3=TtsPlaybackTest
OnKey4=MissingVoxFileTest
OnKey5=FormattedPlayTest
OnKey6=TtsLoadTest
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
IgnoreMissingMsg=TRUE
next=RunAnotherTest

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 2.1 PlaybackTest: SimpleFilePlayback !!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[SimpleFilePlaybackTest]
type=Play
ignoreKeys=TRUE
msg="SimplePlaybackTest"
WaitForMsg=TRUE

[PlaybackTestLoop]
type=Play
FlushPlayQueue=TRUE
msg="PlaybackTestMessage"
UseNavigation=True
next=PlaybackTestMenu


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 2.2 PlaybackTest: VapFilePlayback  !!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
![VapFilePlaybackTest]
!type=Play
!MsgString="vvsystem.vap|I|1"
!MsgString="vvsystem.vap|I|2"
!MsgString="vvsystem.vap|I|3"
!next=PlaybackTestMenu


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 2.3 PlaybackTest: TtsPlaybackTest  !!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TtsPlaybackTest]
type=Play
!TtsString="Bob Smith"
TtsString="Please enter your 4-digit PIN: 1, 2, 3, 4. Your balance is $1,234.56, updated on 07/29/2025 at 3:45 PM."
TtsString="Hello world This is a test string with special characters: @ # $ % ^ & * ( ) _"
WaitForMsg=TRUE
next=PlaybackTestMenu



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!! Test 2.4 PlaybackTest: MissingVoxFileTest  !!!!!!
!!!!     Executing this test should turn on the     !!
!!!!     yellow Vox Files LED in ControlPanel.      !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[MissingVoxFileTest]
type=Play
msg="ThisFileIsMissing"
next=PlaybackTestMenu


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!  Test 2.5 - FormattedPlayTest      !!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[FormattedPlayTest]
type=play
Msg="FormattedPlayTest"

[TestNumber]
type=play
Msg="FormattedNumber"
MsgString=ACD_RouteCode%"|N|0"

[TestDate]
type=play
Msg="DateFormat"
MsgString="Mon Jul 28 10:15:00 2014|D|ddd mmm dd yyyy"

[TestTime]
type=play
Msg="TimeFormat"
MsgString="10:15:00|D|h:n a/p"

[TestCharacters]
type=play
Msg="FormattedCharacters"
MsgString="ABCD0123456789#*|C"

[TestMoney]
type=play
Msg="FormattedMoney"
MsgString="12345600.12|M"
next=PlaybackTestMenu

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!   Test 2.6 PlaybackTest: TtsLoadTest   
!	Execute TTS name plays continuously until a key press.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TtsLoadTest]
type=Play
TtsString="ROBERT CARLOS SMITH"
WaitForMsg=TRUE

[TtsLoadTest2]
type=Play
TtsString="sebastian mcIver"
WaitForMsg=TRUE

[TtsLoadTest3]
type=Play
TtsString="Satya Nadella"

! Loop until a digit is pressed
[TtsLoadTestCheckKey]
type=GetDigits
Var=DigitEntry
MinDigits=1
Terminator="@"
TimeOutSec=1
MaxTimeouts=1
OnMaxTimeouts=TtsLoadTest
next=PlaybackTestMenu



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!! MainMenu 3:  CallControl Test  !!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallControlTestMenu]
type=Menu
Msg="CallControlTest"
Msg="CallControlTestMenu"
OnKey1=SetTestVariables     ! Enter test phone number & timer vars
OnKey2=DisconnectTest		! Disconnect block test
OnKey3=CallBlockTest	    ! Call block test
OnKey4=CallHoldTests        ! Menu of call Hold tests
OnKey5=CallTransferTests	! Menu of call transfer tests
OnKey6=HpsTestMenu      	! Menu of HPS tests
OnKeyStar=PlayCallControlMenu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
IgnoreMissingMsg=TRUE
next=RunAnotherTest


[PlayCallControlMenu]
type=Play
Msg="CallControlMenu"
Next=CallControlTestMenu

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!! Test 3.1  CallControl Set Test Variables   !!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[SetTestVariables]
type=Menu
Msg="SetTestVariablesMenu"
OnKey1=SetTestPhoneNumber   ! call block destination for Call Control tests
OnKey2=SetTestHoldTimer     ! Timer for hold tests
OnKey3=SetTestBridgeTimer	! Timer for bridge tests
OnKeyStar=PlayCallControlMenu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
IgnoreMissingMsg=TRUE
next=RunAnotherTest

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!! Test 3.1.1 CallControl Set Test Phone Number  !!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[SetTestPhoneNumber]
type=GetDigits
Msg="EnterTestPhoneNumber"
Var=TestPhoneNumber
Terminator=#
MinDigits=3
MaxDigits=10
TimeOutSec=20
next=CallControlTestMenu

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!! Test 3.1.2 CallControl Set Test Timer Var   !!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[SetTestHoldTimer]
type=GetDigits
Msg="EnterTimerValue"
Var=HoldTimerSec
Terminator=#
MinDigits=1
MaxDigits=3
TimeOutSec=20
next=CallControlTestMenu

[SetTestBridgeTimer]
type=GetDigits
Msg="EnterTimerValue"
Var=BridgeTimerSec
Terminator=#
MinDigits=1
MaxDigits=4
TimeOutSec=20
next=CallControlTestMenu

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 3.2  CallControl DisconnectTest  !!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[DisconnectTest]
type=Play
Msg="DisconnectTest"
!Next=GoodBye
Next=FinalBlock


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 3.3  CallControl CallBlockTest  !!111!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallBlockTest]
type=play
msg="Goodbye"

[MakeCall]
type=Call
DestinationNumber=TestPhoneNumber
!DestinationUri="8585551200@192.168.5.111"
OriginationNumber="230"
CallReference="CallBlockTest"
NoAnswerTimeoutSec=15
OnCallError=CallBlockError

[MakeCallComplete]
type=play
msg="Silence"
msg="TestPassed"
WaitForMsg=TRUE

! Inbound call message should be finished. Disconnect the caller.
[DisconnectInboundCall]
type=CallControl
Command=Disconnect
PartyName="Caller"
OnError=CallBlockDisconnectError

[WaitForOutboundCallToDisconnect]
type=Pause
Next=WaitForOutboundCallToDisconnect

[CallBlockError]
type=Log
next=TestComplete

[CallBlockDisconnectError]
type=Log
next=TestComplete

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!! Test 3.4   CallControl Call Hold Tests   !!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallHoldTests]
type=Menu
Msg="CallHoldTestMenu"
OnKey1=CallHoldTest     	! Active (sendonly) Hold
OnKey2=CallHoldInactiveTest	! Inactive (inactive) Hold
OnKeyStar=PlayCallControlMenu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
IgnoreMissingMsg=TRUE
next=RunAnotherTest

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!! Test 3.4.1 CallControl Active (sendonly) Hold  !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallHoldTest]
type=Play
msg="CallHoldTest"
msg="Music"

[WaitForPlayToStart]
type=Pause

[PutCallOnHold]
type=CallControl
Command=Hold
PartyName="Inbound"
OnError=HoldTestError
 
! Pause so that tester can verify that call is on hold:
!   there should be no DTMF digits transmitted by the caller phone.
[WaitDuringHold]
type=Pause
PauseSec=HoldTimerSec

[TakeCallOffHold]
type=CallControl
Command=OffHold
OnError=HoldTestError

[HoldTestComplete]
type=Play
msg="TestToneOneMw240mS"
FlushPlayQueue=true
next=CallControlTestMenu

[HoldTestError]
type=Log
Next=EndCall

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! Test 3.4.2 CallControl Inactive Hold  !!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallHoldInactiveTest]
type=Play
msg="CallHoldInactiveTest"
msg="Music"

[WaitForPlayToStartInactive]
type=Pause

[PutCallOnHoldIn]
type=CallControl
Command=HoldInactive
PartyName="Inbound"
OnError=HoldInTestError

! Pause so that tester can verify that call is on hold:
!   there should be no DTMF digits transmitted by the caller phone.
[WaitDuringHoldIn]
type=Pause
PauseSec=HoldTimerSec

[TakeCallOffHoldIn]
type=CallControl
Command=OffHold
OnError=HoldInTestError

[HoldInTestComplete]
type=Play
msg="TestToneOneMw240mS"
FlushPlayQueue=true
next=CallControlTestMenu

[HoldInTestError]
type=Log
Next=EndCall


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!! Test 3.5.X CallControl Transfer Test Menu   !!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallTransferTests]
type=Menu
Msg="TransferTestsMenu"
OnKey1=BlindTransferTest    
OnKey2=SupervisedTransferTest
OnKey3=BridgedTransferTest
OnKeyStar=PlayCallControlMenu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
IgnoreMissingMsg=TRUE
next=RunAnotherTest


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!! Test 3.5.1  CallControl Blind Transfer Test !!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[BlindTransferTest]
type=Play
msg="Music"

[BtPutCallOnHold]
type=CallControl
Command=Hold
OnError=BtHoldErrorDuringTest

[BtStartTransfer]
type=CallControl
Command=Transfer
PartyName="Inbound"
DestinationNumber=TestPhoneNumber
OnError=BtTransferError

! Debug Loop !!!!!!!!!!!!!
! Remove after Refer state machine is working in SipServer
[BtLogTransfer]
type=Pause
PauseSec=5

[BtDisconnectAfterTransfer]
type=CallControl
Command=Disconnect
OnError=BtDisconnectError

! Error putting call on hold. Recoverable error.
[BtHoldErrorDuringTest]
type=Log
Next=EndCall

! Transfer Failed.  Normally, we would take Inbound off hold, but test script bails.
[BtTransferError]
type=Log
Next=EndCall

! Error disconnecting after the transfer. ** Non-Recoverable error **
[BtDisconnectError]
type=Log
Next=EndCall


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Test 3.5.2  CallControl Supervised Transfer Test !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[SupervisedTransferTest]
type=Play
msg="Music"

[StPutCallOnHold]
type=CallControl
Command=Hold
OnError=StHoldErrorDuringTest

[StMakeCall]
type=Call
DestinationNumber=TestPhoneNumber
PartyName="TransferDestinationCall"
OnCallError=StMakeCallError

[StConnectMessage]
type=Play
msg="Silence"
WaitForMsg=TRUE

! Connected to TransferDestinationCall.  Play DIGITS.
[StPlayToDestination]
type=Play
msg="TransferAnnouncement"
WaitForMsg=TRUE

[StMakeCallComplete]
type=dial
UseInbandDtmf=TRUE
DialString="01234567890#*"

[StPlayBeep2]
type=Play
msg="Silence"
WaitForMsg=TRUE

[StPutSecondCallOnHold]
type=CallControl
Command=Hold
PartyName="TransferDestinationCall"
OnError=StHoldErrorDuringTest

[StStartTransfer]
type=CallControl
Command=Transfer
PartyName="Inbound"
PartyName="TransferDestinationCall"
OnError=StTransferError

[StLogAfterTransfer]
type=Log

[WaitDuringCall]
type=pause
PauseSec=30
Next=EndCall

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!! Test 3.5.3 CallControl Bridged Transfer Test   !!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[BridgedTransferTest]
type=CallControl
Command=Hold
OnError=ChHoldErrorDuringTest

[BridgeTransMakeCall]
type=Call
DestinationNumber=TestPhoneNumber
OriginationNumber=@OriginationAddress
PartyName="TestCallConsHold"
SipHeader="Sonant-Test=2"
!SipHeader="Sonant-Test=1,603"
!SipHeader="Sonant-Transfer-ID=1234567"
OnCallError=ChMakeCallError

[TakeInboundOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=ChHoldErrorDuringTest

[BridgeCalls]
type=CallControl
Command=Bridge
OnKeyD=ExitBridgedCallOnD
OnError=StHoldErrorDuringTest

! Wait forever until the calls terminate
[BridgedCallDisconnect]
type=Log
Next=CallControlTestMenu

[ExitBridgedCallOnA]
type=Log
next=CallControlTestMenu

[ExitBridgedCallOnB]
type=Log
next=CallControlTestMenu

[ExitBridgedCallOnC]
type=Log
next=CallControlTestMenu

[ExitBridgedCallOnD]
type=Log
next=CallControlTestMenu


!
! Common Make Call Error Handler
!
[ChMakeCallError]
type=Log
Next=EndCall

!
! Common Hold Error Handler
!
[ChHoldErrorDuringTest]
type=Log
Next=EndCall


!
! Error Handlers
!

! Error making the Supervised Transfer call.
[StMakeCallError]
type=Log
Next=EndCall

! Error putting call on hold. Recoverable error.
[StHoldErrorDuringTest]
type=Log
Next=EndCall

! Transfer Failed.  Normally, we would take Inbound off hold. Test script bails.
[StTransferError]
type=Log
Next=EndCall

! Error disconnecting after the transfer. ** Non-Recoverable error **
[StDisconnectError]
type=Log
Next=EndCall


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!     Test 3.6 HPS Tests Menu   !!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[HpsTestMenu]
type=Menu
Msg="HpsTestsMenu"
OnKey1=HpsPaymentTestDtmf    
OnKey2=HpsPaymentTestTokOnly
OnKeyStar=PlayCallControlMenu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
IgnoreMissingMsg=TRUE
next=RunAnotherTest



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 3.6.1 - Makes a HPS call using DTMF protocol
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[HpsPaymentTestDtmf]
type=CallControl
Command=Hold
OnError=ChHoldErrorDuringTest

[HpsTest1MakeCall]
type=Call
DestinationNumber=HpsTestPhoneNumber
PartyName="TestCallConsHold"
!SipHeader="X-Sonant-TransferID=HpsTransferID"
NoAnswerTimeoutSec=10
OnCallError=HpsCallFailed


[PauseBeforedigits]
type=Pause
PauseMsec=300

{
[dialTest]
type=Dial
DialString="01234567890#*"
}
[HpsTransferIdProtocolStart]
type=Menu
OnKeyPound=HpsTest1TakeInboundOffHold
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=1
IgnoreMissingMsg=TRUE


[HpsTest1TakeInboundOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=HpsCallFailed

[HpsTest1BridgeCalls]
type=CallControl
Command=Bridge
OnError=HpsBridgedFailed

! Wait forever until the calls terminate

[HpsTest1BridgeFinished]
type=Log
Next=RunAnotherTest

! Error Handlers for HPS Call

[HpsCallFailed]
type=Log

[HpsCallFailedRestoreInbound]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=HpsCallFailed
Next=RunAnotherTest

[HpsBridgedFailed]
type=Log
Next=RunAnotherTest


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 3.6.2 - Makes a HPS call using Token-Only protocol
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[HpsPaymentTestTokOnly]
type=CallControl
Command=Hold
OnError=ChHoldErrorDuringTest

[HpsTest2MakeCall]
type=Call
DestinationNumber=HpsTestPhoneNumber
PartyName="TestCallConsHold"
SipHeader="X-Sonant-TransferID=HpsTransferID"
OnCallError=ChMakeCallError

[HpsTest2TakeInboundOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=ChHoldErrorDuringTest

[HpsTest2BridgeCalls]
type=CallControl
Command=Bridge
OnKeyA=ExitBridgedCallOnA
OnKeyD=ExitBridgedCallOnD
OnError=StHoldErrorDuringTest

! Wait forever until the calls terminate

[HpsTest2BridgeFinished]
type=Log
Next=RunAnotherTest



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!! MainMenu 4: RecordFileTest  !!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[RecordFile]
type=Record
Msg="RecordingTest.vox"
FileName="TestRecording.vox"
PlayBeep=True
LogAudioEnergy=True
AudioProfileName="Record"
ResultVar=RecordBlockResult

[RecordFileFinished]
type=Log
var=RecordBlockResult

[CheckRecordResult]
type=branch
var=RecordBlockResult
1=PlayRecordedFile
2=PlayRecordedFile
next="NoFileRecorded"

[PlayRecordedFile]
type=Play
msg="TestToneOneMw30mS"
Msg="TestRecording.vox"
msg="TestToneOneMw30mS"

[PostRecordPause]
type=Pause
next=RunAnotherTest

[NoFileRecorded]
type=play
msg="NoFileRecorded"
next=RunAnotherTest


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!  MainMenu 5: Misc Tests  !!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[MiscTests]
type=Menu
msg="MiscTests"
Msg="MiscTestsMenu"
!OnKey1=TestDll                ! Call the Test DLL
OnKey2=TestSendDtmf	          ! Send DTMF
OnKey3=StoreApplicationEvent  ! Store an application event
OnKey4=JavaScriptTests        ! Javascrpt block
OnKey5=VarManagerTests		  ! Variable Manager block
OnKeyStar=MiscTests           ! Play menu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
next=RunAnotherTest


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 5.1 - Call the test DLL
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
![TestDll]
!type=ChangeVariable
!BasicTest_Variable="TestVariable"
!
![CallTheDll]
!type=ExecuteRoutine
!DLL="BasicIvrTest.DLL"
!Routine="Test"
!
![TestDllResults]
!type=Branch
!var=BasicTest_Variable
!Passed=DllTestOK
!
![DllTestFailed]
!type=Play
!msg="TestFailed"
!
![LogDllReturnedText]
!type=Log
!Var=BasicTest_LogText
!next=RunAnotherTest
!
![DllTestOk]
!type=Play
!msg="TestPassed"
!next=RunAnotherTest



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 5.2 - Send DTMF to the caller
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TestSendDtmf]
type=Dial
DialString=DtmfString

[LogSendDtmf]
type=Log
Var=DtmfString
next=RunAnotherTest


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 5.3 - Store an Application Event
!             named "TestEvent"
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[StoreApplicationEvent]
type=Play
Msg="AddingScriptEvent"

[StoreAppEvent]
type=Log
LogType=ScriptEvent
LogMsg="TestEvent"
next=RunAnotherTest



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 5.3 - Store an Application Event
!             named "TestEvent"
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Test 5.4: JavaScript Test                !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[JavaScriptTests]
type=Menu
msg="JavaScriptBlockTest"
OnKey1=EnableJavaScriptTestMode	
OnKey2=DisableJavaScriptTestMode	
OnKey3=JavaScriptExecuteTest
OnKey4=JavaScriptSaveTestData
OnKey5=JavaScriptArrayTest
!OnKeyStar=PlayDevTestsMenu
OnKeyPound=MainMenu
TimeoutSec=20
TimeOutMsg="Silence"
MaxTimeOuts=10
next=RunAnotherTest


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
