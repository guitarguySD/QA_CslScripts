!========================================
!Setup
!========================================

[ScriptSetup]
type=SetGlobals
TTSFilePath="D:\Sonant\VoiceFiles\TTSFiles\"	!deprecated
Language="English"
MaxCallSec=2000
OnMaxCallSec=ExitOnMaxCallSec
MaxCallErrors=12
OnMaxCallErrors=ExitOnMaxCallErrors
OnCallDisconnect=CallDisconnectHandler
!OnMissingMsg=ThankYouGoodbyeExit
