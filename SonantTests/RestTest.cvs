    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    vars["ApiStatus"] = root.GetProperty("status").GetString() ?? "";
    vars["ApiErrorCode"] = root.GetProperty("errorCode").GetString() ?? "";
"""
