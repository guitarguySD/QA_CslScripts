[ScriptSetup]
type=SetGlobals
Language="English"
MaxCallSec=2000
OnMaxCallSec=ExitOnMaxCallSec
MaxCallErrors=12
OnMaxCallErrors=ExitOnMaxCallErrors
OnCallDisconnect=CallDisconnectHandler
!OnMissingMsg=ThankYouGoodbyeExit
OnScriptError=ExitOnScriptError
AllowOnDisconnect=True
!OnDtmfA=IgnoreBlock	!not in scripting guide
LogTrace=True

!========================================
! Set System Defaults
!========================================

[BlockDefaults]
Type=SetDefaults
DefaultIgnoreMissingMsg=FALSE
DefaultFlushKeys=False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=MenuError
DefaultTimeOutSec=10
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=MenuError
DefaultOnMaxBadValues=MenuError
DefaultLogCall=True
DefaultLogMenu=True
DefaultLogGetDigits=True
DefaultLogPlay=True
DefaultTerminator=""

[DefineVars]
type=DefineVars
ApiSuccess=""
ApiError=""
JsiHttpStatus=""
JsiError=""

[CreateJsiVars]
type=DefineVars
JsiBaseUrl="https://jury-svc-prod.sjcourts.org/jp_access/ws/jury"
!JsiBaseUrl="https://jury-svc-test.sjcourts.org/jp_access/ws/jury"
GetJurorInfoEndpoint="/get_juror"
JurorId=""
JsiApiKey="keySJQ439!"
code=""
message=""
personId=""
badgeNumber=""
lastName=""
firstName=""
middleName=""
nameSuffix=""
mailAddress1=""
mailAddress2=""
mailCity=""
mailState=""
mailZip=""
resiAddress1=""
resiAddress2=""
resiCity=""
resiState=""
resiZip=""
driverSid=""
dob=""
filler2=""
jurorStatusInd=""
statusDesc=""
reportingGroup=""
reportingDate=""
reportingLocationId=""
reportingLocation=""
schgcnt=""
scheduleChange=""
serviceEnd=""
attendance=""
informationChg=""
qualification=""
firstPossibleDate=""
lastPossibleDate=""
payDate=""
payAmt=""
summonsDate=""
dola=""
caseId=""
panelId=""
lactEvent=""
lactType=""
lactReason=""
lactNoticeType=""
lactNoticeStatus=""
lastAffRtnDate=""
juryTermId=""
locTodayDate=""
confirmInd=""
tstepqualify=""
ftacount=""
delinqsts=""
lastActivityDate=""
jurorType=""
formClasses=""
jrinInd=""
enotifyStatus=""
filler1=""
pendingUpdate=""
RawJsonResponse=""
pin=""

[UpdateJsiVars]
type=ChangeVariable
GetJurorInfoEndpoint=JsiBaseUrl%GetJurorInfoEndpoint

[SetJsiTestVars]
type=ChangeVariable
JurorId="008008548"


[SetJsiUrl]
type=ChangeVariable
GetJurorInfoEndpoint=GetJurorInfoEndpoint%"/"%JurorId%"?api_key="%JsiApiKey

! The GetJurorInfoEndpoint should look like this:
! https://jury-svc-prod.sjcourts.org/jp_access/ws/jury/get_juror/008008548?api_key=keySJQ439!
[LogJsiGetJurorUrl]
type=Log
var=GetJurorInfoEndpoint

[MainMenu]
type=Menu
TtsString="Get Juror, press 1. To repeat this menu, press 9."
OnKey1=JsiGetJurorAPI
OnKey9=MainMenu
TimeoutSec=8
MaxTimeOuts=3
OnMaxTimeOuts=Goodbye

[JsiGetJurorAPI]
type=Log
var=JurorId,GetJurorInfoEndpoint

[JsiGetJuror]
type=RestApi
Method=GET
url=GetJurorInfoEndpoint
RequestScript="""
return "";
"""
ResponseScript="""
using System.Text.Json;
var root = JsonDocument.Parse(response).RootElement;

vars["code"]    = root.TryGetProperty("code",    out var v) ? v.GetString() ?? "" : "";
vars["message"] = root.TryGetProperty("message", out v)     ? v.GetString() ?? "" : "";
vars["RawJsonResponse"] = response;

if (vars["code"] == "200")
{
    if (root.TryGetProperty("content", out var content))
    {
        vars["personId"]            = content.TryGetProperty("personId",            out v) ? v.GetString() ?? "" : "";
        vars["badgeNumber"]         = content.TryGetProperty("badgeNumber",         out v) ? v.GetInt32().ToString() : "";
        vars["lastName"]            = content.TryGetProperty("lastName",            out v) ? v.GetString() ?? "" : "";
        vars["firstName"]           = content.TryGetProperty("firstName",           out v) ? v.GetString() ?? "" : "";
        vars["middleName"]          = content.TryGetProperty("middleName",          out v) ? v.GetString() ?? "" : "";
        vars["nameSuffix"]          = content.TryGetProperty("nameSuffix",          out v) ? v.GetString() ?? "" : "";
        vars["mailAddress1"]        = content.TryGetProperty("mailAddress1",        out v) ? v.GetString() ?? "" : "";
        vars["mailAddress2"]        = content.TryGetProperty("mailAddress2",        out v) ? v.GetString() ?? "" : "";
        vars["mailCity"]            = content.TryGetProperty("mailCity",            out v) ? v.GetString() ?? "" : "";
        vars["mailState"]           = content.TryGetProperty("mailState",           out v) ? v.GetString() ?? "" : "";
        vars["mailZip"]             = content.TryGetProperty("mailZip",             out v) ? v.GetString() ?? "" : "";
        vars["resiAddress1"]        = content.TryGetProperty("resiAddress1",        out v) ? v.GetString() ?? "" : "";
        vars["resiAddress2"]        = content.TryGetProperty("resiAddress2",        out v) ? v.GetString() ?? "" : "";
        vars["resiCity"]            = content.TryGetProperty("resiCity",            out v) ? v.GetString() ?? "" : "";
        vars["resiState"]           = content.TryGetProperty("resiState",           out v) ? v.GetString() ?? "" : "";
        vars["resiZip"]             = content.TryGetProperty("resiZip",             out v) ? v.GetString() ?? "" : "";
        vars["driverSid"]           = content.TryGetProperty("driverSid",           out v) ? v.GetString() ?? "" : "";
        vars["dob"]                 = content.TryGetProperty("dob",                 out v) ? v.GetInt32().ToString() : "";
        vars["filler2"]             = content.TryGetProperty("filler2",             out v) ? v.GetString() ?? "" : "";
        vars["jurorStatusInd"]      = content.TryGetProperty("jurorStatusInd",      out v) ? v.GetString() ?? "" : "";
        vars["statusDesc"]          = content.TryGetProperty("statusDesc",          out v) ? v.GetString() ?? "" : "";
        vars["reportingGroup"]      = content.TryGetProperty("reportingGroup",      out v) ? v.GetInt32().ToString() : "";
        vars["reportingDate"]       = content.TryGetProperty("reportingDate",       out v) ? v.GetInt32().ToString() : "";
        vars["reportingLocationId"] = content.TryGetProperty("reportingLocationId", out v) ? v.GetString() ?? "" : "";
        vars["reportingLocation"]   = content.TryGetProperty("reportingLocation",   out v) ? v.GetString() ?? "" : "";
        vars["schgcnt"]             = content.TryGetProperty("schgcnt",             out v) ? v.GetInt32().ToString() : "";
        vars["scheduleChange"]      = content.TryGetProperty("scheduleChange",      out v) ? v.GetString() ?? "" : "";
        vars["serviceEnd"]          = content.TryGetProperty("serviceEnd",          out v) ? v.GetString() ?? "" : "";
        vars["attendance"]          = content.TryGetProperty("attendance",          out v) ? v.GetString() ?? "" : "";
        vars["informationChg"]      = content.TryGetProperty("informationChg",      out v) ? v.GetString() ?? "" : "";
        vars["qualification"]       = content.TryGetProperty("qualification",       out v) ? v.GetString() ?? "" : "";
        vars["firstPossibleDate"]   = content.TryGetProperty("firstPossibleDate",   out v) ? v.GetInt32().ToString() : "";
        vars["lastPossibleDate"]    = content.TryGetProperty("lastPossibleDate",    out v) ? v.GetInt32().ToString() : "";
        vars["payDate"]             = content.TryGetProperty("payDate",             out v) ? v.GetInt32().ToString() : "";
        vars["payAmt"]              = content.TryGetProperty("payAmt",              out v) ? v.GetString() ?? "" : "";
        vars["summonsDate"]         = content.TryGetProperty("summonsDate",         out v) ? v.GetInt32().ToString() : "";
        vars["dola"]                = content.TryGetProperty("dola",                out v) ? v.GetInt32().ToString() : "";
        vars["caseId"]              = content.TryGetProperty("caseId",              out v) ? v.GetString() ?? "" : "";
        vars["panelId"]             = content.TryGetProperty("panelId",             out v) ? v.GetInt32().ToString() : "";
        vars["lactEvent"]           = content.TryGetProperty("lactEvent",           out v) ? v.GetString() ?? "" : "";
        vars["lactType"]            = content.TryGetProperty("lactType",            out v) ? v.GetString() ?? "" : "";
        vars["lactReason"]          = content.TryGetProperty("lactReason",          out v) ? v.GetString() ?? "" : "";
        vars["lactNoticeType"]      = content.TryGetProperty("lactNoticeType",      out v) ? v.GetString() ?? "" : "";
        vars["lactNoticeStatus"]    = content.TryGetProperty("lactNoticeStatus",    out v) ? v.GetString() ?? "" : "";
        vars["lastAffRtnDate"]      = content.TryGetProperty("lastAffRtnDate",      out v) ? v.GetString() ?? "" : "";
        vars["juryTermId"]          = content.TryGetProperty("juryTermId",          out v) ? v.GetString() ?? "" : "";
        vars["locTodayDate"]        = content.TryGetProperty("locTodayDate",        out v) ? v.GetInt32().ToString() : "";
        vars["confirmInd"]          = content.TryGetProperty("confirmInd",          out v) ? v.GetString() ?? "" : "";
        vars["tstepqualify"]        = content.TryGetProperty("tstepqualify",        out v) ? v.GetString() ?? "" : "";
        vars["ftacount"]            = content.TryGetProperty("ftacount",            out v) ? v.GetInt32().ToString() : "";
        vars["delinqsts"]           = content.TryGetProperty("delinqsts",           out v) ? v.GetInt32().ToString() : "";
        vars["lastActivityDate"]    = content.TryGetProperty("lastActivityDate",    out v) ? v.GetInt32().ToString() : "";
        vars["jurorType"]           = content.TryGetProperty("jurorType",           out v) ? v.GetInt32().ToString() : "";
        vars["formClasses"]         = content.TryGetProperty("formClasses",         out v) ? v.GetInt32().ToString() : "";
        vars["jrinInd"]             = content.TryGetProperty("jrinInd",             out v) ? v.GetString() ?? "" : "";
        vars["enotifyStatus"]       = content.TryGetProperty("enotifyStatus",       out v) ? v.GetInt32().ToString() : "";
        vars["filler1"]             = content.TryGetProperty("filler1",             out v) ? v.GetString() ?? "" : "";
        vars["pendingUpdate"]       = content.TryGetProperty("pendingUpdate",       out v) ? v.GetRawText() : "";
    }

    if (root.TryGetProperty("extInfos", out var extInfos))
    {
        vars["pin"] = extInfos.TryGetProperty("pin", out v) ? v.GetString() ?? "" : "";
    }
}
"""
StatusCodeVar=JsiHttpStatus
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=APIError_GetJuror
Next=CheckApiStatus_GetJuror


!=============================================
! Check API Result
!=============================================
[CheckApiStatus_GetJuror]
type=Branch
Var=ApiSuccess
true=CheckJsiStatus_GetJuror
Next=APIError_GetJuror

[APIError_GetJuror]
type=Log
var=ApiSuccess,ApiError,JsiHttpStatus,JsiError

[PlayApiError_GetJurorCall]
type=Play
ttsstring="An error occurred while calling the Get Juror API. "
Next=Goodbye

[PlayApiError_GetJuror]
type=Play
ttsstring="An error occurred while retrieving juror information. "
msgString=JsiError
WaitForMsg=TRUE
Next=Goodbye

!=============================================
! Check JSI API Result
!=============================================
[CheckJsiStatus_GetJuror]
type=Log
var=code,message

[PlayGetJurorAPICallSuccess]
type=Play
ttsstring="The Get Juror API call was successful. "

[LogGetJurorInfoRawJsonResponse]
type=Log
var=RawJsonResponse

[LogGetJurorInfoVars]
type=Log
var=personId,badgeNumber,lastName,firstName,jurorStatusInd,jurorType
[CheckLastName]
type=Branch
Var=lastName
""=NoLastName
Next=HasLastName

[NoLastName]
type=Play
ttsstring="The juror's last name is not available. "
WaitForMsg=TRUE
Next=Goodbye

[HasLastName]
type=Play
ttsstring="The juror's last name is "
msgString=lastName%"|C"
WaitForMsg=TRUE
Next=Goodbye


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	TestComplete
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TestComplete]
type=Log

[ThankYouGoodbyeExit]
type=play
msg="Thankyou"

[Goodbye]
type=play
ttsstring="Thank you, Goodbye."
WaitForMsg=TRUE
Next=EndCall

[MenuError]
type=log
next=Goodbye

[ExitOnMaxCallSec]
type=log
next=Goodbye

[ExitOnMaxCallErrors]
type=log
next=Goodbye

[ExitOnScriptError]
type=log
next=Goodbye

[EndCallWithDisconnectHandler]                                 
type=SetGlobals
AllowOnDisconnect=False
next=EndCall

[CallDisconnectHandler]
type=Log

! Disable OnDisconnect
[EndCall]
type=SetGlobals
AllowOnDisconnect=False

! Branch here to end call with the disconnect handler
[EndCall2]                                 
type=CallControl
Command=Disconnect

[FinalBlock]
type=Terminate
LogMsg="Terminating ..."

[FinalFinalBlock]
type=Terminate