! Variable manager tests
! dgoddette
! Oct 2025
[ScriptSetup]
Type=SetGlobals
Language="English"
MaxCallSec=90000
OnMaxCallSec=ExitOnMaxCallSec
MaxCallErrors=12
OnMaxCallErrors=ExitOnMaxCallSec
OnCallDisconnect=CallDisconnectHandler
OnScriptError=ExitOnMaxCallSec
AllowOnDisconnect=True
LogTrace=True

[BlockDefaults]
Type=SetDefaults
DefaultIgnoreMissingMsg=False
DefaultFlushKeys=False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=ExitOnMenuError
DefaultTimeOutSec=10
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=ExitOnMenuError
DefaultOnMaxBadValues=ExitOnMenuError
DefaultLogCall=True
DefaultLogMenu=True
DefaultLogGetDigits=True
DefaultLogPlay=True
DefaultTerminator=""


[DefineVariables]
Type=DefineVars
!  Variable Manager Test vars
TestVmVar1=0
TestVmVar2=0
TestVmVar3=0
TestVmVar1ExpectedValue=123
TestVmVar2ExpectedValue="This is a test"
TestVmVar3ExpectedValue="10/15/2025"
Timechange=""
AnotherTestVariable=""
TestVariable=""
Test3Var=""
StartingValTest3=""


[StartTests]
type=play
TTSString="These are the Variable Manager Tests."

!====================================
! Test01 - get some vars
! 
[Test01]
type=play
TTSString="Test one, get VM variables"

[VarManagerTests]
type=VariableManager
VarList="TestVmVar1,TestVmVar2,TestVmVar3"
OnError=VmError
Next=VMTest1Log

[VmError]
type=log
Next=Test1Fail

[VMTest1Log]
type=Log
Var=TestVmVar1,TestVmVar2,TestVmVar3

[Test1Check1]
type=branch
var=TestVmVar1
TestVmVar1ExpectedValue=Test1Check2
Next=Test1Fail

[Test1Check2]
type=branch
var=TestVmVar2
TestVmVar2ExpectedValue=Test1Check3
Next=Test1Fail

[Test1Check3]
type=branch
var=TestVmVar3
TestVmVar3ExpectedValue=Test1Pass
Next=Test1Fail


[Test1Pass]
type=play
TTSString="Test one passed. Variables retrieved and are the expected values."
Next=Test2

[Test1Fail]
type=play
TTSString="Test one failed. Retrieved Variables not matching expected values."
Next=Test2

!====================================
! Test03 - get some vars from another app
! 
[Test2]
type=play
TTSString="Variable manager test 2. Fetching from another application."

[Test2VM]
type=VariableManager
Application="BasicIvrTest"
varlist=Timechange,AnotherTestVariable,TestVariable
OnError=Vm2Error
Next=VMTest2Log

[Vm2Error]
type=log
Next=Test2Fail

[VMTest2Log]
type=log
var=Timechange,AnotherTestVariable,TestVariable

[Test2Check1]
type=branch
var=TimeChange
"08:00 PM"=Test2Check2
Next=Test2Fail

[Test2check2]
type=branch
var=AnotherTestVariable
"02:00 PM"=Test2Check3
Next=Test2Fail

[Test2check3]
type=branch
var=TestVariable
"I change at 7:48 PM"=Test2Pass
"I change at 2:15 PM"=Test2Pass
Next=Test2Fail


[Test2Pass]
type=play
TTSString="Test two passed. Variables retrieved and are the expected values."
Next=Test3

[Test2Fail]
type=play
TTSString="Test two failed. Retrieved Variables not matching expected values."
Next=Test3

!====================================
! Test03 - Setting variables
! 
[Test3]
type=play
TTSString="Variable manager test 3. Setting variables"

[Test3VM]
type=VariableManager
varlist=Test3Var
OnError=Vm3Error
Next=VMTest3Log


[Vm3Error]
type=log
Next=Test2Fail

[VMTest3Log]
type=log
var=Test3Var

[SetTest3Vars]
type=changeVariable
StartingValTest3=Test3Var

[IncrementTest3Var]
type=changeVariable
Increment=Test3Var

[SetVMVar3]
type=VariableManager
SaveVarList=Test3Var
OnError=VMTest32Error
Next=VMTest32Log

[VmTest32Error]
type=log
Next=Test2Fail

[VMTest32Log]
type=log
var=Test3Var

[ResetTest3Var]
type=changevariable
Test3Var=""

[GetTest3Var]
type=VariableManager
varlist=Test3Var
OnError=Vm33Error
Next=VMTest33Log

[Vm33Error]
type=log
Next=Test2Fail

[VMTest33Log]
type=log
var=Test3Var

[IncrementStartingVal]
type=changeVariable
Increment=StartingValTest3

[CheckTest3Var]
type=branch
var=Test3Var
StartingValTest3=Test3Pass
Next=Test3Fail

[Test3Pass]
type=play
TTSString="Test three passed. Variable was updated in variable manager"
Next=EndCall

[Test3Fail]
type=play
TTSString="Test three failed. Retrieved Variable not matching expected values."
Next=EndCall

!=============================
[ExitOnMaxCallSec]
type=log
next=EndCall

[ExitOnMaxCallErrors]
type=log
next=EndCall

[ExitOnScriptError]
type=log
next=EndCall

[ExitOnMenuError]
type=Log
Next=EndCall

[ExitOnMaxBadKeys]
type=Log
Next=EndCall

[CallDisconnectHandler]
type=log
Next=EndCall

[EndCall]
type=log

[EndMessage]
type=play
TTSString="Thank you, goodbye. Exiting."
WaitForMsg=TRUE

[TerminateCall]
type=Terminate
LogMsg="Terminating ..."

[FinalFinalBlock]
type=Terminate

