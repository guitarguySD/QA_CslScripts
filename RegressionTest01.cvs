[ScriptSetup]
Type=SetGlobals
TTSFilePath="D:\Sonant\VoiceFiles\TTSFiles\"
Language="English"
MaxCallSec=90000
OnMaxCallSec=ExitOnMaxCallSec
MaxCallErrors=12
OnMaxCallErrors=ExitOnMaxCallSec
OnCallDisconnect=CallDisconnectHandler
OnScriptError=ExitOnMaxCallSec
AllowOnDisconnect=True
LogTrace=True

[BlockDefaults]
Type=SetDefaults
DefaultIgnoreMissingMsg=True
DefaultFlushKeys=False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=ExitOnMenuError
DefaultTimeOutSec=10
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=ExitOnMenuError
DefaultOnMaxBadValues=ExitOnMenuError
DefaultLogCall=True
DefaultLogMenu=True
DefaultLogGetDigits=True
DefaultLogPlay=True
DefaultTerminator=""

[DefineVariables]
Type=DefineVars
UserInput=""
numDigits=0
InputString="123456789"
OutputString=""

[Test_MaxDigits]
Type=Play
TTSString="Welcome to the MaxDigits test. "
TTSString="This is a copy string test."

[CopyStringBlockExample]
Type=CopyString
Var=OutputString
String=InputString
Start=3

[LogCopyStringResult]
type=log
var=InputString,OutputString

[GetThreeDigits]
Type=GetDigits
TTSString="Enter three digits now."
Var=UserInput
CountVar=numDigits
MaxDigits=3
TimeOutSec=5
MaxTimeOuts=1
Terminator=#
Next=ValidateDigits

[ValidateDigits]
Type=Branch
Var=numDigits
1=GotOneDigit
2=GotTwoDigits
3=GotThreeDigits
OnAboveRange=DigitsAboveRange
OnBelowRange=DigitsBelowRange

[GotOneDigit]
type=Dial
Dialstring=1
Next=EndTest

[GottwoDigits]
type=Dial
Dialstring=2
Next=EndTest

[GotThreeDigits]
type=Dial
Dialstring=3
Next=EndTest

[DigitsAboveRange]
Type=Log
LogMsg="Get Digits error: count above range = " %numDigits
Next=EndTest

[DigitsBelowRange]
Type=Log
LogMsg="Get Digits error: count below range = " %numDigits
Next=EndTest

[EndTest]
type=log

[WaitForEndTestDigit]
Type=GetDigits
TTSString="Waiting for End Test Handshake"
Var=UserInput
MaxDigits=1
TimeOutSec=10
MaxTimeOuts=1
Next=EndCall

!=============================
[ExitOnMaxCallSec]
type=log
next=EndCall

[ExitOnMaxCallErrors]
type=log
next=EndCall

[ExitOnScriptError]
type=log
next=EndCall

[ExitOnMenuError]
type=Log
Next=EndCall

[ExitOnMaxBadKeys]
type=Log
Next=EndCall

[CallDisconnectHandler]
type=log
Next=EndCall

[EndCall]
type=log

[EndMessage]
type=play
TTSString="Thank you, goodbye. Exiting."
WaitForMsg=TRUE

[TerminateCall]
type=Terminate
LogMsg="Terminating ..."

[FinalFinalBlock]
type=Terminate
