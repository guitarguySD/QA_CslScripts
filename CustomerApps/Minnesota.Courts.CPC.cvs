[GetYearAndSequence]     ! p. 35
type=recognize
PromptMsg="EnterRemainingNumeric"
PromptMsgDTMF="EnterRemainingNumericDTMF"
!Grammar="Digits"
DTMFTerminator="#"
MinDigitsMsg="ExpectingThreeToNine"
MaxDigitsMsg="ExpectingThreeToNine"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
