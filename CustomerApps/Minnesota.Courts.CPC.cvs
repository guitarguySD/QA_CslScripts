ConvenienceFeeMsgFlag=1

[PlayConvenienceFeeMsgForPaymentEligibleCallers]
type=play
msg="CanMakePayment"
msg="TransactionWillIncludeFee"
msgstring=ConvenienceFee%"|M"
msg="ConvenienceFee"
Next=CitationMenu

[PlayNotPayable]
type=play
msg="NotPayable"
Next=CitationMenu


[CaseClosed]
type=play
msg="CitationClosed"
Next=CitationMenu



[CitationMenu]     !p. 22
type=branch
