ResultFormat=Digits
ResultLengthMin=3
ResultLengthMax=16
OnDTMFError=Sorry
BadKeyMsg="InvalidSelectionDTMF"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="Thanks"

[SetSearchValueForCaseRetrieval]
