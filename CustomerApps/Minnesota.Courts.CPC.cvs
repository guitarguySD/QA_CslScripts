[CheckForSpecialHandlingOnCase]
type=Branch
var=TR_IsCaseSpecialHandlingNeeded
1=PlaySpecialHandlingContactUs
Next=CheckWarrantForSpecialConditions

[CheckWarrantForSpecialConditions]
type=branch
var=TR_IsCaseInWarrant
1=PlayWarrantIssued
Next=CheckForReferredToCollection

[CheckForReferredToCollection]
type=branch
var=TR_IsCaseReferredToCollection
1=CheckBalanceDueWithReferredToCollection
Next=CheckForMandatoryAppearance

[CheckBalanceDueWithReferredToCollection]
type=branch
var=TR_CasePaymentAmount
""=PlaySpecialHandlingContactUs
0=PlaySpecialHandlingContactUs
Next=PlayCitationReferred

[CheckForMandatoryAppearance]
type=branch
var=TR_IsCaseHaveMandatoryAppearanceDate
1=CheckForLicenseSuspendedWithMandatoryAppearance
Next=CheckForLicenseSuspended

[CheckForLicenseSuspendedWithMandatoryAppearance]
type=branch
var=TR_IsCaseLicenseSuspended
1=PlaySpecialHandlingContactUs
Next=CheckBalanceDueWithMandatoryAppearance

[CheckBalanceDueWithMandatoryAppearance]
type=branch
var=TR_CasePaymentAmount
""=CheckForCaseClosedWithMandatoryAppearance
0=CheckForCaseClosedWithMandatoryAppearance
Next=PlaySpecialHandlingContactUs

[CheckForCaseClosedWithMandatoryAppearance]
type=branch
var=TR_IsCaseClosed
1=CaseClosed
Next=PlayCitationRequiresAppearance

[CheckForLicenseSuspended]
type=branch
var=TR_IsCaseLicenseSuspended
1=CheckBalanceDueWithLicenseSuspended
Next=CheckBalanceDueWithoutLicenseSuspended

[CheckBalanceDueWithLicenseSuspended]
type=branch
var=TR_CasePaymentAmount
""=PlaySuspendedLicenseContactUs
0=PlaySuspendedLicenseContactUs
Next=PlayCitationResultedInSuspension

[CheckBalanceDueWithoutLicenseSuspended]
type=branch
var=TR_CasePaymentAmount
""=CheckCaseClosedFlagForCasesWithNoBalanceDue
0=CheckCaseClosedFlagForCasesWithNoBalanceDue
Next=CheckConvenienceFeeMsgFlagForPaymentEligibleCallers

[CheckCaseClosedFlagForCasesWithNoBalanceDue]
type=branch
var=TR_IsCaseClosed
1=CaseClosed
Next=PlayDataProblemContactUs

[PlayDataProblemContactUs]
type=play
msg="DataProblemContactUs"
Next=PlayContactAdministration

[PlayCitationRequiresAppearance]
type=play
msg="CitationRequiresAppearance"
Next=PlayContactAdministration

[PlaySpecialHandlingContactUs]
type=play
msg="SpecialHandlingContactUs"

[PlayContactAdministration]
type=play
msg="ContactAdministration"
msgstring=CountyPhoneNumber%"|C"
Next=CitationMenu


[PlayCitationReferred]
type=play
msg="CitationReferred"
msgstring=CollectionsCallBackPhoneNumber%"|C"
msg="AgainThatNumber"
msgstring=CollectionsCallBackPhoneNumber%"|C"
Next=CitationMenu

[PlayWarrantIssued]
type=play
msg="WarrantIssued"
msgstring=CountyPhoneNumber%"|C"
msg="Immediately"
Next=CitationMenu


[PlaySuspendedLicenseContactUs]     !p. 21
type=play
msg="SuspendedLicenseContactUs"
msgstring=CountyPhoneNumber%"|C"
Next=CitationMenu

[PlayCitationResultedInSuspension]
type=play
msg="CitationResultedInSuspension"

[CheckConvenienceFeeMsgFlagForPaymentEligibleCallers]
type=branch
var=ConvenienceFeeMsgFlag
1=CitationMenu

[SetConvenienceFeeMsgFlagToTrueForPaymentEligibleCallers]
