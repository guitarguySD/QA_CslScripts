[CitationProcess]     ! p. 25
type=log
logmsg="Citation Process"
LogType=ScriptEvent

[CitationProcessResetVars]
type=ChangeVariable
TR_SearchCitationNumber=""
CitationLetters=""
FirstLetter=""
Letter=""
CitationDigits=""
LetterEntryReturn=""

[CitationProcessMenu]
Type=Menu
Msg="CitationNumberMenuDTMF"
OnKey1=SetCitationLetterToNull
OnKey2=GetLetters
OnKeyStar=CitationProcessMenu

[SetCitationLetterToNull]
type=ChangeVariable
CitationLetters=""
Next=CitationGetDigits


[PlayNowForCitationProcess]
type=play
msg="Now"

[CitationGetDigits]
type=recognize
PromptMsg="EnterDigits"
PromptMsgDTMF="EnterDigitsDTMF"
!Grammar="Digits"
DTMFTerminator="#"
MinDigitsMsg="ExpectingTwoToTwenty"
MaxDigitsMsg="ExpectingTwoToTwenty"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnKeyStar=CitationGetDigits
Var=CitationDigits
ResultFormat=Digits
ResultLengthMin=2
ResultLengthMax=21
OnDTMFError=SetOperatorMsgForCitationGetDigits
BadKeyMsg="InvalidSelectionDTMF"

TimeoutMsgDTMF="TimeoutDTMF"

SuccessMsg="Thanks"
Next=EnterDOBForCitation

[SetOperatorMsgForCitationGetDigits]
type=ChangeVariable
ScreenMsg="Errors in Cit#"
Next=Sorry


[EnterDOBForCitation]
Type=Recognize
PromptMsg="WhatIsDOB"
PromptMsgDTMF="WhatIsDOBDTMF"
!Grammar="Date"
Var=TR_SearchDateOfBirth
!DTMFTerminator="#"
MinDigitsMsg="ExpectingEight"
MaxDigitsMsg="ExpectingEight"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnKeyStar=EnterDOBForCitation
ResultFormat=Date
ResultLengthMin=8
ResultLengthMax=8
OnDTMFError=Sorry
BadKeyMsg="InvalidSelectionDTMF"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="Thanks"

[SetSearchTypeToCitation]
type=log
var=FirstLetter,SecondLetter,ThirdLetter,FourthLetter

[SetSearchTypeToCitation3]
type=changevariable
TR_SearchType=2
TR_SearchCitationNumber=CitationLetters%FirstLetter%SecondLetter%ThirdLetter%FourthLetter%CitationDigits  ! unneeded values are null
Next=RetrieveCitation



[RetrieveCitation]     !p. 28
type=play
msg="HoldForRecord"
msg=music2

[LogInputForRetrieveCitation]
type=log
var=TR_SearchType,TR_SearchCitationNumber,TR_SearchDateOfBirth

[ExecuteGetCases]
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetCases"
OnExecuteError=LogExecuteGetCasesError
Next=GetCitByCit

[LogExecuteGetCasesError]
type=log
var=TR_ErrorMessage,TR_ResultCode

[CheckResultCodeForGetCasesError]
type=branch
var=TR_ResultCode
100=GetCasesErrorStopPlay
Next=SystemError

[GetCasesErrorStopPlay]
type=Play
FlushPlayQueue=True
Next=PlayErrorInFormatForCaseProcess

[PlayErrorInFormatForCaseProcess]
type=play
msg="ErrorInFormat"
Next=EnterDOBForCitation

[GetCitByCit]
type=log
logmsg="RetrieveByCit"
LogType=ScriptEvent

[GetCitationRecordStopPlay]
type=Play
FlushPlayQueue=True

[SetCitationCountMinusOne]
type=ChangeVariable
CitationCountMinusOne=TR_CasesPayableCount

[SetForCitationEnteredIntroPlay]
type=ChangeVariable
Decrement=CitationCountMinusOne

[LogRetrieveCitationResults]
type=log
var=TR_ResultCode,TR_CasesCount,TR_CaseIndex,TR_CasesPaymentAmount,TR_CaseNumber

[CheckRetrieveCitationResult]
type=branch
var=TR_ResultCode
0=CheckCitationCountForValidityRetrieveCitation
1=TrafficRecordNotFoundCitationSearch
2=CheckCitationCountForValidityRetrieveCitation  !=too many records
3=CitationDOBMismatch
5=SystemError       !=data issues
6=MultipleCitationsFoundMenu
Next=SystemError

[CheckCitationCountForValidityRetrieveCitation]                          ! to catch retrievals with no data
type=branch
var=TR_CasesCount
0=CheckPaymentPlanCountForValidityRetrieveCitation
Next=EnteredCitOrCase

[CheckPaymentPlanCountForValidityRetrieveCitation]                          ! to catch retrievals with no data; need to check for plan-only accounts
type=branch
var=TR_PaymentPlansCount
""=TrafficRecordNotFoundCitationSearch
0=TrafficRecordNotFoundCitationSearch
Next=EnteredCitOrCase

[CitationDOBMismatch]
type=log
logmsg="CITDOBMismatch"
LogType=ScriptEvent

[CitationDOBMismatchMenu]
type=Recognize
PromptMsg="DOBMismatch",TR_SearchCitationNumber|C,"AndDateOfBirth",TR_SearchDateOfBirth|C,"CitationDOBMismatchMenu"
PromptMsgDTMF="DOBMismatch",TR_SearchCitationNumber|C,"AndDateOfBirth",TR_SearchDateOfBirth|C,"CitationDOBMismatchMenuDTMF"
!Grammar="CitationDOBMismatch"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Mismatch=SetOperatorMsgForCitationDOBMismatch
OnResult:Date=EnterDOBForCitation
OnResult:License=DLProcess
OnResult:Citation=CitationProcess
OnResult:Main=MainMenu
OnResult:Agent=SetOperatorMsgForCitationDOBMismatch
OnKey1=SetOperatorMsgForCitationDOBMismatch
OnKey2=CitationProcess
OnKey3=EnterDOBForCitation
OnKey4=DLProcess
OnKey5=CaseProcess
OnKey6=MainMenu
OnKeyStar=CitationDOBMismatchMenu
OnKeyPound=CitationDOBMismatchMenu
OnDTMFError=SetOperatorMsgForCitationEntrySorry
BadKeyMsg="InvalidSelectionDTMF"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="OK"

[SetOperatorMsgForCitationDOBMismatch]
type=ChangeVariable
ScreenMsg="Cit/DOB Mismatch"
Next=TransferHaveCitNode

[SetOperatorMsgForCitationEntrySorry]
type=ChangeVariable
ScreenMsg="Errors in Cit#"
Next=SorryRecordNotFound


[TrafficRecordNotFoundCitationSearch]
type=log
logmsg="Rec Not Found CS"
LogType=ScriptEvent

[Data_NotFoundCitationNumber]
type=log
logmsg="Not Found Citation# = "%TR_SearchCitationNumber

[CitationRecordNotFound]
type=play
msg="CitationNotFound"
msgstring=TR_SearchCitationNumber%"|C"
msg="RecentlyIssued"
msgstring=DaysBeforeEntered%"|N"
msg="CallBack"

[CitationRecordNotFoundMenu]
type=Menu
msg="CitationNotFoundMenuDTMF"
OnKey1=SetOperatorMsgForCitationRecordNotFoundMenu
OnKey2=CitationProcess
OnKey3=DLProcess
OnKey4=CaseProcess
OnKey5=MainMenu
OnKeyStar=CitationRecordNotFound
OnKeyPound=CitationRecordNotFound

[SetOperatorMsgForCitationRecordNotFoundMenu]
