@PlayOption4=0

[CheckCartForCitationMenuOptionFive]
type=branch
var=TR_ItemsCount
0=SetCitationMenuOptionFiveToFalse
""=SetCitationMenuOptionFiveToFalse
Next=CheckCartForCitationMenuOption6

[SetCitationMenuOptionFiveToFalse]
Type=ChangeVariable
@PlayOption5=0

[CheckCartForCitationMenuOption6]
type=branch
var=TR_ItemsCount
""=CheckPlanCountForCitationMenu2
0=CheckPlanCountForCitationMenu2
Next=SetCitationMenuOptionSixToFalse

[CheckPlanCountForCitationMenu2]
