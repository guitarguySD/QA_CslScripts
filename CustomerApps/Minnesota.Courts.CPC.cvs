logmsg="Get Cit By Case"
LogType=ScriptEvent

[GetCaseStopPlay]
type=Play
FlushPlayQueue=True

[LogGetCaseResults]
type=log
var=TR_ResultCode,TR_CasesCount,TR_CaseIndex,TR_CaseNumber,TR_CaseNumber,TR_CasesPayableCount

[CheckGetCaseResult]
type=branch
var=TR_ResultCode
0=EnteredCitOrCase
1=TrafficRecordNotFoundCaseSearch 
2=TooManyRecords  !=too many records; going away but for now...
3=EnteredCitOrCase  !=DOB mismatch 
5=SystemError       !=data issues
Next=SystemError


[TrafficRecordNotFoundCaseSearch]
type=log
logmsg="Case Cit Not Fnd"
