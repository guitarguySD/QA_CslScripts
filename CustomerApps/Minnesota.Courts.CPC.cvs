!========================================
! Set System Defaults
!========================================
[BlockDefaults]
Type=SetDefaults
DefaultIgnoreMissingMsg=True
DefaultFlushKeys=False
DefaultBadKeyMsg="InvalidSelectionDTMF"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=Sorry
DefaultTimeOutSec=5
DefaultTimeOutMsg="TimeoutDTMF"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=Sorry
DefaultLogCall=True
DefaultLogMenu=True
DefaultLogGetDigits=True
DefaultLogPlay=True
DefaultTerminator=""


[GetVMVariables1]   ! p. 4
type=VariableManager
Application="CPC"
VarList="CallbackFifoDisabled,UseInBandDTMFForHPS,CallbackAvailable,HPS_PhoneNumber,ListCountyPhoneNumbers,ListCountyNames,HolidayToday,AssistanceAvailable,OpeningTime,ClosingTime,RecordPassword,PhraseToRecord,MinimumInstallmentPayment,DaysBeforeEntered,CollectionsCallBackPhoneNumber,ConvenienceFee,AskSurvey,FairnessSurveyPhoneNumber,IVRTestMode,VFShare,MinimumCasePayment,PartialPayAvailable"
OnError=LogVMError
Next=CheckTestMode

[LogVMError]
type=log
logmsg="VariableManager Error"

[CheckTestMode]
type=branch
var=IVRTestMode
1=PlayHiddenTestModeMenu	! in test mode
0=BranchOnCallType	!not in test mode
Next=BranchOnCallType

[BranchOnCallType]
type=Branch
var=@CallType
1=LanguageMenu
3=MaintenanceMode
4=OverloadMode
10=SetCallbackCall
Next=LanguageMenu

[SetCallbackCall]
type=ChangeVariable
CallbackCall=1

[LogCallID]
type=log
var=@CallID
Next=StartCallback

[MaintenanceMode]
type=Play
msg="MaintenanceGreeting"
msg="MaintenanceGreetingSpanish"
WaitForMsg=TRUE
Next=Exit

[OverloadMode]
type=Play
msg="CapacityGreeting"
msg="CapacityGreetingSpanish"
WaitForMsg=TRUE
Next=Exit

[PlayHiddenTestModeMenu]
type=menu
msg="TestModeMenu"
OnKey1=LanguageMenu
OnKey2=Exit
OnKey3=Exit
OnKey4=Exit
OnKey5=Exit
OnKey6=Exit
OnKey7=Exit
OnKey8=Exit
OnKey9=Exit
OnKey0=Exit
OnKeyStar=Exit
OnKeyPound=AdminFunctions
TimeOutSec=2   
MaxTimeouts=0
OnMaxTimeouts=Exit


[LanguageMenu] 
type=menu
msg="TrafficGreeting"
msg="LanguageMenuDTMF"
msg="OtherwiseRemain"
OnKey1=SpanishTraffic
OnKey2=EnglishTraffic
OnKey3=EnglishTraffic
OnKey4=EnglishTraffic
OnKey5=EnglishTraffic
OnKey6=EnglishTraffic
OnKey7=EnglishTraffic
OnKey8=EnglishTraffic
OnKey9=EnglishTraffic
! OnKey9=RouteToSupervisorVMLog ! used for testing
OnKey0=SetOperatorMsgForLanguageMenu
OnKeyStar=EnglishTraffic
OnKeyPound=AdminFunctions
TimeOutSec=2   
MaxTimeouts=0
OnMaxTimeouts=EnglishTraffic

[SetOperatorMsgForLanguageMenu]
type=ChangeVariable
ScreenMsg="Help @ Lang Menu"
Next=TransferNoNode

[EnglishTraffic]
type=Log
Logmsg="CallsEnglish"
LogType=ScriptEvent

[SetEnglishDirectory]
type=SetGlobals
Language="English"
Next=OptionalGreeting

[OptionalGreeting]     !p. 6
type=play
msg=VFShare%"\English\OptionalGreeting"
DoNotUseCache=True
WaitForMsg=True
Next=CheckHolidayToday

[SpanishTraffic]
type=Log
Logmsg="CallsSpanish"
LogType=ScriptEvent

[SetSpanishRouteTraffic]
type=SetGlobals
Language="Spanish"

[SetSpanishLanguage]
type=ChangeVariable
TR_CallerLanguage="Spanish"
ACD_RouteName="CPCSpanish"

[GreetingSpanishTraffic]
type=Play
msg="TrafficGreetingSpanish"


[OptionalGreetingSpanish]     !p. 6
type=play
msg=VFShare%"\Spanish\OptionalGreetingSpanish"
DoNotUseCache=True
WaitForMsg=True

[CheckHolidayToday]           
type=branch
var=HolidayToday
1=PlayHolidayToday
Next=MainMenu

[PlayHolidayToday]
type=play
msg="HolidayToday"

[ForceAAFalseHoliday]
type=changevariable
AssistanceAvailable=0


[MainMenu]     !p. 6a
Type=Branch
Var=AssistanceAvailable
1=MainMenuOpen
Next=MainMenuClosed

[MainMenuOpen]
type=menu
msg="MainMenuOpen"
OnKey1=ProcessTicket
OnKey2=RamseyHennepinAppt
OnKey3=InsuranceRegistrationLateNotice
OnKey4=GeneralInformationMain
OnKey5=OperatorMain
OnKeyStar=MainMenuOpen
OnKeyPound=AdminFunctions
MaxTimeouts=2
OnMaxTimeouts=Sorry

[MainMenuClosed]
type=menu
msg="MainMenuClosed"
OnKey1=ProcessTicket
OnKey2=InsuranceRegistrationLateNotice
OnKey3=GeneralInformationMain
OnKeyStar=MainMenuClosed
OnKeyPound=AdminFunctions
MaxTimeouts=0
OnMaxTimeouts=Exit

[InsuranceRegistrationLateNotice]
type=log
logmsg="MainMenu Option1"
LogType=ScriptEvent
Next=InsuranceRegistrationLateNoticeMenu

[ProcessTicket]
type=Log
logmsg="MainMenu Option2"
LogType=ScriptEvent
Next=ProcessTicketMenu

[RamseyHennepinAppt]
type=log
logmsg="RamseyHennepinAppt"
LogType=ScriptEvent

[SetOperatorMsgForRamseyHennepinAppt]
type=ChangeVariable
ScreenMsg="Ramsey Hennepin Appt"
Next=ACDAvailable

[GeneralInformationMain]
type=log
logmsg="MainMenu Option4"
LogType=ScriptEvent
Next=GeneralInformation

[OperatorMain]
type=log
logmsg="MainMenu Option5"
LogType=ScriptEvent
Next=SetOperatorMsgForMainMenu


[InsuranceRegistrationLateNoticeMenu]     !p. 6b
Type=menu
Msg="InsuranceRegistrationLateNoticeMenu"
OnKey1=SetForInsuranceMsg
OnKey2=SetForRegistrationMsg
OnKey3=SetForLateNoticeMsg
OnKeyStar=InsuranceRegistrationLateNoticeMenu

[SetForInsuranceMsg]
type=ChangeVariable
TempMsg="Insurance"
Next=PlayInsuranceRegistrationLateNoticeMsg

[SetForRegistrationMsg]
type=ChangeVariable
TempMsg="Registration"
Next=PlayInsuranceRegistrationLateNoticeMsg

[SetForLateNoticeMsg]
type=ChangeVariable
TempMsg="LateNotice"

[PlayInsuranceRegistrationLateNoticeMsg]
type=play
msg=TempMsg

[InsuranceRegistrationLateNoticeEndMenu]
Type=menu
Msg="ReplayOrMainMenu"
OnKey9=MainMenu
OnKeyStar=PlayInsuranceRegistrationLateNoticeMsg


[ProcessTicketMenu]     !p. 6c
Type=menu
Msg="ProcessTicketMenu"
OnKey1=DLProcess
OnKey2=CitationProcess
OnKey3=CaseProcess
OnKey0=SetOperatorMsgForMainMenu
OnKeyStar=ProcessTicketMenu

[SetOperatorMsgForMainMenu]
type=ChangeVariable
ScreenMsg="Help @ Main Menu"
Next=TransferNoNode


[DLProcess]     !p. 7
type=log
logmsg="DL Process"
LogType=ScriptEvent

[DLProcessResetVars]
type=ChangeVariable
TR_SearchDLNumber=""
CitationLetters=""
FirstLetter=""
Letter=""
CitationDigits=""

[DLProcessMenu]
Type=Recognize
PromptMsg="DLMenu"
PromptMsgDTMF="DLMenuDTMF"
!Grammar="OLNMenu"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Minnesota=SetForMinnesotaDLEntry
OnResult:SouthDakota=SetForSouthDakotaDLEntry
OnResult:Wisconsin=SetForWisconsinDLEntry
OnResult:NouthDakota=SetForNouthDakotaDLEntry
OnResult:Neither=CannotUseOLNProcess
OnKey1=SetForMinnesotaDLEntry
OnKey2=SetForWisconsinDLEntry
OnKey3=SetForSouthDakotaDLEntry
OnKey4=SetForNouthDakotaDLEntry
OnKey5=CannotUseOLNProcess
OnKeyStar=DLProcessMenu
OnDTMFError=Sorry
BadKeyMsg="InvalidSelectionDTMF"

TimeoutMsgDTMF="TimeoutDTMF"

SuccessMsg="OK"

[CannotUseOLNProcess]
type=branch
var=TR_ItemsCount
""=SetOptionThreeToFalseForCannotUseOLNProcess
0=SetOptionThreeToFalseForCannotUseOLNProcess
Next=CannotUseOLNMenu

[SetOptionThreeToFalseForCannotUseOLNProcess]
type=ChangeVariable
@PlayOption3=0

[CannotUseOLNMenu]
Type=Recognize
PromptMsg="CannotUseOLNProcessMenu","CompletePayment"|X|3,"CannotUseOLNProcessMenu2"
PromptMsgDTMF="CannotUseOLNProcessMenuDTMF","CompletePayment3"|X|3,"CannotUseOLNProcessMenu2DTMF"
!Grammar="CannotUse"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Citation=CitationProcess
OnResult:Case=CaseProcess
OnResult:Information=GeneralInformation
OnResult:Agent=SetOperatorMsgForCannotUseOLNMenu
OnResult:Authorization=GetAuthorization
OnKey1=CitationProcess
OnKey2=CaseProcess
OnKey3=GetAuthorization
OnKey4=GeneralInformation
OnKey0=SetOperatorMsgForCannotUseOLNMenu
OnKeyStar=CannotUseOLNMenu
OnDTMFError=SetOperatorMsgForCannotUseOLNMenuSorry
BadKeyMsg="InvalidSelectionDTMF"

TimeoutMsgDTMF="TimeoutDTMF"

SuccessMsg="OK"

[SetOperatorMsgForCannotUseOLNMenu]
type=ChangeVariable
ScreenMsg="DL from other state"
Next=TransferNoNode

[SetOperatorMsgForCannotUseOLNMenuSorry]
type=ChangeVariable
ScreenMsg="Errors in DL entered"
