TR_SearchCaseNumber=CaseCourt%CaseSequence
TR_SearchType=1
Next=RetrieveCase



[RetrieveCase]    ! p. 36
type=play
msg="HoldForRecord"
msg=Music1

[LogInputForGetCase]
type=log
var=TR_SearchType,TR_SearchCaseNumber

