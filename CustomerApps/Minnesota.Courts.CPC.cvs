[SetCitationMenuOptionSevenToFalse]
Type=ChangeVariable
@PlayOption7=0


[CheckCartForCitationMenuOption9]
type=branch
var=TR_ItemsCount
""=PlayCitationMenu
0=PlayCitationMenu

[SetCitationMenuOptionNineToFalse]
Type=ChangeVariable
@PlayOption9=0

[PlayCitationMenu]
Type=Recognize
PromptMsg="HearAgain","PayCitationBalance"|X|1,"StaffAssistance"|X|2,"NextCitation"|X|3,"ForPlans"|X|4,"CompletePayment"|X|5,"HearAllAgain"|X|6,"SummaryOfAll"|X|7,"MainMenuReturn"|X|9,"RepeatChoices"
PromptMsgDTMF="HearAgainPound","PayCitationBalance1"|X|1,"StaffAssistance2"|X|2,"NextCitation3"|X|3,"ForPlans4"|X|4,"CompletePaymentForItems5"|X|5,"HearAllAgain6"|X|6,"SummaryOfAll7"|X|7,"MainMenuReturn9"|X|9,"RepeatChoicesStar"
!Grammar="CitationMenu"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:"Again"=CitationMenu
OnResult:"Balance"=CheckPartialPayAvailable
OnResult:"Citation"=GetNextCitation
OnResult:"Plan"=PlanSummary
OnResult:"Authorization"=GetAuthorization
OnResult:"All"=GetNextCitation
OnResult:"Main"=MainMenu
OnKey1=CheckPartialPayAvailable
Onkey2=SetOperatorMsgForCitationMenu
Onkey3=GetNextCitation
Onkey4=PlanSummary
Onkey5=GetAuthorization
Onkey6=GetNextCitation
OnKey7=SetEnteredCitHasOther
Onkey9=MainMenu
OnkeyStar=CitationMenu
Onkeypound=BailCitationSummary
BadKeyMsg="InvalidSelectionDTMF"
OnDTMFError=Sorry
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="OK"

[SetOperatorMsgForCitationMenu]
type=ChangeVariable
ScreenMsg="Help @ Citation Menu"
Next=TransferHaveCitNode

[CheckPartialPayAvailable]
type=branch
var=PartialPayAvailable
1=CheckPartialPaymentAmountForCitationMenu
Next=CitationPaymentSetup

[CheckPartialPaymentAmountForCitationMenu]
type=branch
var=TR_CasePaymentAmount
CompareType=Float
MinimumCasePayment=CitationPaymentSetup
OnBelowRange=CitationPaymentSetup
OnAboveRange=PartialPayMenu
Next=PartialPayMenu


[CitationPaymentSetup]
Type=ChangeVariable
TR_AddToCartType=4
PaymentType=2
Next=AddToCart

[SetEnteredCitHasOther]
Type=ChangeVariable
EnteredCitHasOther=0
Next=OverallSummary




