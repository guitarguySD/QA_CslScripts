[CCApprovedMenu]
Type=Recognize
PromptMsg="HearTransactionAgain","ToProcessNextTransaction"|X|1,"ToUseADifferentCard"|X|2,"StillWantAssistance"|X|3,"GeneralInfo"|X|4,"SurveyQuery5"|X|5,"ToEndCall","RepeatChoices"
PromptMsgDTMF="HearTransactionAgainPound","ToProcessNextTransaction1"|X|1,"ToUseADifferentCard2"|X|2,"StillWantAssistance3"|X|3,"GeneralInfo4"|X|4,"SurveyQuery5DTMF"|X|5,"ToEndCall6","RepeatChoicesStar"
!Grammar="TransactionApproved"
