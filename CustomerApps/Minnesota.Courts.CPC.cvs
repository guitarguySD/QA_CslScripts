[PlayPendingPaymentMenu]
Type=Recognize
PromptMsg="HearAgain","StaffAssistance","NextCitation"|X|3,"ForPlans"|X|4,"CompletePayment"|X|5,"HearAllAgain"|X|6,"SummaryOfAll"|X|7,"MainMenuReturn"|X|9,"RepeatChoices"
PromptMsgDTMF="HearAgainPound","StaffAssistance1","NextCitation3"|X|3,"ForPlans4"|X|4,"CompletePaymentItem5"|X|5,"HearAllAgain6"|X|6,"SummaryOfAll7"|X|7,"MainMenuReturn9"|X|9,"RepeatChoicesStar"
!Grammar="PendingPaymentMenu"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:"Again"=PendingPaymentMenu
OnResult:"Citation"=GetNextCitation
OnResult:"Plan"=PlanSummary
OnResult:"Authorization"=GetAuthorization
OnResult:"All"=GetNextCitation
