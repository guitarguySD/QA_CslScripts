[PlanPartialPaySetup]    ! p. 17
type=ChangeVariable
MaxPay=TR_PaymentPlanBalanceAmount
MinPay=MinimumInstallmentPayment
Next=PlanPartialPayment

[PartialPayMenu]
type=menu
msg="PartialPayMenu"
OnKey1=CitationPaymentSetup
OnKey2=CitationPartialPaymentSetup
OnKey3=CitationMenu
OnKeyStar=PartialPayMenu

[CitationPartialPaymentSetup]
Type=ChangeVariable
PaymentType=5
TR_AddToCartType=11
RetryCounter=0
MaxPay=TR_CasePaymentAmount
MinPay=MinimumCasePayment
Next=EnterPartialPaymentAmount


[PlanPartialPayment]     ! p. 18
type=ChangeVariable
RetryCounter=0

[EnterPartialPaymentAmount]
type=recognize
PromptMsg="MayPay",MinPay|M,"To",MaxPay|M,"EnterPartialPay"
PromptMsgDTMF="MayPay",MinPay|M,"To",MaxPay|M,"EnterPartialPayDTMF"
!Grammar=".Digits"
DTMFTerminator="#"
MinDigitsMsg="ExpectingOneToFour"
MaxDigitsMsg="ExpectingOneToFour"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnKeyStar=EnterPartialPaymentAmount
Var=TR_CustomPaymentAmount
ResultFormat=Digits
ResultLengthMin=1
ResultLengthMax=5
OnDTMFError=Sorry
BadKeyMsg="InvalidSelectionDTMF"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="Thanks"
Next=CheckPartialPaymentAmountVersusMaxPay

[CheckPartialPaymentAmountVersusMaxPay]
type=branch
var=TR_CustomPaymentAmount
CompareType=Float
MaxPay=CheckPaymentTypeForFullPayment
OnBelowRange=CheckPartialPaymentAmountVersusMinPay
OnAboveRange=SetForEntryTooMuchPartialPayment
Next=CheckPartialPaymentAmountVersusMinPay

[CheckPaymentTypeForFullPayment]
type=branch
var=PaymentType
5=CitationPaymentSetup  !case full payment
Next=SetForFullPayment

[SetForFullPayment]  !plan full payment
type=ChangeVariable
PaymentType=3
TR_AddToCartType=5
Next=AddToCart

[CheckPartialPaymentAmountVersusMinPay]
type=branch
var=TR_CustomPaymentAmount
CompareType=Float
MinPay=CheckPartialPaymentAmountVersusMaxPayAgain
OnBelowRange=SetForEntryTooSmallPartialPayment
OnAboveRange=CheckPartialPaymentAmountVersusMaxPayAgain

[CheckPartialPaymentAmountVersusMaxPayAgain]
type=branch
var=TR_CustomPaymentAmount
CompareType=Float
MaxPay=SetForFullPayment

[CheckPaymentTypeForPartialPayment]
type=branch
var=PaymentType
5=AddToCart                 !case partial payment
Next=SetForPartialPayment

[SetForPartialPayment]      !plan partial payment
type=ChangeVariable
PaymentType=4
TR_AddToCartType=9
Next=AddToCart

[SetForEntryTooMuchPartialPayment]
type=ChangeVariable
TempMessage="EntryTooMuch"
Next=CheckPartialPaymentAmountRetryCounter

[SetForEntryTooSmallPartialPayment]
type=ChangeVariable
TempMessage="EntryTooSmall"

[CheckPartialPaymentAmountRetryCounter]
type=ChangeVariable
Increment=RetryCounter

[CheckRetryCounterForPartialPayment]
type=branch
var=RetryCounter
3=SetOperatorMsgForPartialPayment
OnBelowRange=PlayErrorMsgForPartialPayment
OnAboveRange=SetOperatorMsgForPartialPayment

[PlayErrorMsgForPartialPayment]
type=play
msg=TempMessage
Next=EnterPartialPaymentAmount

[SetOperatorMsgForPartialPayment]
