OnKey3=SetOperatorMsgForCCApprovedMenu
OnKey4=GeneralInformation
OnKey5=SetDoSurveyContinueAuthorized
OnKey6=Exit
OnKeyStar=ContinueAuthorized
OnKeyPound=SetForReplayOfTransaction
