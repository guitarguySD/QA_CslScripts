[PlayCaseOnPlan]
type=play
msg="CaseOnPlan"
Next=PlanSummary    !PreSummaryLogic - 11-23-2020 change so that all case/cit retrievals don't go directly to overall summary

[CheckPayableCitationsCountForEnteredCitOrCase]
type=branch
var=TR_CasesCount
0=CheckForCaseData      !means retrieved citation is inactive and caller has no other active citations
1=CheckPayablePaymentPlanCountForEnteredCitOrCase
