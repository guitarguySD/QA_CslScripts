[EnteredCitOrCase]     ! p. 29
type=branch
var=TR_IsSearchedCaseOnPaymentPlan
1=PlayCaseOnPlan
Next=CheckPlanSpecialHandlingNeeded

[CheckPlanSpecialHandlingNeeded]
type=branch
var=TR_IsPaymentPlanSpecialHandlingNeeded
1=PlayCaseOnPlan
