Next=SorryRecordNotFound



[AddToCart]     ! p. 37
type=log
var=TR_PaymentAmount,TR_AddToCartType,TR_CaseIndex,TR_PaymentPlanIndex,TR_ItemsCount,TR_ItemTotalAmount,TR_TotalAmount,CartCount

[LookAtUpdateType]
type=branch
var=PaymentType
1=PaymentFullAll
2=PaymentCitation
3=PaymentPlanBalance
4=PaymentPlanPartial
5=PaymentCitationPartial

[PaymentFullAll]
type=log
logmsg="Pmt-Full-ALL"
LogType=ScriptEvent
Next=ExecuteAddToCart

[PaymentCitation]
type=log
logmsg="Pmt-Case"
LogType=ScriptEvent
Next=ExecuteAddToCart

[PaymentCitationPartial]
type=log
logmsg="Pmt-Case-Partial"
LogType=ScriptEvent
Next=ExecuteAddToCart

[PaymentPlanBalance]
type=log
logmsg="Pmt-Plan-ALL"
LogType=ScriptEvent
Next=ExecuteAddToCart

[PaymentPlanPartial]
type=log
logmsg="Pmt-Plan-Partial"
LogType=ScriptEvent

[ExecuteAddToCart]
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="AddToCart"
OnExecuteError=LogExecuteAddToCartError
Next=IncrementCartCount

[LogExecuteAddToCartError]
type=log
var=TR_ErrorMessage,TR_ResultCode
Next=EPSError

[IncrementCartCount]
type=ChangeVariable
Increment=CartCount
TR_PaymentAmount=""

[LogAddToCartOutput]
type=log
var=TR_ItemsCount,TR_ItemTotalAmount,TR_TotalAmount

[CheckAddToCartTrResult]
type=branch
var=TR_ResultCode
0=SetFeeAmount
1=PlayDuplicateInCart
2=PlayCitationPendingUpdate
Next=EPSError

[SetFeeAmount]
type=ChangeVariable
FeeAmount=TR_GroupCartsCount*ConvenienceFee

[SetTotalAmount]
type=ChangeVariable
TotalAmount=TR_GroupCartsTotalAmount+FeeAmount

[LogFeeAmount]
type=log
var=FeeAmount,TotalAmount,CartCount
Next=CheckTransactionsCountForAddToCart

[PlayDuplicateInCart]
type=play
msg="AlreadyInCart"

[CheckTransactionsCountForDuplicate]
type=branch
var=TR_GroupCartsCount
1=PlayTotalWithFee

[PlayMultipleFees]
type=play
msg="MultipleFees"
Next=PlayFeesAndTotal

[PlayTotalWithFee]
type=play
msg="TotalWithFee"

[PlayFeesAndTotal]
type=play
msgstring=FeeAmount%"|M"
msg="WillBe"
msgstring=TotalAmount%"|M"
Next=AddToCartReturnLogic


[CheckTransactionsCountForAddToCart]
type=branch
var=TR_GroupCartsCount
1=CheckItemsCountForTotalInCart

[PlayMultipleCart]
type=play
msg="MultipleCart"

[CheckItemsCountForTotalInCart]
type=branch
var=TR_ItemsCount
1=PlayTotalOneBillMenu

[CheckPaymentTypeForTotalInCart]
type=branch
var=PaymentType
1=PlayTotalOneBillMenu           !if pay all, wording for TotalOneItem more appropriate
Next=PlayTotalMultiMenu


[PlayTotalMultiMenu]
Type=Play
msg="TotalMultiItems"
msgstring=FeeAmount%"|M"
msg="WillBe"
msgstring=TotalAmount%"|M"
Next=AddToCartReturnLogic

[PlayTotalOneBillMenu]
type=play
msg="TotalOneItem"
msgstring=FeeAmount%"|M"
msg="WillBe"
msgstring=TotalAmount%"|M"
Next=AddToCartReturnLogic



[AddToCartReturnLogic]     !p. 38
type=branch
var=PaymentType
1=GetAuthorization
2=CheckPaymentPlanCountForCitationPaymentType

[CheckLastPaymentPlanForPlanPaymentType]
type=branch
var=TR_PaymentPlansCount
TR_PaymentPlansIndex=CheckCitationForPlanPaymentType
Next=PlanAddReturnMenu

[CheckPaymentPlanCountForCitationPaymentType]
type=branch
var=TR_PaymentPlansCount
0=CheckCitationForCitationPaymentType
1=CheckAllPlansReviewedForCitationPaymentType

[CheckLastPaymentPlanForCitationPaymentType]
type=branch
var=TR_PaymentPlansCount
TR_PaymentPlansIndex=CheckCitationForCitationPaymentType
Next=CitationAddReturnMenu

[CheckAllPlansReviewedForCitationPaymentType]
type=branch
var=AllPlansReviewed
0=CitationAddReturnMenu

[CheckCitationForCitationPaymentType]
type=branch
var=TR_CasesCount
CompareType=Integer
TR_CaseIndex=CheckCitationCountBeforePlayingLastCitation
Next=CitationAddReturnMenu

[CheckCitationForPlanPaymentType]
type=branch
var=TR_CasesCount
CompareType=Integer
TR_CaseIndex=CheckFirstCitationAddedToCartBeforePlayingLastPlan
Next=PlanAddReturnMenu

[CheckCitationCountBeforePlayingLastCitation]
type=branch
var=TR_CasesCount
1=CitationAddReturnMenu

[PlayLastCitation]
type=play
msg="LastCitation"

[AckMenu]
type=Menu
msg="HearTotalAgain1"
msg="CompleteYourPayment2"
msg="RepeatChoicesStar"
Onkey1=CheckItemsCountForTotalInCart
OnKey2=GetAuthorization
OnKeyStar=AckMenu
MaxBadKeys=2
OnMaxBadKeys=Sorry
MaxTimeouts=2
OnMaxTimeouts=Sorry


[CheckFirstCitationAddedToCartBeforePlayingLastPlan]
type=branch
var=FirstCitationAddedToCart
0=PlanAddReturnMenu

[CheckPaymentPlanCountBeforePlayingLastPlan]
type=branch
var=TR_PaymentPlansCount
1=GetAuthorization

[PlayLastPlan]
type=play
msg="LastPlan"
Next=GetAuthorization



[CitationAddReturnMenu]     ! p. 39
type=Branch
var=TR_PaymentPlansCount
TR_PaymentPlanIndex=CheckCitationCountForCitationAddReturnMenuOptionTwo
OnBelowRange=SetCitationAddReturnMenuOptionTwoToFalse
OnAboveRange=CheckCitationCountForCitationAddReturnMenuOptionTwo

[CheckCitationCountForCitationAddReturnMenuOptionTwo]
type=branch
var=TR_CaseIndex
TR_CasesCount=SetCitationAddReturnMenuOptionTwoToFalse
OnBelowRange=CheckPlanCountForCitationAddReturnMenuOptionThree
OnAboveRange=SetCitationAddReturnMenuOptionTwoToFalse

[SetCitationAddReturnMenuOptionTwoToFalse]
Type=ChangeVariable
@PlayOption2=0


[CheckPlanCountForCitationAddReturnMenuOptionThree]
type=Branch
var=TR_PaymentPlansCount
1=CheckPlansDoneForCitationAddReturnMenuOptionsThree
Next=SetCitationAddReturnMenuOptionThreeToFalse

[CheckPlansDoneForCitationAddReturnMenuOptionsThree]
type=Branch
var=TR_PaymentPlansCount
TR_PaymentPlanIndex=CheckPlanCountForCitationAddReturnMenuOptionFour
OnBelowRange=SetCitationAddReturnMenuOptionThreeToFalse
OnAboveRange=CheckPlanCountForCitationAddReturnMenuOptionFour

[SetCitationAddReturnMenuOptionThreeToFalse]
Type=ChangeVariable
@PlayOption3=0


[CheckPlanCountForCitationAddReturnMenuOptionFour]
type=Branch
var=TR_PaymentPlansCount
1=SetCitationAddReturnMenuOptionFourToFalse
OnBelowRange=SetCitationAddReturnMenuOptionFourToFalse
OnAboveRange=CheckPlansDoneForCitationAddReturnMenuOptionFour

[CheckPlansDoneForCitationAddReturnMenuOptionFour]
type=Branch
var=TR_PaymentPlansCount
TR_PaymentPlanIndex=SetCitationAddReturnMenuOptionFourToFalse
OnBelowRange=PlayCitationAddReturnMenu
OnAboveRange=SetCitationAddReturnMenuOptionFourToFalse

[SetCitationAddReturnMenuOptionFourToFalse]
Type=ChangeVariable
@PlayOption4=0
Next=PlayCitationAddReturnMenu



[PlayCitationAddReturnMenu]
type=Recognize
PromptMsg="HearTotalAgain","NextCitation"|X|2,"ForPaymentPlan"|X|3,"ForMultiplePlans"|X|4,"CompleteYourPayment","RepeatChoices"
PromptMsgDTMF="HearTotalAgain1","NextCitationPress2"|X|2,"ForPaymentPlan3"|X|3,"ForMultiplePlans4"|X|4,"CompleteYourPayment5","RepeatChoicesStar"
!Grammar="AddReturnMenu"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Again=CheckItemsCountForTotalInCart
OnResult:Citation=GetNextCitation
OnResult:Authorization=GetAuthorization
OnResult:Plan=PlanSummary
OnResult:All=PreSummaryLogic
OnResult:Main=MainMenu
OnKey1=CheckItemsCountForTotalInCart
OnKey2=GetNextCitation
OnKey3=GetNextPlan
OnKey4=GetNextPlan
OnKey5=GetAuthorization
OnKeyStar=CitationAddReturnMenu
OnDTMFError=Sorry
BadKeyMsg="InvalidSelectionDTMF"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="OK"
FlushKeys=True


[PlanAddReturnMenu]     ! p. 40
type=Branch
var=TR_PaymentPlanIndex
TR_PaymentPlansCount=SetPlanAddReturnMenuOptionTwoToFalse
OnBelowRange=SetPlanAddReturnMenuOptionThreeToFalse
OnAboveRange=SetPlanAddReturnMenuOptionTwoToFalse

[SetPlanAddReturnMenuOptionTwoToFalse]
Type=ChangeVariable
@PlayOption2=0

[CheckCitationCountForPlanAddReturnMenuOption3]
type=branch
var=TR_CasesPayableCount
0=SetPlanAddReturnMenuOptionThreeToFalse
1=CheckFirstCitationAddedToCartForPlanAddReturnMenu
Next=PlayPlanAddReturnMenu

[CheckFirstCitationAddedToCartForPlanAddReturnMenu]
type=branch
var=FirstCitationAddedToCart
0=PlayPlanAddReturnMenu

[SetPlanAddReturnMenuOptionThreeToFalse]
Type=ChangeVariable
@PlayOption3=0

[PlayPlanAddReturnMenu]
Type=Recognize
PromptMsg="HearTotalAgain","NextPlan"|X|2,"ForOpenCitations"|X|3,"CompleteYourPayment","RepeatChoices"
PromptMsgDTMF="HearTotalAgain1","NextPlan2"|X|2,"ForOpenCitations3"|X|3,"CompleteYourPayment4","RepeatChoicesStar"
!Grammar="AddReturnMenu"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Again=CheckItemsCountForTotalInCart
OnResult:Plan=PlanSummary
OnResult:Citation=GetNextCitation
OnResult:Authorization=GetAuthorization
OnResult:All=PreSummaryLogic
OnResult:Main=MainMenu
Onkey1=CheckItemsCountForTotalInCart
Onkey2=GetNextPlan
Onkey3=BailCitationSummary
OnKey4=GetAuthorization
OnkeyStar=PlanAddReturnMenu
Onkeypound=PlanAddReturnMenu
BadKeyMsg="InvalidSelectionDTMF"
OnDTMFError=Sorry
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="OK"
FlushKeys=True




[EPSError]     ! p. 63
type=Play
FlushPlayQueue=True

[LogEPSErrorResultCodes]
type=log
var=TR_ResultCode

[PlayEPSError]
type=play
msg="SystemProblem2"

[EPSErrorMenu]
type=Menu
msg="EPSErrorMenu"
OnKey0=SetOperatorMsgForEPSError
TimeOutSec=5   
MaxTimeouts=0
OnMaxTimeouts=Exit
MaxBadKeys=2
OnMaxBadKeys=Exit

[SetOperatorMsgForEPSError]
type=ChangeVariable
ScreenMsg="Error during payment"

[ResetAllCCTransactionVarsForEPSError]
type=ChangeVariable
CartCount=0
TR_ItemsCount=""
TR_ItemTotalAmount=""
TR_TotalAmount=""
Next=ACDAvailable



[GetAuthorization]     ! p. 42
type=play
msg="GuiltyPleaNotice"                     !while waiting for authorization
WaitForMsg=True


[ExecuteGroupCart]   !only called once per payment
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GroupCart"
OnExecuteError=EPSError
Next=LogGroupCartResults

[LogGroupCartResults]
type=log
var=TR_GroupCartsCount,TR_GroupCartsPaidCount,TR_GroupCartsTotalAmount

[LogGroupCartResults2]
type=log
var=TR_CurrentGroupCartIndex,TR_CurrentGroupCartIsPaid,TR_CurrentGroupCartItemsCount

[LogGroupCartResults3]
type=log
var=TR_CurrentGroupCartFeeAmount,TR_CurrentGroupCartItemAmount,TR_CurrentGroupCartTotalAmount

[CheckResultCodeForGroupCart]
type=Branch
var=TR_ResultCode
0=SetCardRetryCounter
Next=EPSError


[SetCardRetryCounter]
type=ChangeVariable
CardRetryCounter=0
NewCardFlag=0         !prevent flag carry-over from previous payment

[PlayConnectToProcessor]
type=play
msg="ConnectToProcessor"  

[CardMusicPlay]
type=play
msg="Music21"
msg="Music22"
msg="Music23"
msg="Music24"
msg="Music25"
msg="Music26"
IgnoreMissingMsg=True

[PreCreateTokenSessionLog]
type=log
var=TR_CallerLanguage,TR_Processor

[ExecuteCreateTokenSession]
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="CreateTokenSession"
OnExecuteError=SetTokenCreateRetry
Next=LogCreateTokenSessionResults

[SetTokenCreateRetry]
type=changevariable
Increment=TokenRetryCounter

[checktokenretries]
type=branch
var=TokenRetryCounter
3=PreCreateTokenSessionLog
OnBelowRange=PreCreateTokenSessionLog
Next=EPSError


[LogCreateTokenSessionResults]
type=log
var=TR_ErrorMessage,TR_ResultCode,TR_TransferId,TR_ProcessorSessionIdentifier

[SetEPSstatusVar]
type=ChangeVariable
EPSstatus=TR_ResultCode

[SaveEPSstatusVarInVM]
type=VariableManager
Application="CPC"
SaveVarList="EPSstatus"
OnError=LogVMErrorForSaveEPSstatusVarInVM
Next=CheckResultCodeForCreateTokenSession

[LogVMErrorForSaveEPSstatusVarInVM]
type=log
logmsg="VariableManager Save Error"

[CheckResultCodeForCreateTokenSession]
type=Branch
var=TR_ResultCode
0=RedirectToHPSMN
Next=EPSError

[RedirectToHPSMN]
type=CallControl
Command=Hold
PartyName="Inbound"
ResultVar="HoldResult"
OnError=LogCallControlHoldError
Next=LogHPSPhoneNumber

[LogCallControlHoldError]
type=Log
var=HoldResult

[HoldRetry]
type=changevariable
increment=HoldRetry

[CheckHoldRetry]
type=branch
var=HoldRetry
3=PauseBeforeHoldRetry
OnBelowRange=PauseBeforeHoldRetry
Next=EPSError

[PauseBeforeHoldRetry]
type=pause
pausesec=2
Next=RedirectToHPSMN

[LogHPSPhoneNumber]
type=Log
var=HPS_PhoneNumber,TR_CallerLanguage,Processor,CallbackOrigNumber

[CallHPS]
type=Call
DestinationNumber=HPS_PhoneNumber
OriginationNumber=CallbackOrigNumber
! Use Destination Number in Production
!DestinationUri=HPS_PhoneNumber
PartyName="HPS"
CallResultVar="CallResult"
OnCallError=LogCallHPSError
Next=PickupToneFromHPS

[LogCallHPSError]
type=Log
var=CallResult
Next=EPSError

[PickupToneFromHPS]
Type=menu
OnKeyStar=ToneReceivedFromHPS
OnKey1=PickupToneFromHPS
OnKey2=PickupToneFromHPS
OnKey3=PickupToneFromHPS
OnKey4=PickupToneFromHPS
OnKey5=PickupToneFromHPS
OnKey6=PickupToneFromHPS
OnKey7=PickupToneFromHPS
OnKey8=PickupToneFromHPS
OnKey9=PickupToneFromHPS
OnKey0=PickupToneFromHPS
OnKeyPound=PickupToneFromHPS
MaxTimeouts=0
TimeoutSec=5
OnMaxTimeouts=LogSendToneAnyway
FlushKeys=True
!OnMaxTimeouts=EPSErrorOffHold

[LogSendToneAnyway]
type=log
logmsg="No HPS Tone"
!Next=PauseBeforeSendingHPSTransferId

! test change for first time failure 5.2.21 RR
[NoToneDisconnect]
type=callcontrol
PartyName="HPS"
command=disconnect
OnError=LogCallControlHoldError

[NTTakeCallOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=LogCallControlHoldError
Next=RedirectToHPSMN



[LogFirstToneFromHPS]
type=log
logmsg="FirstTone from HPS = "%TempVar

[CheckForToneFromHPS]
type=branch
var=TempVar
"*"=ToneReceivedFromHPS
Next=EPSError

[ToneReceivedFromHPS]
type=log
logmsg="Tone Received From HPS"

[PauseBeforeSendingHPSTransferId]
type=Pause
PauseMSec=200

[SetForHPSDial]   !may be temporary; dial block not handling expressions
type=changevariable
TR_TransferId=TR_TransferId%"#"

[CheckUseInBand]
Type=Branch
var=UseInBandDTMFForHPS
1=SendTransferIdHPSInBandTrue
Next=SendTransferIdHPSInBandFalse

[SendTransferIdHPSInBandTrue]
type=dial
UseInBandDTMF=True
dialstring=TR_TransferId
PartyName="HPS"
Next=PickupSecondToneFromHPS

[SendTransferIdHPSInBandFalse]
type=dial
UseInBandDTMF=False
dialstring=TR_TransferId
PartyName="HPS"
Next=PickupSecondToneFromHPS

[PickupSecondToneFromHPS]
type=GetDigits
Var=TempVar
MinDigits=1
MaxDigits=1
Terminator=""
MaxTimeouts=0
TimeoutSec=10
OnMaxTimeouts=EPSError

[LogSecondToneFromHPS]
type=log
logmsg="SecondTone from HPS = "%TempVar

[CheckForSecondToneFromHPS]
type=branch
var=TempVar
"#"=PauseBeforePutSecondCallOnHold
"*"=PauseBeforeReSendingHPSTransferId   !BadTransferIDRetry; can't use loop to PauseBeforeSendingHPSTransferId, duplicates #
Next=EPSError

[PauseBeforeReSendingHPSTransferId]
type=Pause
PauseMSec=200
Next=CheckUseInBand

[BadTransferIDRetry]
type=branch
var=IDRetryCounter
0=ResendTransferID
Next=PauseBeforePutSecondCallOnHold

[ResendTransferID]
type=changevariable
increment=IDRetryCounter
Next=CheckUseInBand

[PauseBeforePutSecondCallOnHold]
type=Pause
PauseMSec=500

[ResetOHVar]
type=changevariable
HoldRetry=0

[TakeCallOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=RetryOffHold
!LogCallControlHoldError
Next=StopOnHoldPlay

[RetryOffHold]
type=branch
var=HoldRetry
4=RetryTakeCallOffHold
OnBelowRange=RetryTakeCallOffHold
Next=LogCallControlOffHoldError

[RetryTakeCallOffHold]
type=changevariable
increment=HoldRetry

[PauseBeforeOffHold]
type=Pause
PauseSec=2
Next=TakeCallOffHold

[LogCallControlOffHoldError]
type=log
Logmsg="Error going off hold - try anyway"

[StopOnHoldPlay]
type=play
flushplayqueue=true

[BridgeCalls]
type=CallControl
Command=Bridge
OnKeyA=WelcomeBack					!A = success at HPS
OnKeyC=WelcomeBackOnCancel          !C = cancelled at HPS
OnKeyD=LogProcessorErrorMessage     !D = failed at HPS
OnError=LogCallControlBridgeError
Next=HangupCall
!Next=SetHPSLoopCounter

[WelcomeBackOnCancel]
type=log
var=TR_ItemsCount

[ClearCartOnCancel]         !prevents duplicates if loop back for second payment
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="ClearCart"
OnExecuteError=LogExecuteClearCartErrorOnCancel
Next=CheckExecuteClearCartResultOnCancel

[LogExecuteClearCartErrorOnCancel]
type=log
var=TR_ItemsCount,TR_ResultCode

[LogExecuteClearCartErrorMsgOnCancel]
type=log
var=TR_ErrorMessage
Next=SystemProblem

[CheckExecuteClearCartResultOnCancel]
type=branch
var=TR_ResultCode
0=PlayWelcomeBackOnCancel
Next=SystemProblem

[PlayWelcomeBackOnCancel]
type=play
msg="WelcomeBack"
Next=WelcomeBackMenu


[LogProcessorErrorMessage]
type=log
var=TR_ProcessorErrorMessage

[WelcomeBackOnFailure]
type=log
var=TR_ItemsCount

[ClearCartOnFailure]
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="ClearCart"
OnExecuteError=LogExecuteClearCartErrorOnFailure
Next=CheckExecuteClearCartResultOnFailure

[LogExecuteClearCartErrorOnFailure]
type=log
var=TR_ItemsCount,TR_ResultCode

[LogExecuteClearCartErrorMsgOnFailure]
type=log
var=TR_ErrorMessage
Next=SystemProblem

[CheckExecuteClearCartResultOnFailure]
type=branch
var=TR_ResultCode
0=PlayWelcomeBackOnFailure
Next=SystemProblem

[PlayWelcomeBackOnFailure]
type=play
msg="WelcomeBack"
msg="SorryBut"
Next=WelcomeBackMenu


[SetHPSLoopCounter]
type=changevariable
LoopCounter=0

[WaitDuringBridge]
type=Pause
PauseSec=60

[IncrementHPSLoop]
type=changevariable
Increment=LoopCounter

[CheckHPSLoop]
type=branch
var=loopcounter
20=HangupCall
Next=WaitDuringBridge


[LogCallControlBridgeError]
type=Log
Logmsg="CallControlBridgeError"
Next=EPSError

[EPSErrorOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=LogCallControlHoldError
Next=CheckEPSRetries

[CheckEPSRetries]
type=branch
var=EPSRetryCounter
1=EPSError
Next=IncrementEPSRetry

[IncrementEPSRetry]
type=changevariable
Increment=EPSRetryCounter
Next=PlayMusicForHPSTransfer

[PlayMusicForHPSTransfer]
type=play
msg="Music21"
Next=RedirectToHPSMN


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! !RETURN FROM HPS       p. 43

[WelcomeBack]
type=Play
msg="WelcomeBack"
WaitForMsg=True
Next=LogInputsForGetToken

[LogInputsForGetToken]
type=log
var=TR_ProcessorSessionIdentifier,TR_Processor

[ExecuteGetToken]
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetToken"
OnExecuteError=EPSError
Next=LogGetTokenResults

[LogGetTokenResults]
type=log
var=TR_ErrorMessage,TR_ResultCode,TR_TokenIdentifier

[CheckResultCodeForGetToken]
type=Branch
var=TR_ResultCode
0=CheckNewCardFlag
Next=WelcomeBackMenuSystemError

[CheckNewCardFlag]
type=branch
var=NewCardFlag
1=ProcessNextTransaction
Next=CheckGroupCartsCount

[CheckGroupCartsCount]
type=Branch
var=TR_GroupCartsCount
1=PlayYourTransaction
Next=CheckGroupCartTransactionIndex

[CheckGroupCartTransactionIndex]
type=branch
var=TR_CurrentGroupCartIndex
1=PlayYourFirstTransaction

[CheckGroupCartTransactionIndexVersusCount]
type=branch
Var=TR_CurrentGroupCartIndex
TR_GroupCartsCount=PlayYourFinalTransaction
Next=PlayYourNextTransaction

[PlayYourTransaction]
type=Play
msg="PleaseWait"
msg="Your"
msg="Transaction"
WaitForMsg=True
Next=MusicForMakeTokenPayment

[PlayYourFirstTransaction]
type=Play
msg="PleaseWait"
msg="YourFirst"
msg="Transaction"
WaitForMsg=True
Next=MusicForMakeTokenPayment

[PlayYourNextTransaction]
type=Play
msg="PleaseWait"
msg="YourNext"
msg="Transaction"
WaitForMsg=True
Next=MusicForMakeTokenPayment

[PlayYourFinalTransaction]
type=Play
msg="PleaseWait"
msg="YourFinal"
msg="Transaction"
WaitForMsg=True
Next=MusicForMakeTokenPayment


[MusicForMakeTokenPayment]
type=Play
msg="Music21"

[ExecuteMakeTokenPayment]
type=ExecuteRoutine
Dll="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="MakeTokenPayment"
OnExecuteError=EPSError
Next=StopMusicAfterMakeTokenPayment

[StopMusicAfterMakeTokenPayment]
type=Play
FlushPlayQueue=True

[LogMakeTokenPaymentResults]
type=log
var=TR_GroupCartsCount,TR_GroupCartsPaidCount,TR_GroupCartsTotalAmount

[LogMakeTokenPaymentResults2]
type=log
var=TR_IsTokenPaymentSuccessful,TR_ProcessorErrorCode,TR_ProcessorTransactionId

[CheckResultCodeForMakeTokenPayment]
type=Branch
var=TR_ResultCode
0=CheckIsTokenPaymentSuccessfulForMakeTokenPayment
Next=WelcomeBackMenuSystemError

[CheckIsTokenPaymentSuccessfulForMakeTokenPayment]
type=Branch
var=TR_IsTokenPaymentSuccessful
1=TransactionAuthorized                    !PlayYourForTransactionAuthorized
Next=TransactionNotApproved


[WelcomeBackMenuSystemError]
type=Play
msg="SystemProblem2"

[WelcomeBackMenu] 
type=menu
msg="WelcomeBackMenu"
FlushKeys=TRUE
OnKey1=MainMenu
OnKey2=SetScreenMsgForWelcomeBackMenu
OnKey3=Exit
OnKeyStar=WelcomeBackMenu

[SetScreenMsgForWelcomeBackMenu]
type=changevariable
ScreenMsg="Reqd staff WelcomeBackMenu"
Next=TransferNoNode


[TransactionAuthorized]     !p. 45
type=ChangeVariable
TotalAmount=TR_CurrentGroupCartTotalAmount+ConvenienceFee

[SaveTotalAmountForReplay]  !ClearCart removes CurrentGroupCartTotalAmount, so need to retain for replay
type=ChangeVariable
TempVar=TotalAmount

[LogTotalAmountForTransactionAuthorized]
type=log
var=TotalAmount

[CheckGroupCartsCountForTransactionAuthorized]
type=branch
var=TR_GroupCartsCount
0=PlayYourForTransactionAuthorized  !For replay of transacted amount; if ClearCart called will be zero
1=PlayYourForTransactionAuthorized

[CheckTransactionIndex]
type=branch
var=TR_CurrentGroupCartIndex
1=PlayYourFirstForTransactionAuthorized

[CheckTransactionIndexVersusCount]
type=branch
Var=TR_CurrentGroupCartIndex
TR_GroupCartsCount=PlayYourFinalForTransactionAuthorized
Next=PlayYourNextForTransactionAuthorized

[PlayYourForTransactionAuthorized]
type=play
msg="Your"
Next=PlayTransactionApproved

[PlayYourFirstForTransactionAuthorized]
type=play
msg="YourFirst"
Next=PlayTransactionApproved

[PlayYourNextForTransactionAuthorized]
type=play
msg="YourNext"
Next=PlayTransactionApproved

[PlayYourFinalForTransactionAuthorized]
type=play
msg="YourFinal"

[PlayTransactionApproved]
type=play
msg="TransactionApproved"
msgstring=TotalAmount%"|M"
msg="TransactionApproved2"
msgstring=TR_ProcessorTransactionId%"|C"
msg="TransactionNumber"
msgstring=TR_ProcessorTransactionId%"|C"
WaitForMsg=True
Next=CheckSuspensionForTransactionApproved

[CheckSuspensionForTransactionApproved]
type=branch
var=TR_CurrentGroupCartLicenseSuspendedCount
""=ContinueAuthorized
0=ContinueAuthorized
Next=PlaySuspensionEndInfo

[PlaySuspensionEndInfo]
type=play
msg="SuspensionEndInfo"
Next=ContinueAuthorized


[ContinueAuthorized]     ! p. 46
Type=ChangeVariable
!@PlayOption2=0           ! removes ability to go back to HPS to enter a new card; prevents duplicate processing 1-7-2020
@PlayOption5=0

[CheckAskSurveyContinueAuthorized]
Type=Branch
Var=AskSurvey         !VM variable, if =0 Survey turned off
0=ContinueAuthorized2

[CheckDoSurveyContinueAuthorized]
Type=Branch
Var=DoSurvey
""=SetContinueAuthorizedPlayOption5  !DoSurvey set to 0 or 1 if caller has been already asked to do the survey
Next=ContinueAuthorized2

[SetContinueAuthorizedPlayOption5]
Type=ChangeVariable
@PlayOption5=1

[ContinueAuthorized2]
type=branch
Var=TR_CurrentGroupCartIndex
TR_GroupCartsCount=SetCCApprovedMenuOptions1And2ToFalse
Next=SetContinueAuthorizedOption3ToFalse

[SetCCApprovedMenuOptions1And2ToFalse]
Type=ChangeVariable
@PlayOption1=0
@PlayOption2=0


[ClearCartPrelog]
type=log
