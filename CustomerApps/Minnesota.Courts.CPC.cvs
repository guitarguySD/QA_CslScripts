PromptMsgDTMF="SurveyQuery0DTMF"
!Grammar="YesNoRepeat"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Yes=SetDoSurveyACD
OnResult:No=ClearDoSurveyACD
OnKey1=SetDoSurveyACD
OnKey2=ClearDoSurveyACD
OnDTMFError=Sorry
BadKeyMsg="InvalidSelectionDTMF"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="OK"

[SetDoSurveyACD]
type=ChangeVariable
DoSurvey=1
SpokeToAgent=1

[AgentAgreed]
Type=Log
LogMsg="Survey-AgentAgreed"
LogType=ScriptEvent

[PlaySurveyInstruction]
Type=Play
Msg="SurveyInstruction"
Next=LogRouteName

[ClearDoSurveyACD]
Type=ChangeVariable
DoSurvey=0

[AgentDeclined]
Type=Log
LogMsg="Survey-AgentDeclined"
LogType=ScriptEvent
Next=LogRouteName

[LogRouteName]
type=log
var=ACD_RouteName
Next=ACDCall


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!NEW ACD SECTION


!============================================
! ACD Call
!============================================

[ACDCall]
type=VariableManager
Application="CPC"
VarList="AssistanceAvailable,CallbackEstimatedHoldTime"
OnError=LogACDAvailableVMFailure
Next=CheckAssistanceAvailableForOperator

[CheckAssistanceAvailableForOperator]
Type=Branch
Var=AssistanceAvailable
0=NoOperator
1=PleaseHold
Next=LogACDAvailableVMFailure

[NoOperator]     ! p. 56
type=Play
msg="NoOperatorAvailable"
msg="AssistanceHours"
msgstring=OpeningTime%"|D|h:n a/p"
msg="To"
msgstring=ClosingTime%"|D|h:n a/p"
msg="MondayThruFriday"

[CheckDoSurveyNoOperator]
Type=ChangeVariable
@playOption3=0

[CheckAskSurveyNoOperator]
Type=Branch
Var=AskSurvey         !VM variable, if =0 Survey turned off
0=NoOperatorMenu

[CheckDoSurvey1]
Type=Branch
Var=DoSurvey        ! ="" if caller not asked yet
""=SetNoOperatorPlayOption3
Next=NoOperatorMenu

[SetNoOperatorPlayOption3]
Type=ChangeVariable
@PlayOption3=1

[NoOperatorMenu]
Type=Menu
Msg="NoOperatorMenu1DTMF"
msg="SurveyQuery3DTMF"
msg="NoOperatorMenu2DTMF"
OnKey1=MainMenu
OnKey2=GeneralInformation
OnKey3=SetNoOperatorDoSurvey
OnKeyStar=CheckDoSurveyNoOperator
OnKeyPound=NoOperator
MaxTimeouts=0
OnMaxTimeouts=Exit

[SetNoOperatorDoSurvey]
Type=ChangeVariable
DoSurvey=1

[NoOperatorScriptEvent]
Type=Log
LogMsg="Survey-NoOperator"
LogType=ScriptEvent

[ChoseSurveyNoOperator]
Type=Log
LogMsg="Survey-ChoseSurvey"
LogType=ScriptEvent
Next=DoSurvey

[LogACDAvailableVMFailure]
type=log
logmsg="ACD Var Man Failure"

[PleaseHold]
type=play
msg="PleaseHold"
WaitForMsg=True

[LogCTIVars]
type=log
var=TR_CallerLanguage,TR_CitationNumber,TR_CaseNumber,TR_DefendantLastName,TR_CaseCountyName,@OriginationAddress,ScreenMsg

[RouteToACD]
type=log
logmsg="Route to ACD"
LogType=ScriptEvent

[CheckForUrgentPriority]
type=Branch
var=UrgentPriority
1=RouteCallerWithUrgentPriority
Next=RouteCaller

[RouteCallerWithUrgentPriority]
type=ACD
Command=RouteCall
OriginationNumber=6512813219
RouteName=ACD_RouteName
Priority="Urgent"
OnError=CallReturnFromAcd                   !AcdRouteError
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnTimeout=RouteTimeout

[LogUrgentPriorityCallToQueue]   !needed because ACD block drops out when call goes into queue
type=log
LogMsg="UrgentPriorityCallToQueue"
Next=ACDWait1


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller.  Note that this block never
!  falls through and executes the Next block.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[RouteCaller]
type=ACD
Command=RouteCall
OriginationNumber=6512813219
RouteName=ACD_RouteName
OnError=CallReturnFromAcd                   !AcdRouteError
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnTimeout=RouteTimeout

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call Enters Queue
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[ACDWait1]
!Needed to know if going into queue or not
type=pause
pausesec=1

[LogACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[LogOriginationAddress]
type=log
var=@OriginationAddress

[CheckCaller]
type=ACD
Command=CheckCallStatus
OnError=AcdRouteError
OnTimeout=RouteTimeout

[LogCheckACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[CheckForBadPositionInQueueValue]
type=Branch
var=@AcdPositionInQueue
"-1"=BadPositionInQueueValue
Next=CheckEstHoldTimeMin

[BadPositionInQueueValue]
type=log
Logmsg="Queue position error"

[StopPlayOnBadPositionInQueueValue]
type=Play
FlushPlayQueue=True

[SystemProblemForBadPositionInQueueValue]
type=play
msg="SystemProblem"
msg="ThankYou"
msg="Goodbye"
WaitForMsg=True
Next=EndOfScript

[CheckEstHoldTimeMin]
type=Branch
var=@AcdEstHoldTimeMin
1=PlayQueuePositionOneMinute
OnBelowRange=ForcePlayQueuePositionOneMinute
Next=PlayQueuePosition

[PlayQueuePositionOneMinute]
type=play
msg="YourCurrent"
msgstring=@AcdEstHoldTimeMin%"|N"
msg="Minute"
Next=CheckCallTypeForCallbackCall

[ForcePlayQueuePositionOneMinute]
type=play
msg="YourCurrent"
msgstring="1"%"|N"
msg="Minute"
Next=CheckCallTypeForCallbackCall

[PlayQueuePosition]
type=play
msg="YourCurrent"
msgstring=@AcdEstHoldTimeMin%"|N"
msg="Minutes"

[CheckCallTypeForCallbackCall]
type=Branch
var=CallbackCall
1=ACDInQueue
Next=DontOfferCallbacksToUrgentCalls

[DontOfferCallbacksToUrgentCalls]	!added 20260120RR
type=Branch
var=UrgentPriority
1=ACDInQueue
Next=CheckLocationForCallbackEligibility

[CheckLocationForCallbackEligibility]
type=ChangeVariable
CheckTelNumber=@OriginationAddress

[CheckEnteredTelephoneNumberForCallbackEligibility]
type=Utility
Command=CheckTelephoneNumber
Parameter="CheckTelNumber"

[LogCheckLocationForCallbackEligibility]
type=Log
Var=CheckTelNumber,@Result,@InCallLocationType,@InCallLocationAreaCode,@InCallLocationDesc,@InCallLocationTZOffset

[CheckTelephoneNumberLocationBranch]
type=Branch
var=@InCallLocationType              	!only serve US
0=ACDInQueue  !4-digit extension
1=GetCallbackAvailable 	!US mainland
2=GetCallbackAvailable 	!Alaska/HW
Next=ACDInQueue

[GetCallbackAvailable]
type=VariableManager
Application="CPC"
VarList="CallbackAvailable"
OnError=LogVMErrorForGetCallbackAvailable
Next=CheckCallbackAvailable

[LogVMErrorForGetCallbackAvailable]
type=log
logmsg="VMErrorCallbackAvail"
Next=ACDInQueue

[CheckCallbackAvailable]
type=branch
var=CallbackAvailable
1=CheckEligibleForCallback
Next=ACDInQueue

[CheckEligibleForCallback]
type=Acd
command=GetCallbackInfo
FifoEnabledVar=CallbackFifoEnabled
FifoEstimatedTimeVar=CallbackFifoEstimatedTime
ScheduledEnabledVar=CallbackScheduledEnabled
ScheduledFirstTimeVar=CallbackScheduledFirstTime
ScheduledLastTimeVar=CallbackScheduledLastTime
OnError=LogCallbackInfoError
Next=LogCallbackInfo

[LogCallbackInfoError]
type=Log
Logmsg="Callback Info Error"
Next=ACDInQueue

[LogCallbackInfo]
type=Log
Var=CallbackFifoEnabled,CallbackFifoEstimatedTime,CallbackScheduledEnabled,CallbackScheduledFirstTime,CallbackScheduledLastTime,@AcdEstHoldTimeMin

[CheckFifoCallbackEnabled]
type=Branch
var=CallbackFifoEnabled
1=CheckFifoDisabledBeforeOfferingFifo    !CheckOfferCallback
Next=CheckScheduledCallbackEnabled

[CheckFifoDisabledBeforeOfferingFifo]  !to prevent FIFO when set to Scheduled only
Type=branch
var=CallbackFifoDisabled
1=CheckScheduledCallbackEnabled
Next=CheckOfferCallback

!as of 10-1-19 ScheduledCallbacks are not considering min. q-time which causes problems in script downstream (retested and var is not returned if just scheduled is set so only works with fifo. If scheduled are enabled as well as FIFO in ACD then both will be offered.
[CheckScheduledCallbackEnabled] 
type=Branch
var=CallbackScheduledEnabled
1=CheckOfferCallback
Next=ACDInQueue

[CheckOfferCallback]
type=branch
CompareType=Float
var=@AcdEstHoldTimeMin
CallbackEstimatedHoldTime=OfferCallback
OnAboveRange=OfferCallback
Next=ACDInQueue

[ACDInQueue]
type=Branch
var=QueueCounter
0=FirstQueuePlay
1=SecondQueuePlay
2=ThirdQueuePlay
3=FourthQueuePlay
4=FifthQueuePlay
5=SixthQueuePlay
Next=ResetQueueCounter

[ResetQueueCounter]
type=ChangeVariable
QueueCounter=0

[FirstQueuePlay]
type=Play
msg="MusicOnHold1"
msg="FeesAndSurcharges"
WaitForMsg=TRUE
Next=IncrementQueueCounter

[SecondQueuePlay]
type=Play
msg="MusicOnHold2"
msg="PendingPayment"
WaitForMsg=TRUE
Next=IncrementQueueCounter

[ThirdQueuePlay]
type=Play
msg="MusicOnHold3"
msg="MandatoryAppearance"
WaitForMsg=TRUE
Next=IncrementQueueCounter

[FourthQueuePlay]
type=Play
msg="MusicOnHold4"
msg="ToContest"
WaitForMsg=TRUE
Next=IncrementQueueCounter

[FifthQueuePlay]
type=Play
msg="MusicOnHold5"
msg="ProofOfInsurance"
WaitForMsg=TRUE
Next=IncrementQueueCounter

[SixthQueuePlay]
type=Play
msg="MusicOnHold6"
msg="DLSuspension"
WaitForMsg=TRUE

[IncrementQueueCounter]
type=ChangeVariable
Increment=QueueCounter

[CheckforCallbackcaller]
type=Branch
var=CallbackCall
1=ACDInQueue

[RecheckCallbackAvailable]
type=VariableManager
Application="CPC"
VarList="CallbackAvailable"
OnError=LogVMErrorForGetCallbackAvailable

[ReCheckCallbackAvailableBranch]
type=branch
var=CallbackAvailable
1=CheckFifoCallbackEnabled
Next=ACDInQueue
! Changed 2/22/2021 to stop playing ASA every time through

[ACDInQueueAfterRejectedCallback]
type=log
logmsg="Callback reject or errors"
Next=ACDInQueue


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Call is connecting to ACD Agent.  Play ring. 
!     Queue 4 rings (4X6 sec) to limit logging.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnecting]
type=Play
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
WaitForMsg=TRUE
Next=AcdAgentConnecting


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call is connected to ACD Agent
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnected]
type=Pause
PauseSec=60
next=AcdAgentConnected


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call has returned from ACD 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnFromAcd]
type=Branch
var=@AcdRouteCode
1=CallReturnErrorRoute
2=CallReturnDefaultRoute
3=QueueShutdown
4=QueueFull
5=EndCall	
6=CallReturnAgentTransfer	
7=CallReturnReleaseKeyPressed
8=CallReturnConferenceConnected
9=CallReturnAgentAwol
! From 11 on are customer defined routes for route return from acdagent
11=MainMenu
12=SetGeneralFAQ1
13=SetSearchValueForCallerReturnedToIVR  !Court preferred BailCaseSummary to GetAuthorization 1-28-10
20=SetPaymentPlans
53=EndCall          !result from callback menu timeout following a false answer detection
100=RouteToSupervisorVMLog
Next=Endcall

[CallReturnErrorRoute]
type=Log
LogMsg="Error Route"
Next=MainMenu

[CallReturnDefaultRoute]
type=Log
LogMsg="DefaultRoute"
Next=MainMenu

[QueueShutdown]
type=Play
msg="QueueShutdown"

[QueueShutdownScriptEvent]
type=log
logmsg="Queue Shutdown"
LogType=ScriptEvent
Next=MainMenu

[QueueFull]
type=log
logmsg="QueueFull"
LogType=ScriptEvent
Next=PlayQueueFull

[CallReturnAgentTransfer]
type=log
logmsg=ACD_AgentName
LogType=ScriptEvent

[AgentToSup]
type=log
logmsg="Xfer Attempts"
LogType=ScriptEvent
next=ACDInQueue
	
[CallReturnReleaseKeyPressed]
type=log
logmsg="Release Key Pressed"
Next=EndOfScript


[AgentPressedRelease]
type=Pause
PauseSec=60
Next=AgentPressedRelease

[CallReturnConferenceConnected]
type=Log
LogMsg="ConferenceConnected"
next=Exit

[RouteTimeout]
type=Play
!msg="AcdTimeout"      !msg doesn't exist
msg="SystemProblem"
next=Exit

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Return Routes
!  
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller after AWOL
!  Uses Urgent priority.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnAgentAwol]
type=log
logmsg="AWOL"

[RouteCallerAfterAwol]
type=ACD
Command=RouteCall
OriginationNumber=2139720970
RouteName=ACD_RouteName
Priority="Urgent"
OnError=AcdRouteError
next=ACDInQueue

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Agent Routes
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[AcdRouteError]
type=Play
FlushPlayQueue=True
msg="silence"

[ACDRouteErrorPlay]
type=Play
Msg="QueueShutdown"
WaitForMsg=TRUE
Next=PlayThankYou

[AcdError]
type=Play
FlushPlayQueue=True
msg="SystemProblem"
WaitForMsg=TRUE
Next=Exit

  
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!NEW ACD SECTION - END  
  
  
  


!=================================
! ACD Transfer Routines
!=================================

[SetPaymentPlans]
type=changevariable
ACD_RouteName="PaymentPlanAgent"

[PaymentPlan]
type=log
logmsg="PaymentPlanAgent"
LogType=ScriptEvent
Next=LogRouteName

[SetSearchValueForCallerReturnedToIVR]
type=log
var=TR_CaseNumber

[VerifyValueinCaseNumber]
type=branch
var=TR_CaseNumber
""=CaseProcess									! Go get case number if agent failed to enter one
Next=SetSearchValueForCallerReturnedToIVR2

[SetSearchValueForCallerReturnedToIVR2]
type=ChangeVariable
TR_SearchCaseNumber=TR_CaseNumber
TR_SearchType=1
Next=RetrieveCase


!===================================
! Callback Module Start
!===================================

[OfferCallback]              !Flow p. 58
type=log
LogMsg="CallbackOffered"
LogType=ScriptEvent

[IncrementCallbacksOfferedCounter]
type=ChangeVariable
Increment=CallbacksOfferedCounter

[OfferCallbackMenu]
type=menu
msg="IfYouPrefer"
msgstring=ClosingTime%"|D|h:n a/p"
msg="CentralTime"
msg="RequestCallbackMenu"
OnKey1=RequestCallback
TimeOutSec=3
MaxBadKeys=3
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=0
OnMaxTimeouts=ACDInQueueAfterRejectedCallback

[RequestCallback]
type=log
logmsg="CallbackRequested"
LogType=ScriptEvent

[CheckOriginationNumberForCallback]
type=branch
var=@DestinationAddress
"8006573611"=SetCallbackOrigNumberTo800Number   !production
"6512127921"=SetCallbackOrigNumberTo800Number   !production
"6512378893"=SetCallbackOrigNumberTo800Number   !stage
Next=CheckCallbacksOfferedCounter

[SetCallbackOrigNumberTo800Number]
type=ChangeVariable
CallbackOrigNumber="8006573611"
Next=CheckCallbacksOfferedCounter

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Offered Callback metric for court - start
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[CheckCallbacksOfferedCounter]
type=Branch
var=CallbacksOfferedCounter
1=CallbackAcceptedOnOffer1
2=CallbackAcceptedOnOffer2
3=CallbackAcceptedOnOffer3
4=CallbackAcceptedOnOffer4
5=CallbackAcceptedOnOffer5
6=CallbackAcceptedOnOffer6
7=CallbackAcceptedOnOffer7
8=CallbackAcceptedOnOffer8
9=CallbackAcceptedOnOffer9
Next=CallbackAcceptedOnOffer10

[CallbackAcceptedOnOffer1]
type=log
logmsg="CallbackAcceptedOn1"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer2]
type=log
logmsg="CallbackAcceptedOn2"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer3]
type=log
logmsg="CallbackAcceptedOn3"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer4]
type=log
logmsg="CallbackAcceptedOn4"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer5]
type=log
logmsg="CallbackAcceptedOn5"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer6]
type=log
logmsg="CallbackAcceptedOn6"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer7]
type=log
logmsg="CallbackAcceptedOn7"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer8]
type=log
logmsg="CallbackAcceptedOn8"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer9]
type=log
logmsg="CallbackAcceptedOn9"
LogType=ScriptEvent
Next=CheckOriginationNumber

[CallbackAcceptedOnOffer10]
type=log
logmsg="CallbackAcceptedOn10"
LogType=ScriptEvent
Next=CheckOriginationNumber

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Offered Callback metric for court - end
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[CheckOriginationNumber]
type=Branch
var=@OriginationAddress
""=LogCallbackPartyNumberUnknown
! Numbers below added as they are from Minnesota Auto Attendant. Force callers to enter a real callback number.
"6123339205"=LogCallbackPartyNumberUnknown
"6514356523"=LogCallbackPartyNumberUnknown
"6125969580"=LogCallbackPartyNumberUnknown
! added 1 prefix 12.30.25
"16123339205"=LogCallbackPartyNumberUnknown
"16514356523"=LogCallbackPartyNumberUnknown
"16125969580"=LogCallbackPartyNumberUnknown
Next=SetCallbackNumber

[SetCallbackNumber]
type=ChangeVariable
CallbackNumber=@OriginationAddress
Next=CallbackOptionMenu1

[LogCallbackPartyNumberUnknown]
type=log
logmsg="Callback NumUnknown"
Next=ResetCallbackNumberCounter

[CallbackOptionMenu1]
type=menu
msg="CallbackOptionMenu1"
OnKey1=VerifyCallbackNumber
OnKey2=EnterCallbackNumber
OnKey3=ACDInQueueAfterRejectedCallback
OnKeyStar=CallbackOptionMenu1
TimeOutSec=3
MaxBadKeys=3
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=3
OnMaxTimeouts=ACDInQueueAfterRejectedCallback

[VerifyCallbackNumber]
type=menu
msg="CallingFrom"
msgstring=@OriginationAddress%"|C|"
msg="CallingFromMenu"
OnKey1=RequestCallbackContinued
OnKey2=ResetCallbackNumberCounter
OnKeyStar=VerifyCallbackNumber
TimeOutSec=3
MaxBadKeys=3
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=3
OnMaxTimeouts=ACDInQueueAfterRejectedCallback

[ResetCallbackNumberCounter]
type=ChangeVariable
CallbackNumberCounter=0

[EnterCallbackNumber]
type=GetDigits
msg="PleaseEnter"
var=CallbackNumber
CountVar=NumberOfDigits
MinDigits=0
MaxDigits=15              !enables error handling outside block
TimeoutSec=3
OnKeyStar=ACDInQueueAfterRejectedCallback
OnKeyPound=CheckCallbackNumberLength
Next=CheckCallbackNumberLength

[CheckCallbackNumberLength]
type=Branch
var=NumberOfDigits
0=PlayTooFewDigitsCallbackNumber
1=PlayTooFewDigitsCallbackNumber
2=PlayTooFewDigitsCallbackNumber
3=PlayTooFewDigitsCallbackNumber
4=PlayTooFewDigitsCallbackNumber
5=PlayTooFewDigitsCallbackNumber
6=PlayTooFewDigitsCallbackNumber
7=PlayTooFewDigitsCallbackNumber
8=PlayTooFewDigitsCallbackNumber
9=PlayTooFewDigitsCallbackNumber
10=ConfirmEnteredCallbackNumber
11=PlayTooManyDigitsCallbackNumber
12=PlayTooManyDigitsCallbackNumber
13=PlayTooManyDigitsCallbackNumber
14=PlayTooManyDigitsCallbackNumber
15=PlayTooManyDigitsCallbackNumber
Next=IncrementCallbackNumberCounter

[PlayTooFewDigitsCallbackNumber]
type=Play
msg="TooFewDigits"
Next=IncrementCallbackNumberCounter

[PlayTooManyDigitsCallbackNumber]
type=Play
msg="TooManyDigits"
Next=IncrementCallbackNumberCounter

[IncrementCallbackNumberCounter]
type=ChangeVariable
Increment=CallbackNumberCounter
Next=CheckCallbackNumberCounter

[ConfirmEnteredCallbackNumber]
type=menu
msg="YouEntered"
msgstring=CallbackNumber%"|C|"
msg="EnteredMenu"
OnKey1=SetForCheckTelephoneNumber
OnKey2=CheckCallbackNumberCounter
TimeOutSec=4
MaxBadKeys=1
OnMaxBadKeys=IncrementCallbackNumberCounterForConfirmMenu   
MaxTimeouts=1
OnMaxTimeouts=IncrementCallbackNumberCounterForConfirmMenu

[SetForCheckTelephoneNumber]
type=ChangeVariable
CheckTelNumber=CallbackNumber

[CheckEnteredTelephoneNumber]
type=Utility
Command=CheckTelephoneNumber
Parameter="CheckTelNumber"

[LogUtilityCheckTelephoneNumber]
type=Log
Var=CheckTelNumber,@Result,@InCallLocationType,@InCallLocationAreaCode,@InCallLocationDesc,@InCallLocationTZOffset

[CheckCheckTelephoneNumberLocation]
type=Branch
var=@InCallLocationType              	!only serve US
0=EnteredTelephoneNumberInvalid         !4-digit ext
1=CheckResultOfCheckTelephoneNumber 	!US mainland
2=CheckResultOfCheckTelephoneNumber 	!Alaska/HW
Next=EnteredTelephoneNumberInvalid

[CheckResultOfCheckTelephoneNumber]
type=Branch
var=@Result
0=RequestCallbackContinued
Next=EnteredTelephoneNumberInvalid

[EnteredTelephoneNumberInvalid]
type=Play
msg="TheNumberEntered"
msgstring=CallbackNumber%"|C|"
msg="IsInvalid"

[IncrementCallbackNumberCounterForConfirmMenu]
type=ChangeVariable
Increment=CallbackNumberCounter
Next=CheckCallbackNumberCounter

[CheckCallbackNumberCounter]
type=Branch
var=CallbackNumberCounter
3=ACDInQueueAfterRejectedCallback
OnBelowRange=EnterCallbackNumber
OnAboveRange=ACDInQueueAfterRejectedCallback
Next=EnterCallbackNumber


[RequestCallbackContinued]           !Flow p. 58a
type=Branch
var=CallbackScheduledEnabled
1=CallbackOptionMenu2
Next=CheckOriginationAddressForFIFOCallback

[CheckOriginationAddressForFIFOCallback]
type=Branch
var=CallbackNumber
""=RequestFIFOCallbackToOriginationNumber
Next=RequestFIFOCallbackToEnteredNumber

[RequestFIFOCallbackToOriginationNumber]
type=ACD
command=RequestCallback
CallbackType=FIFO
CallbackNumberVar=CallbackNumber
OriginationNumber=CallbackOrigNumber
OnError=RequestNotGranted
Next=CheckRequestFIFOCallbackResult

[RequestFIFOCallbackToEnteredNumber]
type=ACD
command=RequestCallback
CallbackType=FIFO
CallBackNumberVar=CallbackNumber
OriginationNumber=CallbackOrigNumber
OnError=RequestNotGranted
Next=CheckRequestFIFOCallbackResult

[CheckRequestFIFOCallbackResult]
type=Branch
var=@Result
0=CheckFIFOCallbackCallState
6=CheckFIFOCallbackCallState            !success returned as 6; work around until fixed in CVS; remove for production
Next=RequestNotGranted

[CheckFIFOCallbackCallState]
type=Branch
var=@AcdCallStatus
12=PlayPleasePlanFIFO
Next=RequestNotGranted

[PlayPleasePlanFIFO]
type=Play
msg="PleasePlan"
msgstring=CallbackFIFOEstimatedTime%"|D|h:n a/p"
msg="CentralTime"

[LogCallbackFIFOEstimatedTime]
type=log
var=CallbackFIFOEstimatedTime

[LogFIFOCallbackGranted]
type=log
LogMsg="Callback GrantedFIFO"
Next=Exit

[CallbackOptionMenu2]
Type=branch
var=CallbackFifoDisabled
1=PlayFirstAndLastAvailableTimes
Next=CallbackOptionMenu2WithFifoOption

[CallbackOptionMenu2WithFifoOption]
type=Menu
msg="CallbackOptionMenu2"
OnKey1=CheckOriginationAddressForFIFOCallback
OnKey2=PlayFirstAndLastAvailableTimes
TimeOutSec=4
MaxBadKeys=2
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=2
OnMaxTimeouts=ACDInQueueAfterRejectedCallback

[PlayFirstAndLastAvailableTimes]
type=GetDigits
msg="TheFirstAvailable"
msgstring=CallbackScheduledFirstTime%"|D|h:n a/p"
msg="TheLastAvailable"
msgstring=CallbackScheduledLastTime%"|D|h:n a/p"
msg="EnterTheTime"
var=CallBackTime
CountVar=NumberOfDigits
MinDigits=0
MaxDigits=7                        !enables error handling outside block
TimeoutSec=3
OnKeyStar=PlayFirstAndLastAvailableTimes
OnKeyPound=IncrementCallbackTimeCounter
Next=IncrementCallbackTimeCounter

[IncrementCallbackTimeCounter]
type=ChangeVariable
Increment=CallbackTimeCounter

[CheckCallbackNumberLengthForTime]
type=Branch
var=NumberOfDigits
0=PlayTooFewDigitsCallbackTime
1=ConfirmEnteredCallbackTime
2=ConfirmEnteredCallbackTime
3=ConfirmEnteredCallbackTime
4=ConfirmEnteredCallbackTime
5=PlayTooManyDigitsCallbackTime
6=PlayTooManyDigitsCallbackTime
7=PlayTooManyDigitsCallbackTime
Next=CheckCallbackTimeCounter

[PlayTooFewDigitsCallbackTime]
type=Play
msg="TooFewDigits"
Next=CheckCallbackTimeCounter

[PlayTooManyDigitsCallbackTime]
type=Play
msg="TooManyDigits"
Next=CheckCallbackTimeCounter

[ConfirmEnteredCallbackTime]
type=menu
msg="YouEntered"
msgstring=CallBackTime%"|C|"
msg="EnteredMenu"
OnKey1=ScheduledCallback
OnKey2=CheckCallbackTimeCounter

[CheckCallbackTimeCounter]
type=Branch
var=CallbackTimeCounter
3=ACDInQueueAfterRejectedCallback
Next=PlayFirstAndLastAvailableTimes


[ScheduledCallback]                !Flow p. 58b
type=log
var=CallbackNumber,CallBackTime,CallbackOrigNumber

[ScheduledCallbackRequest]
type=ACD
command=RequestCallback
CallbackType=Scheduled
CallbackNumberVar=CallbackNumber
CallbackTimeVar=CallBackTime
OriginationNumber=CallbackOrigNumber
OnError=LogScheduledCallbackRequestOnError
Next=CheckRequestScheduledCallbackResult

[LogScheduledCallbackRequestOnError]
type=log
logmsg="ScheduledCallbackRequestOnError"

[Logerrorresult]
type=log
var=@Result
!Next=RequestNotGrantedSystemError !commented out 20250305RR   !Successful result returned on failed request 7.31.23  CheckRequestScheduledCallbackResult

[CheckRequestScheduledCallbackResult]
type=Branch
var=@Result
1=PlayPleasePlanScheduled
2=NoLongerAvailableMenu
3=TimeNotValid
4=TimeNotAvailable
5=NoOtherTimeSlotsMenu
Next=RequestNotGranted

[PlayPleasePlanScheduled]
type=Play
msg="PleasePlan"
msgstring=CallBackTime%"|D|h:n a/p"
msg="CentralTime"
Next=Exit

[TimeNotValid]
type=Play
msg="TheNumberEntered"
msgstring=CallBackTime%"|C|"
msg="IsInvalid"
Next=CheckCallbackTimeCounterForTimeInvalid

[CheckCallbackTimeCounterForTimeInvalid]
type=Branch
var=CallbackTimeCounter
3=ACDInQueueAfterRejectedCallback
Next=PlayFirstAndLastAvailableTimes

[TimeNotAvailable]
type=Play
msg="TheTimeframe"

[AlternateTimeMenu]
type=Menu
msg="ToBeCalled"
msgstring=CallBackTime%"|D|h:n a/p"
msg="CentralTime"
msg="Press1"
msg="OtherwisePress2"
OnKey1=ScheduledCallback
OnKey2=GetNextAvailableTime
TimeOutSec=4
MaxBadKeys=2
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=2
OnMaxTimeouts=ACDInQueueAfterRejectedCallback

[GetNextAvailableTime]
type=ACD
Command=RequestCallback
CallbackType=NextScheduled
CallbackTimeVar=CallbackTime
OnError=RequestNotGranted
Next=CheckGetAlternateCallbackTimeResult

[CheckGetAlternateCallbackTimeResult]
type=Branch
var=@Result
4=AlternateTimeMenu
5=NoOtherTimeSlotsMenu
Next=RequestNotGranted

[NoOtherTimeSlotsMenu]
Type=branch
var=CallbackFifoDisabled
1=NoOtherTimeSlotsMenuNoFifoOption
Next=NoOtherTimeSlotsMenuWithFifoOption

[NoOtherTimeSlotsMenuWithFifoOption]
type=Menu
msg="NoOtherTimeSlots1"
msgstring=CallbackTime%"|D|h:n a/p"
msg="NoOtherTimeSlotsMenu"
OnKey1=ScheduledCallback
OnKey2=CheckOriginationAddressForFIFOCallback
OnKey3=ACDInQueueAfterRejectedCallback
TimeOutSec=4
MaxBadKeys=2
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=2
OnMaxTimeouts=ACDInQueueAfterRejectedCallback

[NoOtherTimeSlotsMenuNoFifoOption]
type=Menu
msg="NoOtherTimeSlots1"
msgstring=CallbackTime%"|D|h:n a/p"
msg="NoOtherTimeSlotsMenuNoFifoOption"
OnKey1=ScheduledCallback
OnKey3=ACDInQueueAfterRejectedCallback
TimeOutSec=4
MaxBadKeys=2
OnMaxBadKeys=ACDInQueueAfterRejectedCallback   
MaxTimeouts=2
OnMaxTimeouts=ACDInQueueAfterRejectedCallback



[RequestNotGranted]           !Flow p. 58c
type=Branch
var=@Result
1=NoLongerAvailableMenu
4=EnteredNumberInvalid
Next=RequestNotGrantedSystemError

[NoLongerAvailableMenu]
Type=branch
var=CallbackFifoDisabled
1=NoLongerAvailable
Next=NoLongerAvailableMenuWithFifoOption

[NoLongerAvailableMenuWithFifoOption]
type=Menu
msg="NoLongerAvailableMenu"
OnKey1=CheckOriginationAddressForFIFOCallback
OnKey2=ACDInQueue
TimeOutSec=4
MaxBadKeys=2
OnMaxBadKeys=ACDInQueue   
MaxTimeouts=2
OnMaxTimeouts=ACDInQueue

[NoLongerAvailable]
Type=Play
msg="NoLongerAvailable"
Next=ACDInQueue

[EnteredNumberInvalid]
type=Play
msg="TheNumberEntered"
msgstring=CallbackNumber%"|C|"
msg="IsInvalid"
Next=ResetCallbackNumberCounter

[RequestNotGrantedSystemError]
type=Play
msg="SystemProblem2"
Next=ACDInQueue


[PlayQueueFull]           !Flow p. 59
type=Play
msg="QueueFull"
msg="OperatorAssistance"
Next=MainMenu

!===================================
! Start ACD Callback Call
!===================================

[StartCallback]
type=Acd
Command=StartCallback
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnError=CallbackVarError

[CheckLanguageForCallback]
type=Branch
var=TR_CallerLanguage
"Spanish"=SetSpanishForCallback
Next=LogCallbackVars

[SetSpanishForCallback]
type=SetGlobals
Language="Spanish"

! Log to test that callback vars were loaded
[LogCallbackVars]
type=Log
Var=CallbackNumber

[CallbackStatusCalling]
type=Acd
Command=UpdateCallbackStatus
Parameter=Calling
OnError=CallbackStatusError

[MakeCallbackCall]   !block drops through to next block
type=Call
DestinationNumber=CallbackNumber
OriginationNumber=CallbackOrigNumber
CallReference="CallbackCall"
NoAnswerTimeoutSec=60
!OnCallError=WaitForAnswerToCallback     !CallbackNoAnswer
!Next=WaitForAnswerToCallback
OnCallError=CallbackPartyCancelled     !NoAnswer handling can lead to retry errors for calls that can't be connected; CallbackNoAnswer
Next=CallbackStatusConnected
! Changed 20200922 to no VAD per Nicole (RR)

[WaitForAnswerToCallback]
type=Audio
Command=AnswerDetection
AudioProfileName="Answer"
OnPersonalAnswer=CallbackStatusConnected
OnBusinessAnswer=CallbackStatusConnected
OnMachineAnswer=PlayCallbackMessage
OnToneDetect=PlayCallbackMessage
LogAudioEnergy=True
OnTimeout=CallbackNoAnswer
Timeoutsec=100
Next=CallbackStatusConnected

[PlayCallbackMessage]
type=play
msg="Silence2Seconds"    !prevent cut-off of CallbackMessage
msg="CallbackMessage"
msg="Silence2Seconds"    !Repeat callbackmsg
msg="CallbackMessage"
WaitForMsg=True
Next=CallbackLeftMessage

! Callback party is connected ...
[CallbackStatusConnected]
type=Acd
Command=UpdateCallbackStatus
Parameter=Answered
OnError=CallbackStatusError

[PlayCallbackGreeting]
type=play
WaitForMsg=True
msg="CallbackGreeting"

[CallbackOptionMenu3]
type=menu
msg="CallbackOptionMenu3"
OnKey1=CallbackPartyCancelled
OnKey2=CheckCallbackMenuCounter
OnKey3=CheckCallbackMenuCounter
OnKey4=CheckCallbackMenuCounter
OnKey5=CheckCallbackMenuCounter
OnKey6=CheckCallbackMenuCounter
OnKey7=CheckCallbackMenuCounter
OnKey8=CheckCallbackMenuCounter
OnKey9=CheckCallbackMenuCounter
OnKey0=CallbackStatusReady
OnKeyPound=CheckCallbackMenuCounter
OnKeyStar=CheckCallbackMenuCounter
TimeOutSec=4   
MaxTimeouts=0
OnMaxTimeouts=PlayCallbackMessage

[CheckCallbackMenuCounter]
type=branch
var=CallbackMenuCounter
2=CallbackNoAnswer
OnBelowRange=IncrementCallbackMenuCounter
OnAboveRange=CallbackNoAnswer
Next=IncrementCallbackMenuCounter

[IncrementCallbackMenuCounter]
type=ChangeVariable
Increment=CallbackMenuCounter
Next=CallbackOptionMenu3

! Setting status to Party_Ready will make call eligible for agent
[CallbackStatusReady]
type=Acd
Command=UpdateCallbackStatus
Parameter=PartyReady
OnError=CallbackStatusError

[SetCallbackCallFlagTrue]
type=ChangeVariable
CallbackCall=1
CallbackFinalStatus=4     != party abandoned; default to catch early hangups
Next=ACDInQueue

[CallbackVarError]
type=Log
LogMsg="Callback vars could not be loaded. Terminating callback"
Next=EndCall

[CallbackCallError]
type=Log
LogMsg="Callback error"
Next=EndCall

[CallbackStatusError]
type=Log
LogMsg="Callback Status error"
Next=EndCall

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Callback Call has returned from ACD
!   This section updates the callback status.  If
!   the call returns due to normal agent disconnect,
!   terminate the callback call.  Other routes,
!   especially Agent user routes are handled just like
!   non-callback calls. 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[ResetCallbackCallFlag]
type=ChangeVariable
CallbackCall=0
next=EndCall

[CallbackLeftMessage]
type=Acd
Command=UpdateCallbackStatus
Parameter=LeftMessage
OnError=CallbackReturnStatusError
next=ResetCallbackCallFlag

[CallbackWrongParty]
type=Acd
Command=UpdateCallbackStatus
Parameter=WrongParty
OnError=CallbackReturnStatusError
next=ResetCallbackCallFlag

[CallbackPartyAbandoned]
type=Acd
Command=UpdateCallbackStatus
Parameter=PartyAbandoned
OnError=CallbackReturnStatusError
next=ResetCallbackCallFlag

[CallbackPartyCancelled]
type=Acd
Command=UpdateCallbackStatus
Parameter=PartyCancelled
OnError=CallbackReturnStatusError
next=ResetCallbackCallFlag

[CallbackNoAnswer]
type=Acd
Command=UpdateCallbackStatus
Parameter=NoAnswer
OnError=CallbackReturnStatusError
next=ResetCallbackCallFlag

[EndCallbackCallWhenAgentTerminates]
type=Branch
var=@AcdRouteCode
5=EndCall	
Next=CallReturnFromAcd

[CallbackReturnStatusError]
type=Log
LogMsg="Callback Return Status error"
Next=EndCall

!===================================
! Callback Module End Routines
!===================================

!===================================
! End Routines
!===================================
[Exit]
Type=Branch
Var=DoSurvey
1=DoSurvey

[PlayThankYou]
type=play
msg="ThankYou"

[Goodbye]
Type=Branch
Var=DoSurvey
1=DoSurvey

[PlayGoodbye]
type=play
msg="Goodbye"

[CheckCallBackCallFlag]
type=Branch
var=CallBackCall
1=CheckCallbackFinalStatus
Next=HangupCall

[CheckCallbackFinalStatus]
type=branch
var=CallbackFinalStatus
0=HangupCall
4=CallbackPartyAbandoned
Next=HangupCall

[HangupCall]
type=play
msg="Silence"
WaitForMsg=True

[Endcall]
Type=Branch
Var=DoSurvey
1=DoSurvey

{
Type=Branch
Var=CallbackCall
1=CallbackComplete
Next=Endcall1

[CallbackComplete]
type=Acd
Command=UpdateCallbackStatus
Parameter=CallbackComplete
OnError=Endcall1

[Endcall1]}

{ ! Removed 2023-3-7 RR for 1314 fix?
[DisconnectCall]
type=CallControl
Command=Disconnect
}
[EndCallWait]
type=pause
PauseSec=10

[EndOfScript]
type=Terminate

!!End Of Script - Nothing Goes Below This
