PromptMsgDTMF="CaseNotFound",TR_SearchCaseNumber|C,"CaseNotFoundMenuDTMF"
!Grammar="RecordNotFound"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Agent=SetOperatorMsgForRecordNotFoundCaseProcess
OnResult:Reenter=DLProcess
OnResult:Case=ReenterCase
OnResult:Citation=CitationProcess
OnResult:Authorization=GetAuthorization
OnResult:Main=MainMenu
