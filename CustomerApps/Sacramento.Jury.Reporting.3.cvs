next=ACDInQueue

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Agent Routes
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[AcdRouteError]
type=Play
FlushPlayQueue=True
Msg="QueueShutdown"
Next=CheckLoopingError

[AcdError]
type=Play
FlushPlayQueue=True
msg="SystemProblem"
WaitForMsg=TRUE
Next=Exit

[CheckLoopingError]
type=branch
var=ErrorCounter
1=Exit
OnAboveRange=Exit
Next=CheckIfLoggedIn

[CheckIfLoggedIn]
type=branch
var=JurorLoggedIn
0=LanguageCheck
1=ConstructMainMenu


