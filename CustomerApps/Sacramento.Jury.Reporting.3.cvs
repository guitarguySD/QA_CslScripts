msg=PhraseToRecord
Next=JuryRecordPhrase

!============================================
! ACD Call
!============================================

[ACDAvailable]     !p. 69
type=log
logmsg="ACD calls"

[GetAssistanceAvailableVar]
type=VariableManager
VarList="AssistanceAvailable"
OnError=LogACDAvailableVMFailure

[CheckAssistanceAvailableForOperator]
Type=Branch
Var=AssistanceAvailable
0=NoOperator
1=PleaseHold
Next=LogACDAvailableVMFailure

[NoOperator]
type=Play
msg="NoOperatorAvailable"
msg="AssistanceHours"
msgstring=OperatorOpen%"|D|h:n a/p"
msg="To"
msgstring=OperatorClosed%"|D|h:n a/p"
msg="MondayThruFriday"
Next=Exit

[LogACDAvailableVMFailure]
type=log
logmsg="ACD Var Man Failure"

[PleaseHold]
type=play
msg="PleaseHoldMsg"
WaitForMsg=True

[LACD]
type=log
logmsg="Route to ACD"

[SetAcdCallReference]
type=ChangeVariable
@CallReference="AcdCall"

[acdlog]
type=log
var=screenpopapn

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller.  Note that this block never
!  falls through and executes the Next block.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[RouteCaller]
type=ACD
Command=RouteCall
OriginationNumber=9168747775
RouteName=ACD_RouteName
OnError=AcdRouteError
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnTimeout=RouteTimeout

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call Enters Queue
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[ACDWait1]
!Needed to know if going into queue or not
type=pause
pausesec=1

[LogACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[CheckCaller]
type=ACD
Command=CheckCallStatus
OnError=AcdRouteError
OnTimeout=RouteTimeout

[LogCheckACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[QueuePosition]
type=branch
var=@AcdPositionInQueue
0=YouAreNext
1=CurrentlyOne
OnBelowRange=YouAreNext
OnAboveRange=PlayQueuePosition

[YouAreNext]
type=play
msg="NextInQueue"
Next=ACDInQueue

[CurrentlyOne]
type=play
msg="CurrentlyOne"
Next=ACDInQueue

[PlayQueuePosition]
type=play
msg="Currently"
msgstring=@AcdPositionInQueue%"|N"
msg="CallersAhead"

[ACDInQueue]
type=Play
msg="$MusicOnHold1"
msg="Silence"
msg="$MusicOnHold2"
msg="Silence"
msg="$MusicOnHold3"
msg="Silence"
msg="$MusicOnHold4"
msg="Silence"
! Silence is placehold for on hold messages
WaitForMsg=TRUE
Next=CheckCaller


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Call is connecting to ACD Agent.  Play ring. 
!     Queue 4 rings (4X6 sec) to limit logging.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnecting]
type=Play
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
WaitForMsg=TRUE
Next=AcdAgentConnecting


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call is connected to ACD Agent
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnected]
type=Pause
PauseSec=60
next=AcdAgentConnected


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call has returned from ACD 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnFromAcd]
type=Branch
var=@AcdRouteCode
1=CallReturnErrorRoute
2=CallReturnDefaultRoute
3=QueueShutdown
4=QueueFull
5=EndCall	
6=CallReturnAgentTransfer	
7=CallReturnReleaseKeyPressed
8=CallReturnConferenceConnected
9=CallReturnAgentAwol
! From 11 on are customer defined routes for route return from acdagent
11=MainMenuCheckForJurorID
12=GetJurorID
13=VerifyFromACDHasIDForReschedule
14=CheckForJurorIDFirst
15=FAQDirections
16=SetTransferToDept1
17=SetTransferToDept4
18=SetTransferToDept5
19=SetTransferToDept10
20=SetTransferToDept11
21=SetTransferToDept12
22=SetTransferToDept13
23=SetTransferToDept14
24=SetTransferToDept15
25=SetTransferToDept16
26=SetTransferToDept17
27=SetTransferToDept18
28=SetTransferToDept19
29=SetTransferToDept20
30=SetTransferToDept21
31=SetTransferToDept22
32=SetTransferToDept23
33=SetTransferToDept24
34=SetTransferToDept25
35=SetTransferToDept26
36=SetTransferToDept27
37=SetTransferToDept28
38=SetTransferToDept29
39=SetTransferToDept30
40=SetTransferToDept31
41=SetTransferToDept32
42=SetTransferToDept33
43=SetTransferToDept34
44=SetTransferToDept35
45=SetTransferToDept36
46=SetTransferToDept37
47=SetTransferToDept38
48=SetTransferToDept39
49=SetTransferToDept40
50=SetTransferToDept41
51=SetTransferToDept42
52=SetTransferToDept43
53=SetTransferToDept44
54=SetTransferToDept45
OnBelowRange=AcdError
OnAboveRange=AcdError
Next=AcdError

[RetrieveRecordCheckForJurorID]
type=branch
var=Jury_JurorID
""=GetJurorID
"0"=GetJurorID
Next=RetrieveRecord

[MainMenuCheckForJurorID]
type=branch
var=Jury_JurorID
""=GetJurorID
"0"=GetJurorID
!Next=ConstructMainMenu
Next=HoldMusicForGetJurorRecord

[CheckForJurorIDFirst]
type=branch
var=Jury_JurorID
""=GetJurorID
"0"=GetJurorID
!Next=ConstructMainMenu
Next=HoldMusicForGetJurorRecord

[CallReturnErrorRoute]
type=Log
LogMsg="Error Route"
Next=CheckIfLoggedIn

[CallReturnDefaultRoute]
type=Log
LogMsg="DefaultRoute"
Next=CheckIfLoggedIn

[QueueShutdown]
type=Play
msg="QueueShutdown"

[LogQueueShutdown]
type=log
logmsg="Queue Shutdown"
Next=CheckIfLoggedIn

[QueueFull]
Type=Play
msg="QueueFull"

[LogQueueFull]
type=log
logmsg="QueueFull"
Next=CheckIfLoggedIn          !Our offices are open, however there are too many callers currently waiting for operators. If you require operator assistance please call again later. The least busy time of the week to retry your call is from 1:30 to 3:30 on Tuesdays, Wednesdays, and Thursdays. Otherwise please choose from the following options.

[CallReturnAgentTransfer]
type=log
logmsg=ACD_Agent
next=ACDInQueue
	
[CallReturnReleaseKeyPressed]
type=log
logmsg="Release Key Pressed"

[AgentPressedRelease]
type=Pause
PauseSec=60
Next=AgentPressedRelease

[CallReturnConferenceConnected]
type=Log
LogMsg="ConferenceConnected"
next=Exit

[RouteTimeout]
type=Play
msg="AcdTimeout"
next=Exit

