[MainMenu]   ! page 036
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
grammar="MainMenu.grxml"
PromptMsg="Say","MainStaff1"|X|1,"MainStaff2"|X|2,"MainStaff2A"|X|2,"MainStaff3"|X|3,"MainStaff4"|X|4,"MainStaff5","MainStaff6"|X|6,"MainStaff0","MakeChoice"
PromptMsgDTMF="MainStaffDTMF1"|X|1,"MainStaffDTMF2"|X|2,"MainStaffDTMF3"|X|3,"MainStaffDTMF4"|X|4,"MainStaffDTMF5","MainStaffDTMF6"|X|6,"MainStaffDTMF0","MakeChoice"
HelpMsg="StandardHelp"
!IntroMsg=
!IntroMsgDTMF=
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:"Reschedule"=MainMenuReschedule       !1
!OnResult:"Attendance"=StatE_AttendanceDates          !2 
OnResult:"WorkCertificate"=StatE_WorkCertificate     !3
OnResult:"Information"=StatE_FAQs             !4
OnResult:"Repeat"=ConstructMainMenu                    !*
OnResult:"Agent"=SetScreenMsgForMainMenu       !0
OnResult:"JurorRecord"=GetJurorID
OnResult:"RequestExcuse"=DisqusalMenu
OnResult:"CheckStatus"=StatE_CheckStatus
OnResult:PaymentInfo=PaymentInfo
OnResult:Hangup=EndCall
Onkey1=MainMenuReschedule
Onkey2=DisqusalMenu
Onkey3=StatE_WorkCertificate
OnKey4=PaymentInfo
Onkey5=StatE_FAQs
OnKey6=StatE_CheckStatus
Onkey7=InvalidMenuEntry
Onkey8=InvalidMenuEntry
Onkey9=InvalidMenuEntry
OnKey0=SetScreenMsgForMainMenu
OnkeyStar=MenuRetry
Onkeypound=MenuRetry
OnDTMFError=SetScreenMsgForMainMenuOnError
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
ConfidenceThreshold=30
SuccessMsg="SuccessMsg"

[CheckAssistanceAvailableForOnKey0] 
Type=Branch
Var=AssistanceAvailable
0=SpeakToStaff
Next=ACDAvailable

[SpeakToStaff]
