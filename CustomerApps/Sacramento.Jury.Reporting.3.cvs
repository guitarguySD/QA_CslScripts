!Jury Group reporting Variables
Jury_GroupReportingAvailable=0
Jury_GroupReportingDate=""
Jury_GroupReportingTime=""
Jury_GroupReporting=0
Jury_Group=""
Jury_GroupNumberInput=""
Jury_GroupReportingLocation=""
Jury_GroupReportingInstructionsAvailable=0
Jury_GroupServiceCompleted=0
Jury_GroupRequiredToReport=0
Jury_GroupCallbackRequired=0
Jury_GroupReportingCallbackTime=""
Jury_CallbackTimeOnly=""
BadgeLength=0
JGR_URL="http://localhost/JurorGroupsClient/"
JuryGroupClientURL="http://localhost/JurorGroupsClient/"
JGR_Group=""

! JSI RNF Error Test
Test_TotalRetrievalCount=0
Test_RecordFoundCount=0
Test_RecordNotFoundCount=0
Test_RetrievalErrorCount=0
Test_TotalLoops=0

! JSI Db Down
DbDown = 0

!========================================
! Set System Defaults
!========================================
[BlockDefaults]
Type=SetDefaults
DefaultIgnoreMissingMsg=True
DefaultFlushKeys=False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3			!Unlike timeouts, badkeys works as expected.
DefaultOnMaxBadKeys=StatE_Sorry
DefaultTimeOutSec=5
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=2			!Depending on how script is written, MaxTimeOuts gives one more timeout than number set.
DefaultOnMaxTimeOuts=StatE_Sorry
DefaultLogCall=True
DefaultLogMenu=True
DefaultLogGetDigits=True
DefaultLogPlay=True
DefaultTerminator=""

[InitializeVariables]
Type=log

[GetInitialVariables]
type=VariableManager
VarList="DateRetryCount,HostAvailable,HolidayToday,FurloughToday,AssistanceAvailable,OperatorOpen,OperatorClosed,RecordPassword,PhraseToRecord,TestModePassword,MaintenanceMode,DbDown"
OnError=LogInitialValues
Next=InitializeJSIDll

[LogInitialValues]
type=log
logmsg="Caller Number= "%@OriginationAddress%" Dialed Number= "%@DestinationAddress

[CheckJSIDbDownInit]	! Skip JSI initialization
type=branch
var=DbDown
1=CheckGroupReportingAvailable

[InitializeJSIDll]
type=ExecuteRoutine
DLL="SonantJsiCvpClient.DLL"
Routine="Jury_Initialize"
OnExecuteError=InitializeDLLProblem
Next=CheckGroupReportingAvailable

[InitializeDLLProblem]
type=log

! Check if Group Reporting is Available
[CheckGroupReportingAvailable]
type=ExecuteRoutine
DLL="SonantJsiCvpClient.DLL"
Routine="Jury_GetNextReportingDate"
OnExecuteError=GroupINIError
Next=Log_GroupReportingAvailable

[GroupINIError]
Type=Log
LogMsg="Error: Group Info"
Next=StatE_SystemError

[Log_GroupReportingAvailable]
type=log
LogMsg="Group Reporting Available = "%Jury_GroupReportingAvailable

[StartupRecognitionSession]   ! page 003
type=ChangeVariable
@RecognizeDtmfMode=1

!Type=StartRecognitionSession
!OnError=LogRecognitionSessionError
!TimeOutMsec=7000
!OnNoSession=CheckOfficeOpen
!Next=CheckOfficeOpen
Next=CheckOfficeOpen

[LogRecognitionSessionError]
Type=Log
LogMsg="Error starting up Recognize session"
Next=CheckOfficeOpen

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[CheckOfficeOpen]   ! page 003
Type=Branch
Var=AssistanceAvailable
0=StatE_OfficeClosed			
1=StatE_OfficeOpen
Next=StatE_SystemError

[StatE_OfficeOpen]
Type=Log
LogMsg="Calls Open"
Next=Greeting

[StatE_OfficeClosed]
Type=Log
LogMsg="Calls Closed"
Next=Greeting

[Greeting]
Type=Play
Msg="Silence"
Msg="Silence"
Msg="Greeting"
Msg="OptionalGreeting"
Msg="Silence"
Next=LanguageCheck

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[LanguageCheck]   ! page 05
Type=Branch
var=MaintenanceMode
0=CheckJSIDbDown
1=MaintenenceMode

[MaintenenceMode]
type=menu
!Msg="DataUnavailableContinue"
msg="DownForMaintenance"
OnKeyPound=StatE_Admin
MaxBadKeys=0
BadKeyMsg="InvalidSelectionDTMF"
OnMaxBadKeys=SetScreenMsgLanguage
TimeOutSec=1
MaxTimeOuts=0
!TimeoutMsg="Timeout"
!OnMaxTimeOuts=SetScreenMsgLanguage
OnMaxTimeOuts=Exit
FlushKeys=True
!Next=SetScreenMsgLanguage
Next=Exit


[CheckJSIDbDown]
type=Branch
var=DbDown
0=LanguageMenu
1=PlayDbDown

[PlayDbDown]
type=play
msg="JSIDbDownContinue"


[LanguageMenu]
Type=Menu
Msg="LanguageMenu"
OnKey1=StatE_English
OnKey2=StatE_Spanish
OnKey3=StatE_Ukrainian
OnKey4=StatE_Russian
OnKey5=StatE_Dari
OnKey6=StatE_Punjabi
OnKey7=StatE_Mandarin
OnKey0=SetScreenMsgLanguage
OnKeyPound=StatE_Admin
MaxBadKeys=2
BadKeyMsg="InvalidSelectionDTMF"
OnMaxBadKeys=DBAvailable
TimeOutSec=4
MaxTimeOuts=0
!TimeoutMsg="Timeout"="TimeoutDTMF"
OnMaxTimeOuts=DBAvailable
FlushKeys=True
Next=DBAvailable

[SetScreenMsgLanguage]
Type=ChangeVariable
ScreenMsg="LanguageMenu"
Next=ACDAvailable

!=======================================
! ENGLISH
[StatE_English]
Type=Log
LogMsg="Lang:English"

[SetLanguageEnglish]
type=setglobals
Language="English"
Next=DBAvailable

!=======================================
! SPANISH
[StatE_Spanish]
Type=Log
LogMsg="Spanish"

[SetCallerLanguageSpanish]
type=changeVariable
CallerLanguage="Spanish"

[SetLanguageSpanish]
type=setglobals
Language="Spanish"
Next=StatE_NonEnglishCaller

!=======================================
! RUSSIAN
[StatE_Russian]
Type=Log
LogMsg="Russian"

[SetCallerLanguageRussian]
type=changeVariable
CallerLanguage="Russian"

[SetLanguageRussian]
type=setglobals
Language="Russian"
Next=StatE_NonEnglishCaller

!======================================
! Ukrainian
[StatE_Ukrainian]
Type=Log
LogMsg="Ukrainian"

[SetCallerLanguageUkrainian]
type=changeVariable
CallerLanguage="Ukrainian"

[SetLanguageUkrainian]
type=setglobals
Language="Ukrainian"
Next=StatE_NonEnglishCaller

!======================================
! Dari
[StatE_Dari]
Type=Log
LogMsg="Lang:Dari"

[SetCallerLanguageDari]
type=changeVariable
CallerLanguage="Dari"

[SetLanguageDari]
type=setglobals
Language="Dari"
Next=StatE_NonEnglishCaller

!======================================
! Punjabi
[StatE_Punjabi]
Type=Log
LogMsg="Lang:Punjabi"

[SetCallerLanguagePunjabi]
type=changeVariable
CallerLanguage="Punjabi"

[SetLanguagePunjabi]
type=setglobals
Language="Punjabi"
Next=StatE_NonEnglishCaller

!======================================
! Mandarin
[StatE_Mandarin]
Type=Log
LogMsg="Lang:Mandarin"

[SetCallerLanguageMandarin]
type=changeVariable
CallerLanguage="Mandarin"

[SetLanguageMandarin]
type=setglobals
Language="Mandarin"
Next=StatE_NonEnglishCaller

!===================================
! Non English
[StatE_NonEnglishCaller]
type=Log
logmsg="NonEnglish Caller"

[NE_CheckDBDown]
type=Branch
var=DbDown
0=NonEnglishJuror
1=NE_PlayDbDown

[NE_PlayDbDown]
type=play
msg="JSIDbDownContinue"
Next=Exit

[NonEnglishJuror]
Type=play
msg="NonEnglishJuror"

[NonEnglishJurorMenu]
type=menu
msg="NonEnglishJurorMenu"
OnKey1=ContinueInEnglish
OnKey2=NE_GetJurorIdStart
OnKeyStar=NonEnglishJuror
OnKeyPound=NonEnglishJurorMenu

!============================================
! User has chosen to work in English
!
[ContinueInEnglish]
type=play
msg="NE_ContinueInEnglish"
WaitForMsg=true

[RestLanguageToEnglish]
type=SetGlobals
Language="English"

[ResetCallerLanguageToEnglish]
type=changeVariable
CallerLanguage="English"
Next=DBAvailable

!=======================================================================
! NonEnglish - Get Juror ID
!=======================================================================
[NE_GetJurorIdStart]
type=changeVariable
ErrorCounter=0

[NE_GetJurorID]
type=GetDigits
msg="NE_EnterJurorIDDTMF"
var=Jury_JurorID
MinDigits=7
MaxDigits=10
Terminator="#*"
CountVar=BadgeLength
Next=NE_CheckBadgeLength

[NE_CheckBadgeLength]
type=Branch
var=BadgeLength
7=NE_VerifyBadgeNumber
8=NE_VerifyBadgeNumber
9=NE_VerifyBadgeNumber
OnAboveRange=NE_ExpectingSeven
OnBelowRange=NE_ExpectingSeven

[NE_ExpectingSeven]
type=play
msg="ExpectingSevenDTMF"
Next=NE_GetJurorId

[NE_StripZeros]
type=CopyString
var=TempVar
string=Jury_JurorID
Count=2
Start=1

[NE_CheckBadgeStringStart]
type=branch
var=TempVar
"00"=NE_StripAughts
Next=NE_ExpectingSeven

[NE_StripAughts]
type=CopyString
var=TempVar
String=Jury_JurorID
Count=7
Start=3

[LogJurorIDs]
type=log
var=Jury_JurorID,TempVar

[NE_CopyIntoJurorID]
type=changeVariable
Jury_JurorID=TempVar
Next=NE_VerifyBadgeNumber

[NE_VerifyBadgeNumber]
type=play
msg="NE_BadgeNumberIsDTMF"
msgstring=Jury_JurorID

[NE_VerifyBadgeMenu]
type=menu
msg="NE_VerifyBadgeMenuDTMF"
OnKey1=NE_RetrieveRecord
OnKey2=ReenterJid

[ReenterJid]
type=changeVariable
increment=ErrorCounter

[CheckErrorCounter]
type=branch
var=ErrorCounter
2=StatE_Sorry
OnBelowRange=NE_GetJurorId
OnAboveRange=StatE_Sorry

!-------------------------------------
! NE Retrieve Record
[NE_RetrieveRecord]
Type=Branch
Var=HostAvailable
0=NE_SetUnknownID
Next=NE_HoldForRecord

[NE_SetUnknownID]
Type=ChangeVariable
UnknownID=1

[NE_DataUnavailable2]
Type=Play
Msg="DataUnavailable"
Next=Exit

[NE_HoldForRecord]
Type=Play
Msg="HoldForRecord"
Msg="Silence"
WaitForMsg=true

[NE_LogJury_JurorID]
Type=Log
LogMsg=Jury_JurorID

[NE_HoldMusicForGetJurorRecord]
type=Play
msg="$MusicOnHold1"
msg="Silence"
msg="$MusicOnHold2"
msg="Silence"
msg="$MusicOnHold3"
msg="Silence"
msg="$MusicOnHold4"
msg="Silence"

[NE_SetJSIDisconnect]
type=changevariable
AccessJSI=1

[NE_ExecuteRecordRetrieval]
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.dll"
Routine="Jury_GetJurorRecord"
OnExecuteError=StatE_SystemError

[NE_DoneHolding]
type=play
FlushPlayQueue=true

[NE_LogGetJurorRecordResult]
type=log
var=Jury_JurorID,Jury_Result
!logmsg="Jury_Result="%Jury_Result

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[NE_CheckRetrieveResult]   ! Guardian redirected to system error  page 023
Type=Branch
Var=Jury_Result
0=NE_RecordFound
25=NE_RecordNotFound
23=NE_RecordNotFound
1=StatE_ClientError
2=StatE_ClientError
3=StatE_ServerError
4=StatE_ServerError
5=StatE_CommunicationError
6=StatE_CommunicationError
7=StatE_CommunicationError
8=StatE_CommunicationError
9=StatE_CommunicationError
10=StatE_CommunicationError
11=StatE_ClientError
12=StatE_ClientError
13=StatE_ClientError
14=StatE_ClientError
15=StatE_ClientError
16=StatE_JSIError
17=StatE_JSIError
18=StatE_JSIError
19=StatE_JSIError
20=StatE_JSIError
21=StatE_JSIError
22=StatE_JSIError
24=StatE_JSIError
Next=StatE_SystemError

[NE_RecordNotFound]
type=log
var=Jury_JurorID

[NE_PlayRecordNotFound]
type=play
msg="NE_RecordNotFound"
msgstring=Jury_JurorId
msg="NE_PleaseTryAgain"
Next=NE_GetJurorID

[NE_RecordFound]
type=log
var=Jury_JurorId

[NE_SetGroupNumber]		! This is the callers Group Number
type=changeVariable
Jury_Group = Jury_ReportingGroup
JurorLoggedIn=1
Next=NE_VerifyName

[NE_VerifyName]
type=log
logmsg=Jury_Name

[NE_SpellName]
type=play
msg="NE_VerifyName"
msgstring=Jury_LastName%"|C"

[NE_VerifyNameMenu]
type=menu
msg="NE_VerifyNameMenu"
OnKey1=NE_CheckStatus
OnKey2=NE_GetJurorID

[NE_CheckStatus]
Type=Branch
Var=Jury_Status
"P"=NE_StatusIsIorP
"A"=NE_AllOther
"B"=NE_StatusIsCorB
"R"=NE_AllOther
"C"=NE_StatusIsCorB
"I"=NE_StatusIsIorP
"F"=NE_StatusIsF
"X"=NE_StatusIsCorB
Next=NE_AllOther


[NE_AllOther]
type=play
msg="NE_AllOtherStatuses"
WaitForMsg=true

[SetScreenMsgNEAllOther]
Type=ChangeVariable
ScreenMsg="Spanish, Status issue"
JSI_OperatorMessageCode=1
Next=ACDAvailable


[NE_StatusIsCorB]
type=play
msg="NE_StatusCorB"
WaitForMsg=true
Next=Exit

[NE_StatusIsF]
type=play
msg="NE_StatusF"
WaitForMsg=true
Next=Exit

[NE_StatusIsIorP]
type=log

[NE_FTACheck]
Type=Branch
Var=Jury_HasFailedToAppear
0=NE_Disqualify
1=NE_JurorFTA         
Next=NE_Disqualify

[NE_JurorFTA]
type=log
Next=NE_Disqualify

!----------------------------------------
! Disqualification Menu
! 
[NE_Disqualify]
type=menu
msg="NE_QualifyMenuDTMF"
OnKey1=NE_Language
OnKey2=NE_NonCitizen
Onkey8=NE_Qualified
OnKey0=SetScreenMsgNEDisqualify

!--------------------
! Requested Agent
[SetScreenMsgNEDisqualify]
Type=ChangeVariable
ScreenMsg="Spanish, Disqualify"
JSI_OperatorMessageCode=1
Next=ACDAvailable

!-----------------------
! Caller thinks they are qualified
[NE_Qualified]
type=play
msg="NE_ContinueInEnglish"

[NE_ResetToEnglish]
type=changeVariable
CallerLanguage="English"

[SetToEnglishLanguage]
type=setglobals
Language="English"
Next=NameIsValid

!------------------------------------------------------------
! Qualification or disqualification
! 
[NE_Language]
type=changeVariable
Jury_TypeCode="DP"
Jury_ReasonCode="LG"
PerjuryNoticeMsg="ExcuseMsgDPLG"
Next=NE_AutoApproved

[NE_NonCitizen]
type=changeVariable
Jury_TypeCode="DP"
Jury_ReasonCode="NC"
PerjuryNoticeMsg="ExcuseMsgDPNC"
Next=NE_AutoApproved

[NE_AutoApproved]
type=play
msg=PerjuryNoticeMsg

! 1 = under POP, all is true
! 2 = back to previous menu
[NE_AutoApprovedMenu]
type=menu
msg="NE_PerjuryMenuDTMF"
OnKey1=NE_ProcessRequest
OnKey2=NE_Disqualify
Onkey0=SetScreenMsgNEAutoApprove

! On key 0
[SetScreenMsgNEAutoApprove]
Type=ChangeVariable
ScreenMsg="Disqualification, Spanish"
JSI_OperatorMessageCode=1
Next=ACDAvailable

! On key 1
[NE_ProcessRequest]
type=log
var=Jury_JurorID,Jury_TypeCode,Jury_ReasonCode

[NE_UpdateDisqusal]  
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.dll"
Routine="Jury_ServiceEnd"
OnExecuteError=StatE_SystemError

[NE_LogNEDisqusalResult]
type=log
var=Jury_JurorID,Jury_Result, Jury_TypeCode, Jury_ReasonCode

[NE_CheckUpdateDisqusalResult]
Type=Branch
Var=Jury_Result
0=NE_SuccessfulDisqusal
Next=NE_UnsuccessfulDisqual

!-------------------------------------
! Disqualification failed
[NE_UnsuccessfulDisqual]
type=log
logType=ScriptEvent
logmsg="NE_Disqual_Failed"

!----------------------
! Check if juror was FTA
[NE_FailedFTACheck]
Type=Branch
Var=Jury_HasFailedToAppear
0=NE_PlayProblemTransfer
1=NE_PlayFTAProblem       
Next=NE_PlayProblemTransfer

!------------------------------
! Unsuccesful disqual - Juror FTA
[NE_PlayFTAProblem]
type=play
msg="NE_FTADisqualProblem"
WaitForMsg=true

[NE_LogDisqualFailedFTA]
type=log
logType=ScriptEvent
logmsg="NE_Disqual_FTA"

[SetScreenMessageNE_FTADisqual]
type=changevariable
ScreenMsg="NonEnglish Disqual FTA"
Next=ACDAvailable

!-----------------------------------------
! Unsuccesful disqual - some other problem
[NE_PlayProblemTransfer]
type=play
msg="NE_SorryProblem"
WaitForMsg=true

[SetScreenMsgNE_DisqusalFailed]
type=changeVariable
ScreenMsg="NonEnglish Excusal Failed"
Next=ACDAvailable

!-----------------------------------------
! Successful NonEnglish Disqualification
[NE_SuccessfulDisqusal]
type=log
logType=ScriptEvent
logmsg="NE_Disqual_Success"

[NE_PlaySuccessDisqual]
type=play
msg="DisqualGranted"
WaitForMsg=true
Next=Exit

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[StatE_GroupReporting]   ! page 08
Type=log
LogMsg="Group Report Time"

[setRetryCounter0]
Type=ChangeVariable
RetryCounter=0

[GroupNumberInput]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
!IntroMsg=""
!IntroMsgDTMF=""
PromptMsg="GroupNumberInput"
PromptMsgDTMF="GroupNumberInputDTMF"
grammar="GroupNumber.grxml"
Var=Jury_GroupNumberInput
ResultFormat=Digits
ResultLengthMin=1
ResultLengthMax=3
DTMFTerminator="#"
MinDigitsMsg="ExpectingThreeDigits"
MaxDigitsMsg="ExpectingThreeDigits"
MisrecognizeMsg="TryAgain"
FlushKeys=True
MaxRetryCount=2
OnMaxRetries=StatE_GroupNumberProblem
ShiftToDTMFMsg="ShiftToDTMF"
OnKeyStar=GroupNumberInput
OnKeyPound=CheckResultForZeroPound
OnDTMFError=Exit
OnOtherResult=OnOtherResultEnterGroupNumber
BadKeyMsg="InvalidSelectionDTMF"              
!!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
ConfidenceThreshold=30
SuccessMsg="SuccessMsg"
Next=CheckResultForZeroPound

[CheckResultForZeroPound]
type=Branch
var=Jury_GroupNumberInput
0=StatE_MissingGroupNumber
Next=CheckGroupNumberLength

[CheckGroupNumberLength]
type=branch
var=@recognizeLength
3=ValidateGroupNumber
OnBelowRange=PlayExpectingThree
OnAboveRange=PlayExpectingThree

[PlayExpectingThree]
type=play
msg="ExpectingThreeDigits"

[CheckGroupNumberRetryCounter]
type=branch
var=retryCounter
3=StatE_GroupNumberProblem
OnAboveRange=StatE_GroupNumberProblem
OnBelowRange=IncrementGroupNumberRetry

[IncrementGroupNumberRetry]
type=changeVariable
increment=retryCounter
Next=GroupNumberInput

[StatE_MissingGroupNumber]
Type=Log
LogMsg="Missing Group Number"

[SetScreenMessageForMissingGroupNumber]
Type=ChangeVariable
ScreenMsg="Problem: MISSING GROUP #"
JSI_OperatorMessageCode=1
Next=ACDAvailable

[StatE_GroupNumberProblem]
Type=Log
LogMsg="Group Number Problem"

[PlayDifficultyGettingGroupNumber]
type=play
msg="DifficultyGettingGroupNumber"

[SetScreenMsgForGroupNumberProblem]
Type=ChangeVariable
ScreenMsg="Problem: ENTERING GROUP #"
JSI_OperatorMessageCode=1
Next=ACDAvailable

[OnDtmfErrorEnterGroupNumber]
type=Play
Msg="TryAgainDTMF"
Next=GroupNumberInput

[OnErrorEnterGroupNumber]
type=Play
Msg="TryAgain"
Next=GroupNumberInput

[OnOtherResultEnterGroupNumber]
type=play
msg="TryAgain"
Next=GroupNumberInput

[OnDtmfErrorEnterGroupNumberShiftDTMF]
type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec2]
type=EndRecognitionSession

[StatE_DTMF2]
Type=Log
LogMsg="Change to DTMF"
Next=GroupNumberInput

[CantFindGroupNumber]
Type=ChangeVariable
ScreenMsg="Problem: CAN'T FIND GROUP #"
JSI_OperatorMessageCode=1
Next=ACDAvailable

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

[ValidateGroupNumber]   ! page 09
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
!IntroMsg=""
!IntroMsgDTMF=""
PromptMsg="ValidGroup",Jury_GroupNumberInput|C,"YesOrNoMenu"
PromptMsgDTMF="ValidGroupDTMF",Jury_GroupNumberInput|C,"YesOrNoMenuDTMF"
grammar="YesNoStaff.grxml"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="Silence"   
!OnKey1=ReportingInstructions
OnKey1=PrePendZero			! Have to prepend a zero to group number
OnKey2=CheckGroupNumberRetryCounter
OnKey0=StatE_GroupNumberProblem
OnKeyStar=ValidateGroupNumber
OnResult:Yes=PrePendZero      !1
OnResult:No=CheckGroupNumberRetryCounter                 !2 
OnResult:Agent=StatE_GroupNumberProblem !0
OnResult:HearAgain=ValidateGroupNumber
OnResult:Repeat=ValidateGroupNumber     !*  Not really needed, internal to CCS
OnDTMFError=OnDTMFErrorValidateGroup
OnOtherResult=OnOtherResultValidateGroup
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="SuccessMsg"
ConfidenceThreshold=30
FlushKeys=true

[OnDtmfErrorValidateGroup]
type=Play
Msg="TryAgainDTMF"
Next=ValidateGroupNumber

[OnOtherResultValidateGroup]
type=play
msg="TryAgain"
Next=ValidateGroupNumber

[OnDtmfErrorValidateGroupShiftDTMF]
type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec3]
type=EndRecognitionSession

[StatE_DTMF3]
Type=Log
LogMsg="Change to DTMF"
Next=ValidateGroupNumber

[PrePendZero]
type=changeVariable
Jury_Group = "0"%Jury_GroupNumberInput


!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[ReportingInstructions]   ! page 009
Type=Log
LogMsg="Get Group Instr"

[LogJuryGroupNumber]
type=log
var=Jury_Group

!retrieve Group Reporting Instructions----
[GetGroupReportingInstructions]
type=ExecuteRoutine
DLL="SonantJsiCvpClient.DLL"
Routine="Jury_GetGroupReportingInstructions"
OnExecuteError=GroupInfoError2

[GroupFoundCheck]   
Type=Branch
Var=Jury_Result
0=InstructionsAvailable
Next=StatE_GroupNumberNotFound

[GroupInfoError2]
Type=Log
LogMsg="Error: Group Info"
Next=StatE_SystemError

[IncrementGroupRetryCounter]
Type=ChangeVariable
increment=RetryCounter

[CheckGroupRetryCounter]
Type=Branch
Var=RetryCounter
3=StatE_GroupNumberProblem
Next=GroupNumberInput
! Jury_GroupReportingInstructions is NOT true/false
! 0 - Disabled, 1 - Available, 2 - Not Available
! Available = 0
! Not Available = 1
! Disabled =2 
!


!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[InstructionsAvailable] ! page 10
Type=Branch
Var=Jury_GroupReportingInstructionsAvailable
0=ServiceCompletedCheck      
1=StatE_NoReportingInstructions
2=StatE_Disabled
Next=StatE_NoReportingInstructions

[StatE_Disabled]
type=log
logmsg="Group # Disabled"
Next=StatE_GroupNumberNotFound

[ServiceCompletedCheck]  
Type=Branch
Var=Jury_GroupServiceCompleted
1=StatE_ServiceComplete

[RequiredToReportCheck]  
Type=Branch
Var=Jury_GroupRequiredToReport
1=StatE_RequiredToReport

[CallbackRequiredCheck]  
Type=Branch
Var=Jury_GroupCallbackRequired
1=StatE_CallbackRequired   

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[StatE_GroupNumberNotFound] ! Page 11
type=log
logmsg="Group # Not Found"

[GroupNumberNotFoundMenu]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
promptMsg="GroupNumberNotFound"
promptMsgDTMF="GroupNumberNotFoundDTMF"
grammar="ReEnterID.grxml"
OnKey1=IncrementGroupRetryCounter
OnKey0=SetScreenMsgGroupNumberNotFound
OnKeyStar=GroupNumberNotFoundMenu
OnResult:Reenter=IncrementGroupRetryCounter 
OnResult:Agent=SetScreenMsgGroupNumberNotFound 
OnResult:HearAgain=GroupNumberNotFoundMenu
OnResult:Hangup=Goodbye
MaxRetryCount=2
OnMaxRetries=StatE_Sorry
OnDTMFError=Exit 
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
BadKeyMsg="InvalidSelection"
SuccessMsg="Thanks"

[SetScreenMsgGroupNumberNotFound]
type=changeVariable
ScreenMsg="Requested Agent: Group# Not Found"
Next=ACDAvailable

