[DateReschedule]   ! page 048
Type=Branch
Var=Jury_JurorID
""=GetJurorID
0=GetJurorID

[DateReschedule2]
type=VariableManager
VarList="DateRetryCount"
OnError=LogGetVMVariablesFailureForDateReschedule

