[testlogmsgs] !@@##
Type=Log
LogMsg="JurorID="%Jury_JurorID%", ChangeCount="%Jury_ScheduleChangeCount%", EligibleToResched="%Jury_EligibleToReschedule%", ContinuanceAllowed="%Jury_ContinuanceAllowed%", FTARescheduleAllowed="%Jury_FTARescheduleAllowed

[CheckJurorID] ! If no juror ID, no rescheduling
Type=branch
var=Jury_JurorID
""=SetMenuOption1a
0=SetMenuOption1a

[CheckChangeCount]
type=changevariable
Jury_ScheduleChangeCount=0
!  L@@K RR 3/24/10 why is it checking the number of times through??? Make VM count?

[CheckChangeCountOrig]
Type=Branch
Var=Jury_ScheduleChangeCount
0=CheckReschEligibility
OnBelowRange=SetMenuOption1a
OnAboveRange=SetMenuOption1a


[CheckReschEligibility]
type=log
var=Jury_EligibleToReschedule

[CheckEligibleToReschedule]
Type=Branch
Var=Jury_EligibleToReschedule
0=SetMenuOption1a	

[SetMenuOption1]
Type=ChangeVariable
@PlayOption1=1
Next=CheckEligibleForExcusal

[SetMenuOption1a]
Type=ChangeVariable
@PlayOption1=0
Next=CheckEligibleForExcusal

[CheckEligibleForExcusal]
type=log
var=Jury_EligibleForExcusal

[CheckEligibleForExcusalbranch]
Type=Branch
Var=Jury_EligibleForExcusal
0=SetNoExcusal
	
[SetEligibleForExcusal]
type=ChangeVariable
@PlayOption2=1
Next=SetOtherOptions

[SetNoExcusal]
type=ChangeVariable
@PlayOption2=0
Next=SetOtherOptions

[SetOtherOptions]
type=branch
var=JurorState
"IorP"=SetOptsIorP
"CorB"=SetOptsCorB
"F"=SetOptsF
"Unknown"=SetOptsUnknown

[SetOptsIorP]
type=changeVariable
@playOption3=1	! Work Cert
@playOption4=1	! Payment Info
@playOption5=1	! FAQs
@playOption6=1	! Check Status
Next=MainMenu

[SetOptsCorB]
type=changeVariable
@playOption3=1	! Work Cert
@playOption4=1	! Payment Info
@playOption5=1	! FAQs
@playOption6=0	! Check Status
Next=MainMenu

[SetOptsF]
type=changeVariable
@playOption3=1	! Work Cert
@playOption4=1	! Payment Info
@playOption5=1	! FAQs
@playOption6=0	! Check Status
Next=MainMenu

[SetOptsUnknown]
type=changeVariable
@playOption3=0	! Work Cert
@playOption4=0	! Payment Info
@playOption5=1	! FAQs
@playOption6=0	! Check Status
Next=MainMenu

