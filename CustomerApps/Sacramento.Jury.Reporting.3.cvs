Next=BTPauseBeforePutSecondCallOnHold

[LogCallBTError]
type=Log
Logmsg="CallResult = "%CallResult
Next=BTError

[BTPauseBeforePutSecondCallOnHold]
type=Pause
PauseMSec=500

[BTTakeCallOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=BTError

[BTStopOnHoldPlay]
type=play
flushplayqueue=true

[BTBridgeCalls]
type=CallControl
Command=Bridge
OnError=LogCallControlBridgeTransferError
Next=HangupCall

