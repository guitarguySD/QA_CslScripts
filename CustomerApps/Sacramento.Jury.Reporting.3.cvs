msg=PerjuryNoticeMsg

[PerjuryMenu2]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
PromptMsg="PerjuryMenu"
PromptMsgDTMF="PerjuryMenuDTMF"
grammar="YesNoStaff.grxml"
!HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Yes=GetPossibleDeferralDates
OnResult:No=StatE_RequestExcuse
OnResult:Repeat=PerjuryMenu2
OnResult:Back=StatE_RequestExcuse
OnResult:Hangup=Goodbye
OnResult:HearAgain=PerjuryMenu2
OnResult:Agent=SetScreenMsgPerjuryMenu
OnResult:MainMenu=ConstructMainMenu
Onkey1=GetPossibleDeferralDates
Onkey2=StatE_RequestExcuse
OnkeyStar=PerjuryMenu2
OnDTMFError=StatE_Sorry
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
ConfidenceThreshold=30
SuccessMsg="OK"

! This routine is a stored procedure in a local sql server db called Utilities.
! It gets a set of dates, three Thursdays six months out.
! The script attempts to defer to each of these sequentially. If the first fails, it tries the next.
! After the three tries, it goes down an error path. 
! The day of the week is hard coded in the stored procedure but it's a simple parameter. 
[GetPossibleDeferralDates]
type=database
DataDefinition=GetPotentialDeferralDates
Command=Execute
OnNoData=ProblemGettingDeferralDates
OnDbError=LogDbError21
Next=LogAutoPostponement

[LogDbError21]
type=log
var=@Result,@ResultMessage,Jury_Result,Jury_ResultMessage

[ProblemGettingDeferralDates]
type=changevariable
screenMsg="Autopostonement failed"

[PlayProblemPostponingMessage]
type=play
msg="SystemProblem2"
NExt=ACDAvailable

[LogAutoPostponement]   
type=log
var=Jury_JurorID,Jury_ReportingDate,DeferralDate1,DeferralDate2,DeferralDate3

[SetPostponementVars]
Type=ChangeVariable
Jury_TypeCode=Jury_TypeCode
Jury_ReasonCode=Jury_ReasonCode
Jury_NewReportingDate=DeferralDate1
DeferralAttempt=1

[LogPostponementDate]
type=log
var=Jury_JurorID,Jury_NewReportingDate

[PostponementCheckTestMode]
type=branch
var=JSITestMode
3=SetPostponementTestVars
Next=PostponementDLLCall

[SetPostponementTestVars]
type=changeVariable
Jury_Result=0
Next=CheckPostponementResultBranch

[PostponementDLLCall]
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.dll"
Routine="Jury_UpdateReportingDate"
OnExecuteError=StatE_PostponementError
Next=CheckPostponementResult

[StatE_PostponementError]
Type=Log
LogMsg="Error: Autopostpone"
Next=StatE_SystemError

[CheckPostponementResult]
Type=Log  
logmsg="DATE Jury_Result="%Jury_Result%", JurorID="%Jury_JurorID%", ChangeCount="%Jury_ScheduleChangeCount%", EligibleToResched="%Jury_EligibleToReschedule%", ContinuanceAllowed="%Jury_ContinuanceAllowed%", FTARescheduleAllowed="%Jury_FTARescheduleAllowed

[CheckPostponementResultBranch]
Type=Branch
Var=Jury_Result
0=PostponementSuccessful
25=RetryPostponement
28=RetryPostponement
29=RetryPostponement
30=RetryPostponement
31=RetryPostponement
32=RetryPostponement
Next=ProblemGettingDeferralDates

[RetryPostponement]
type=changeVariable
increment=DeferralAttempt

[CheckDeferralAttempt]
type=branch
var=deferralAttempt
2=SetSecondDate
3=SetThirdDate
OnAboveRange=ProblemGettingDeferralDates

[SetSecondDate]
type=changeVariable
Jury_NewReportingDate=deferralDate2
Next=LogPostponementDate

[SetThirdDate]
type=changeVariable
Jury_NewReportingDate=deferralDate3
Next=LogPostponementDate

!=====================================================
! 
! Postponement Successful - page 95
! 
[PostponementSuccessful]
Type=play
msg="SummonsDateChanged"
msgstring=Jury_NewReportingDate%"|D|ddd mmm dd yyyy"
msg=DisqualificationMessage

[AutoPostponementSuccessfulMenu]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
PromptMsg="MustSubmitOnWebMenu"
PromptMsgDTMF="MustSubmitOnWebDTMFMenu"
grammar="WrapUp.grxml"
!HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnKey1=ExecuteRecordRetrieval
OnKey2=Goodbye
OnKey0=SetScreenMsgPostponementSuccessful
OnKeyPound=PostponementSuccessful
OnResult:Inquiries=DBAvailable        			!1
OnResult:Hangup=Goodbye                  			!2 
OnResult:Agent=SetScreenMsgPostponementSuccessful	!0
OnResult:Repeat=AutoPostponementSuccessfulMenu
OnResult:HearAgain=AutoPostponementSuccessfulMenu
OnDTMFError=Exit
OnOtherResult=OnOtherResultPostponementSuccessful
MaxRetryCount=2
BadKeyMsg="InvalidSelection"
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
ConfidenceThreshold=30
SuccessMsg="SuccessMsg"

[SetScreenMsgPostponementSuccessful]
type=changeVariable
ScreenMsg="Requested Agent: Autopostponement"
Next=ACDAvailable

[OnDtmfErrorPostponementSuccessful]
type=Play
Msg="TryAgainDTMF"
Next=PostponementSuccessful

[OnOtherResultPostponementSuccessful]
type=play
msg="TryAgain"
Next=PostponementSuccessful

[OnDtmfErrorPostponementSuccessfulShiftDTMF]
type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec_PostponementSuccessful]
type=EndRecognitionSession

[StatE_DTMFPostponementSuccessful]
Type=Log
LogMsg="Change to DTMF"
Next=PostponementSuccessful

!======================================
! Self test - simple record retrieval
! 
[SelfTest]
type=log

[SelfTestInitialize]
type=ExecuteRoutine
DLL="SonantJsiCvpClient.DLL"
Routine="Jury_Initialize"
OnExecuteError=SelfDLLInitializeFailure

[SetTestCaseVariables]
type=changeVariable
Jury_JurorID="001234567"

[SelfTestExecute]
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.dll"
Routine="Jury_GetJurorRecord"
OnExecuteError=SelfTestExecuteFailure

[LogSelfTest]
type=log

[SelfTestCheckRetrieveResult]  
Type=Branch
Var=Jury_Result
0=SelfTestSuccess
25=SelfTestRecordNotFound
23=SelfTestRecordNotFound
Next=SelfTestRecordRetrievalError

[SelfTestSuccess]
type=pause
pausesec=1

[SelfSendSuccess2]
type=dial
dialstring="1111"
Next=HangupCall


!-------------------------
! Record Not found 
[SelfTestRecordNotFound]
type=pause
pausesec=1

[SelfTestRNF2]
type=dial
dialstring="2222"
logblock=true
UseInbandDtmf=false
Next=HangupCall

!-------------------------
! Execute error
[SelfTestExecuteFailure]
type=pause
pausesec=1

[SelfTestExecuteFailure2]
type=dial
dialstring="3333"
logblock=true
UseInbandDtmf=false
Next=HangupCall


!------------------------
! DLL Initialize failure
[SelfDLLInitializeFailure]
type=pause
pausesec=1

[SelfDLLInitFailure]
type=dial
dialstring="4444"
logblock=true
UseInbandDtmf=false
Next=HangupCall

!------------------------
! Record retrieval error
[SelfTestRecordRetrievalError]
type=pause
pausesec=1

[SelfTestRecordRetrievalError2]
type=dial
dialstring="5555"
logblock=true
UseInbandDtmf=false
Next=HangupCall

!===================================
! End Routines
!===================================

[Exit]
type=play
msg="ThankYou"

[Goodbye]
type=play
msg="Goodbye"
msg="Silence"
WaitForMsg=True

[EndCall]
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.DLL"
Routine="Jury_Disconnect"
OnExecuteError=HangupCall

[HangupCall]
type=Log

!type=CallControl        !removed to help prevent hung disconnects
!Command=Disconnect

[TerminateCall]
type=Terminate
