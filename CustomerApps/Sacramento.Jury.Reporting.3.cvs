type=log
logmsg="DateReschedule VM Failure Result = "%VT_Result

[SetDateRetryCountDateRescheduleFailure]
Type=ChangeVariable
DateRetryCount=3

[PlayRescheduleDate]
type=play
msg="SelectAnyMonday"

[GetRescheduledDate]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
PromptMsg="RescheduleMenu"
PromptMsgDTMF="RescheduleMenuDTMF"
!grammar="Date1"
grammar="SixDigitDate.grxml"
!EndPointerEndMSec=1200
HelpMsg="DateHelp"
Var=Jury_NewReportingDate
ResultFormat=Digits
MaxRetryCount=2
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
DTMFTerminator="#"
ShiftToDTMFMsg="ShiftToDTMF"
ResultLengthMin=6
MinDigitsMsg="LengthErrorMsg"
ResultLengthMax=6
MaxDigitsMsg="ExpectingSixDigits"
OnkeyStar=GetRescheduledDate
OnkeyPound=CheckForOperatorRequest
OnDTMFError=SetScreenMsgForRescheduleOnError
!OnDTMFTimeout=SetScreenMsgForReschedule
BadKeyMsg="InvalidSelection"
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="Thanks"
ConfidenceThreshold=30
Next=VerifyRescheduleDate

[VerifyRescheduleDate]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
PromptMsg="YouSaid",Jury_NewReportingDate|D|"ddd mmm dd yyyy","YesOrNoMenu"
PromptMsgDTMF="YouEntered",Jury_NewReportingDate|D|"ddd mmm dd yyyy","YesOrNoMenuDTMF"
grammar="YesNoStaff.grxml"
OnResult:"Yes"=UpdateDate
OnResult:"No"=GetRescheduledDate
OnResult:Agent=SetScreenMsgForReschedule
