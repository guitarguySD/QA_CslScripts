Next=TransferToTrialDepartment

[SetTransferToDept4]
type=ChangeVariable
Extension="9168745527"
Next=TransferToTrialDepartment

[SetTransferToDept5]
type=ChangeVariable
Extension="9168745911"
Next=TransferToTrialDepartment

[SetTransferToDept10]
