[StatE_Admin]   ! page 140
type=log
logmsg="Admin"

[AdminFunctions]
type=GetDigits
Var=EnteredRecordPassword
msg="Silence"
MinDigits=4
MaxDigits=4
Terminator=""
MaxTimeouts=0
TimeoutSec=6
OnMaxTimeouts=Goodbye
OnKeyPound=Goodbye
OnKeyStar=Goodbye

[CompareAdminPassword]
type=branch
var=EnteredRecordPassword
RecordPassword=StatE_RecordPhrase
TestModePassword=StatE_TestMode
!"2008"=StatE_TestCall
!"8888"=PaymentInfoMenu
!"9999"=SetFTAVars
!"1111"=TestTimePlay
!"1122"=StatE_RequestExcuse
!"9438"=Test_StartRNFTest
"3456"=SelfTest
!"7335"=Test_SetDBUp
"8888"=TestJuryGroupReporting
Next=Goodbye

!-------------------------------------------
[TestJuryGroupReporting]
type=log

[SetJuryGroup]
type=changeVariable
Jury_Group="0110"
JGR_Group="0110"

[GetGroupReportingInstructions2]
type=ExecuteRoutine
DLL="JuryGroupReporting.dll"
Routine="JGR_GetGroupReportingInformation"
OnExecuteError=GroupINIErrorTest

[LogReportingDatesTest]
type=log
logmsg="JurorID="%Jury_JurorID%", Jury_ReportingDate = "%Jury_ReportingDate%",JGR_GroupReportingDate ="%JGR_GroupReportingDate
Next=Goodbye

[GroupINIErrorTest]
Type=Log
LogMsg="Error: Group Info"
Next=Goodbye

