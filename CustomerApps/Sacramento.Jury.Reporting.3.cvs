[SetRetryCounter]
Type=ChangeVariable
RetryCounter=3

[RecordSelectMenu]
type=menu
msg="RecordMenuOptionalGreeting"
BadKeyMsg="TryAgainDTMF"
MaxBadKeys=3
OnKey1=RecordOptionalGreeting
OnKey2=JuryRecordLanguage
OnKeyPound=BumpRetryCounter
OnKeyStar=BumpRetryCounter
Next=Goodbye

[BumpRetryCounter]
