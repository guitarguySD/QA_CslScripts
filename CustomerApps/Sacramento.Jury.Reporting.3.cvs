[CheckMenuRetry]
Type=Branch
Var=MenuRetry
3=SetScreenMsgForMainMenuTooManyErrors
Next=MenuRetry

[SetScreenMsgForMainMenuTooManyErrors]
Type=ChangeVariable
ScreenMsg="Problem with Main Menu"
Next=StatE_Sorry


!==========================================================
! Check Status
!
[StatE_CheckStatus]
type=log
logmsg="Check Status"

[CheckNoticeStatus]
type=branch
var=Jury_NoticeStatus
"P"=SetNoticeMsgToPlay
"T"=SetNoticeMsgToPlay
Next=SetNoMessageToPlay

[SetNoMessageToPlay]
type=ChangeVariable
Notice="Notice_NoMessage"
Next=PlayNoticeMsg

[SetNoticeMsgToPlay]
type=log
logmsg="Pending Notice"

[SetMsgToPlay]
type=changeVariable
Notice="Notice_"%Jury_ActivityType%Jury_ActivityReason

[LogNoticeMsgCode]
type=log
logmsg="Pending status, Notice message = "%Notice

[CheckForPlayNoticeMsg]
type=branch
var=Notice
"Notice_ADCD"=PlayNoticeMsg
"Notice_AFFH"=PlayNoticeMsg
"Notice_AMMT"=PlayNoticeMsg
"Notice_ASST"=PlayNoticeMsg
"Notice_NoMessage"=PlayNoticeMsg
Next=SetNoMessageToPlay

[PlayNoticeMsg]
type=play
msg=Notice

[PlayNoticeMsgMenu]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
PromptMsg="PaymentInfoMenu"
PromptMsgDTMF="PaymentInfoMenuDTMF"
grammar="PaymentInfo.grxml"
!HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:MainMenu=ConstructMainMenu
OnResult:HearAgain=PlayNoticeMsg
OnResult:Repeat=PlayNoticeMsg
OnResult:Agent=SetScreenMsgForCheckStatus
OnResult:PreviousMenu=ConstructMainMenu
OnResult:Hangup=Goodbye
OnKey1=ConstructMainMenu
OnKey0=SetScreenMsgForPaymentInfo
OnKeyStar=CheckPaymentInfoAvailable
OnDTMFError=StatE_Sorry
OnOtherResult=PlayNoticeMsg
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
ConfidenceThreshold=30
SuccessMsg="OK"

[SetScreenMsgForCheckStatus]
Type=ChangeVariable
ScreenMsg="Requested Staff: Check Status"
Next=ACDAvailable



