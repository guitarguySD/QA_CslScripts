Msg="SpeakToStaff"
MsgString=OperatorOpen%"|D|h:n a/p"
Msg="To"
MsgString=OperatorClosed%"|D|h:n a/p"
Msg="MondayThroughFriday"
Next=IncrementMenuRetry

[MainMenuReschedule]
