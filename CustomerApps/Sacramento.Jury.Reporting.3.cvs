Next=Exit

[GetJurorIDBlock]
type=Recognize
NoInputTimeOutMSec=10000
RecognizeFailureMsg="SpeechRecSystemError"
IntroMsg="GetIDIntro"
IntroMsgDTMF="GetIDIntro"
PromptMsg="EnterJurorID"
PromptMsgDTMF=EnterJurorIDMsg
!grammar="JurorIDNumber"
grammar="builtin:grammar/digits?minlength=7;maxlength=7"
!EndPointerEndMSec=1200
HelpMsg="StandardHelp"
DTMFTerminator="#"
MinDigitsMsg="ExpectingSevenDTMF"
MaxDigitsMsg="ExpectingSevenDTMF"
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Agent=SetScreenMsgForGetID
OnKeyStar=GetJurorID
Var=Jury_JurorID
ResultFormat=Digits
ResultLengthMin=7
ResultLengthMax=10
!OnRecognitionError=SetScreenMsgForGetIDOnError
!OnDTMFTimeout=SetScreenMsgForGetIDOnError
OnDTMFError=SetScreenMsgForGetIDOnError
MaxRetryCount=3
BadKeyMsg="InvalidSelection"
!TimeoutMsg="Timeout"
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="Thanks"
ConfidenceThreshold=30
Next=CheckJurorIDLength
{
[CheckJurorIDLength]
type=branch
var=@recognizeLength
7=RetrieveRecord
8=RetrieveRecord
9=RetrieveRecord
Next=JurorIDIncrementRetry
}
[CheckJurorIDLength]
type=branch
var=@recognizeLength
7=VerifyBadgeNumber
8=VerifyBadgeNumber
9=VerifyBadgeNumber
Next=JurorIDIncrementRetry

[VerifyBadgeNumber]
type=log
