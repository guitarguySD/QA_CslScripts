!======================================
! Submit Qualification Responses
! 
[U_SubmitQualificationResponses]
type=log

[CheckAnswerSum]
type=Branch
var=DisqualifyingAnswersCount
!0=U_ExecuteProcessQualification
0=PenaltyOfPerjuryMenu
OnAboveRange=PlayDisqualificationConfirmation

[PlayDisqualificationConfirmation]
type=play
msg="MayNotBeQualified"
msg=DisqReason1
msg=DisqReason2
msg=DisqReason3
msg=DisqReason4
msg=DisqReason5
msg=DisqReason6
msg=DisqReason7
msg=DisqReason8

[PenaltyOfPerjuryMenu]
type=menu
Msg="PerjuryMenuDTMF"
OnKey1=LogQualInput
OnKey2=SendBackToInterview
OnKeyStar=PenaltyOfPerjuryMenu
OnKeyPound=PlayDisqualificationConfirmation

[LogQualInput]
type=log
!var=JurorID,DisqReason1,DisqReason2,DisqReason3,DisqReason4,DisqReason5,DisqReason6GJ,DisqReason6,DisqReason7,DisqReason8

[U_ExecuteProcessQualification]
type=RestApi
Method=POST
Url=ProcessQualificationEndpoint
Method=POST
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        personId = vars["CT_JurorID"],
        answers = new[] {
            new { questionId = "Qualification_IVR_1", value = vars["Q1Answer"] },
            new { questionId = "Qualification_IVR_2", value = vars["Q2Answer"] },
            new { questionId = "Qualification_IVR_3", value = vars["Q3Answer"] },
            new { questionId = "Qualification_IVR_4", value = vars["Q4Answer"] },
            new { questionId = "Qualification_IVR_5", value = vars["Q5Answer"] },
            new { questionId = "Qualification_IVR_6", value = vars["Q6Answer"] },
            new { questionId = "Qualification_IVR_7", value = vars["Q7Answer"] },
            new { questionId = "Qualification_IVR_8", value = vars["Q8Answer"] }
        }
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    
    // Root level
    vars["CT_ResultCode"] = root.TryGetProperty("status", out var status) ? status.GetString() ?? "" : "";
    vars["CT_ResultMessage"] = root.TryGetProperty("errorCode", out var errorCode) ? errorCode.GetString() ?? "" : "";
    
    // jurorInformation block
    if (root.TryGetProperty("jurorInformation", out var jurorInformation))
    {
        vars["CT_QualificationStatus"] = jurorInformation.TryGetProperty("qualificationStatus", out var qualificationStatus) ? qualificationStatus.GetString() ?? "" : "";
    }
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogProcessBioFormError
Next=CheckAPIResult_ProcessQualification

[CheckAPIResult_ProcessQualification]
type=Branch
var=ApiSuccess
true=CheckPQResult
false=LogProcessQualificationAPIError

[LogProcessQualificationAPIError]
type=log
var=CT_JurorID,ApiStatusCode,ApiSuccess,ApiError,CT_ResultCode,CT_ResultMessage
Next=StatE_SystemError


[CheckPQResult]
type=branch
var=CT_ResultCode
OK=U_CheckQualificationStatus
Next=LogPQProblem

[LogPQProblem]
type=log
logmsg="Execute Process Qualification Failed"
var=CT_ResultCode,CT_ResultMessage
Next=StatE_SystemError

[U_CheckQualificationStatus]
type=branch
var=CT_QualificationStatus
"Qualified"=U_CompletedQualified
"Disqualified"=U_CompletedDisqualified
"Pending Review"=U_CompletedDisqualPendingReview
Next=StatE_SystemError

!--------------------------------
! Completed Questionnaire, Qualfied
! 
[U_CompletedQualified]
type=play
WaitForMsg=true
msg="ThanksQualified"
!msg="UBeSureToCall1"
!msgString=CourtPhoneNumber
!msg="UBeSureToCall2"
msg="PleaseHoldRecordRefresh"
Next=GetJurorRecord

!-----------------------------------
! Completed Questionnaire, Disqualified
! 
[U_CompletedDisqualified]
type=play
msg="UThanks"
msg="PleaseHoldRecordRefresh"
WaitForMsg=true
Next=GetJurorRecord

!----------------------------------------
! Completed Questionnaire, pending review of disqual request
! 
[U_CompletedDisqualPendingReview]
type=play
WaitForMsg=true
msg="DisqualRequestReceived"

[U_CheckDisqualPendingMessage]
type=Branch
var=DisqualPendingMessage
"None"=GetJurorRecord

[U_DisqualPendingMessage]
type=menu
msg=DisqualPendingMessage
msg="DisqualPendingMenu"
OnKeyStar=U_CompletedDisqualPendingReview
OnKey1=GetJurorRecord
OnKey9=Exit
OnKey0=SetScreenMsgForDisqualPending
Next=GetJurorRecord


[SetScreenMsgForDisqualPending]
type=ChangeVariable
ScreenMsg="Disqual Pending"
Next=ACDAvailable

!----------------------------------------------
! Reset Qualification interview

[SendBackToInterview]
type=changeVariable
increment=RetryCounter

[CheckInterviewRetry]
type=branch
var=RetryCounter
2=UnableCompleteRegistration

[PlayTakeYouBack]
type=play
msg="BackThruInterview"

[ResetInterviewAnswers]
type=changeVariable
Q1Answer=""
Q2Answer=""
Q3Answer=""
Q4Answer=""
Q5Answer=""
Q6Answer=""
Q7Answer=""
Q8Answer=""
DisqualifyingAnswersCount=0
DisqReason1=""
DisqReason2=""
DisqReason3=""
DisqReason4=""
DisqReason5=""
DisqReason6=""
DisqReason7=""
DisqReason8=""
DisqualPendingMessage="None"
Next=UnqualifiedInterviewRetry

[UnableCompleteRegistration]
type=log

[PlaySorryUnableComplete]
type=play
msg="Sorry"
Next=ACDAvailable

! 
! End Eligibility & Bio Info Questionnaire
!=========================================================


