!------------------------------
! Submit BioInfo Answers
!------------------------------

[U_LogBioAnswers]
type=log
var=CT_JurorID,BQ1Answer,BQ2Answer,BQ3Answer,BQ4Answer,BQ5Answer,BQ6Answer,BQ7Answer,BQ8Answer,BQ9Answer,BQ10Answer,BQ11Answer,BQ12Answer,BQ13Answer

[LogBioInfoInput] 
type=log
var=CT_JurorID,CT_DOB

[U_ExecuteUpdateBioInfo]
type=RestApi
Method=POST
Url=ProcessBioformEndpoint
Method=POST
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        personId = vars["CT_JurorID"],
        answers = new[] {
            new { questionId = "BioForm_IVR_1", value = vars["CT_BioForm_IVR_1"] },
            new { questionId = "BioForm_IVR_2", value = vars["CT_BioForm_IVR_2"] },
            new { questionId = "BioForm_IVR_3", value = vars["CT_BioForm_IVR_3"] },
            new { questionId = "BioForm_IVR_4", value = vars["CT_BioForm_IVR_4"] },
            new { questionId = "BioForm_IVR_5", value = vars["CT_BioForm_IVR_5"] },
            new { questionId = "BioForm_IVR_6", value = vars["CT_BioForm_IVR_6"] },
            new { questionId = "BioForm_IVR_7", value = vars["CT_BioForm_IVR_7"] },
            new { questionId = "BioForm_IVR_8", value = vars["CT_BioForm_IVR_8"] },
            new { questionId = "BioForm_IVR_9", value = vars["CT_BioForm_IVR_9"] },
            new { questionId = "BioForm_IVR_10", value = vars["CT_BioForm_IVR_10"] },
            new { questionId = "BioForm_IVR_11", value = vars["CT_BioForm_IVR_11"] },
            new { questionId = "BioForm_IVR_12", value = vars["CT_BioForm_IVR_12"] },
            new { questionId = "BioForm_IVR_13", value = vars["CT_BioForm_IVR_13"] }
        }
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    
    // Root level
    vars["CT_ResultCode"] = root.TryGetProperty("status", out var status) ? status.GetString() ?? "" : "";
    vars["CT_ResultMessage"] = root.TryGetProperty("errorCode", out var errorCode) ? errorCode.GetString() ?? "" : "";
    
    // jurorInformation block
    if (root.TryGetProperty("jurorInformation", out var jurorInformation))
    {
        vars["CT_BioComplete"] = jurorInformation.TryGetProperty("bioformCompletionStatus", out var bioformCompletionStatus) ? bioformCompletionStatus.GetString() ?? "" : "";
    }
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogProcessBioFormError
Next=CheckAPIResult_ProcessBioForm

[CheckAPIResult_ProcessBioForm]
type=Branch
var=ApiSuccess

[LogProcessBioFormError]
type=log
var=ApiStatusCode,ApiSuccess,ApiError,CT_ResultCode,CT_ResultMessage
Next=StatE_SystemError

[U_CheckBioInfoResult]
type=branch
var=CT_ResultCode
"OK"=U_CheckBioFormCompletionStatus
Next=StatE_SystemError

[U_CheckBioFormCompletionStatus]
type=branch
var=CT_BioComplete
"Bio Completed"=U_BioCompleted
"Pending Review"=U_BioPendingReview
Next=U_LogBioCompletionError

[U_LogBioCompletionError]
type=log
logmsg="CT_BioComplete not set to permitted value = "%CT_BioComplete
Next=StatE_SystemError

[U_BioPendingReview]
type=log
Next=CompletedBioQuestions


[U_BioCompleted]
type=log

[SetBioInfoCollected]
type=changeVariable
isBioInfoCollected=1
Next=CompletedBioQuestions

[CompletedBioQuestions]
type=branch
var=CT_JurorState
"QUALIFIED"=U_QualifiedComplete
"POOL"=U_HalfwayDone
Next=U_HalfwayDone

[U_QualifiedComplete]
type=play
msg="UThanks"
Next=GenericReportingInfo

[U_HalfwayDone]
type=play
msg="HalfwayDone"

