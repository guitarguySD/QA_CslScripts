Next=SetJurorStateUNKNOWN

[LogVMNeumoError]
type=log
LogMsg="Error retrieving Neumo API UserId and Password variables from Variable Manager"

! CT_JurorState maintains the state of the juror and controls flow
! in the script. 
! 
[SetJurorStateUNKNOWN] 
type=changeVariable
