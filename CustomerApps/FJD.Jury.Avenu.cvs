Next=SetOpeningClosingTimes

[LogVMError1]
type=log

[SetInitialVariablesOnVMError]
type=changeVariable
AssistanceAvailable=0
HolidayToday=0
OperatorClosed="17:00:00"
OperatorOpen="09:00:00"
OpeningTime="09:00:00"
ClosingTime="17:00:00"
ONCALL_START_HOUR="17" 	!This is for the nightly callin window
ONCALL_END_HOUR="10" 		!This is for the nightly callin window
Next=StatE_CallStarts

[SetOpeningClosingTimes]	! This is for ACD variables
type=changeVariable
OpeningTime=OperatorOpen
ClosingTime=OperatorClosed
Next=StatE_CallStarts

[StatE_CallStarts]
type=log
logmsg="Call Starts"

! Check if API is available
! 
!======================================
! Ping endpoint
[PingNeumoAPI]
type=RestApi
Method=POST
Url=PingEndpoint
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"]
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    vars["CT_ResultCode"] = root.GetProperty("status").GetString() ?? "";
    vars["CT_ResultMessage"] = root.GetProperty("errorCode").GetString() ?? "";
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogPingStatus
Next=LogPingStatus

[LogPingStatus]
type=Log
Var=ApiStatusCode,ApiSuccess,ApiError,CT_ResultCode,CT_ResultMessage

[CheckPingStatus]
type=branch
var=CT_ResultCode
"OK"=SetDbUp
Next=SetDBDown

[CheckJSStatusResult]
type=branch
var=@Result
0=SetDBUp
Next=SetDBDown

[SetDBUp]
type=changevariable
HostAvailable=1
Next=CheckOfficeOpen

[SetDBDown]
type=changevariable
HostAvailable=0
HolidayToday=0		!Force Holiday to 0 = False, message not important if DB is down

[PlayDBDown]
type=play
msg="DBDown"

[CheckOfficeOpen]
Type=Branch
Var=AssistanceAvailable 
0=StatE_OfficeClosed
1=StatE_Officeopen			
Next=StatE_Officeopen

[StatE_OfficeOpen]
Type=Log
LogMsg="Office Open"
Next=Greeting

[StatE_OfficeClosed]
Type=Log
LogMsg="Office Closed"
Next=Greeting

