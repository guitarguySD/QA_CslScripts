! Page 29 - Juror Menu
!--------------------------------------------------
[JurorMenu]
type=branch
var=CT_JurorState
"UNKNOWN"=SetUnknownOptions
"Alternate"=SetServingOptions
"Available"=SetPoolOptions
"Disqualified"=SetServiceEndedOptions
"Excused"=SetServiceEndedOptions
"Exempt"=SetServiceEndedOptions
"Juror"=SetServingOptions
"Panel"=SetServingOptions
"Pool"=SetPoolOptions
"PoolReport"=SetPoolOptions
"PoolOnCall"=SetPoolOptions
"Qualified"=SetQualifiedOptions
"QualifiedOnCall"=SetQualifiedOptions
"QualifiedReport"=SetQualifiedOptions
"QualifiedReporting"=SetQualifiedOptions
"Completed"=SetServiceEndedOptions
"Undeliverable"=SetScreenJurorMenuError
"Postponed"=SetServiceEndedOptions
"Responded FTA"=FTA
"Non-Responded FTA"=FTA
"FTA"=FTA
"OSC Issued"=SetScreenJurorMenuError
Next=LogJurorMenuStatusError

[LogJurorMenuStatusError]
type=log
var=CT_JurorID,CT_JurorState
Next=SetScreenJurorMenuError

[SetScreenJurorMenuError]
type=changeVariable
ScreenMsg="Transfer from Main Menu"
Next=ACDAvailable


!--------------------------------------------------
! Juror Menu Options
! 
! 1 - Deferrals
! 2 - FAQs (Always Available)
! 3 - Request an Excusal
! 4 - Payment info
! 5 - Work Cert
! 6 - Enter juror ID
! 9 - Main Menu
! 0 - Assistance
! # - Hear message again
! * - Hear options again
!--------------------------------------------------

!-----------------------------------------------
! Menu options for each STATE.
! 
[SetUnknownOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 1
Next=CheckGlobalDeferrals

[SetCompletedOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
Next=CheckGlobalDeferrals

[SetPoolOptions]
type=changeVariable
@PlayOption1 = CT_EligibleToPostpone
@PlayOption2 = 1
@PlayOption3 = 1
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
Next=CheckGlobalDeferrals

[SetSummonedOptions]
type=changeVariable
@PlayOption1 = CT_EligibleToPostpone
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
Next=CheckGlobalDeferrals

[SetQualifiedOptions]
type=changeVariable
@PlayOption1 = CT_EligibleToPostpone
@PlayOption2 = 1     
!@PlayOption3 = CT_EligibleToExcuse
@PlayOption3 = 1		! For testing
@PlayOption4 = 0     ! 
@PlayOption5 = 0     ! 
@PlayOption6 = 0     ! 
Next=CheckGlobalDeferrals


[SetServingOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 1
@PlayOption5 = 0
@PlayOption6 = 0
Next=JurorMenuBlock


[SetServiceEndedOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0 
@PlayOption4 = 1 
@PlayOption5 = 0
@PlayOption6 = 0 
Next=JurorMenuBlock


!--------------------------------------------------
! If AllowDeferrals is False, turn off Deferrals
! 
[CheckGlobalDeferrals]
type=branch
var=AllowDeferrals
0=SetNoDeferrals
Next=CheckGlobalDisqualifications

[SetNoDeferrals]
type=ChangeVariable
@PlayOption1=0

!---------------------------------------------------------------
! If AllowDisqualifications is False, turn off Disqualifications
! 
[CheckGlobalDisqualifications]
type=branch
var=AllowDisqualifications
0=SetNoDisqualifications
Next=JurorMenuBlock

[SetNoDisqualifications]
type=changeVariable
@PlayOption3 = 0

!---------------------------------------------------------------
! If AllowExcusals is False, turn off Disqualifications
! 
[CheckGlobalExcusals]
type=branch
var=AllowExcusals
0=SetNoExcusals
Next=JurorMenuBlock

[SetNoExcusals]
type=changeVariable
@PlayOption3 = 0
Next=JurorMenuBlock

!--------------------------------------------------
! Page 30 - Juror Menu Block
!--------------------------------------------------
[JurorMenuBlock] 
type=Recognize
PromptMsg="Silence"
PromptMsgDTMF="JurorMenu1"|X|1,"JurorMenu2","JurorMenu3"|X|3,"JurorMenu4"|X|4,"JurorMenu5"|X|5,"JurorMenu6"|X|6,"JurorMenuLast"
OnKey1=StatE_RequestDeferral
OnKey2=StatE_FAQs
OnKey3=StatE_RequestExcusals
OnKey4=StatE_PaymentInfo
OnKey5=StatE_WorkCertificate
OnKey6=GetJurorID
OnKey9=Exit
OnKey0=SetScreenJurorMenuBlock
OnKeyStar=JurorMenu
OnKeyPound=CallerDisposition
FlushKeys=1
MaxRetryCount=3
OnMaxRetries=StatE_Sorry
ShiftToDTMFMsg="ShiftToDTMF"
