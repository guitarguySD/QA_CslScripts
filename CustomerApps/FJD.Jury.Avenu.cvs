! Process the Excusal request
[LogExcusalInput]
type=log
!var=CT_JurorID,CT_DOB,CT_TypeCode,CT_ReasonCode

[ExecuteProcessExcusal]
type=RestApi
Method=POST
url=ProcessExcuseExemptEnpoint
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        jurorID = vars["CT_JurorID"],
        reasonCode = vars["CT_ReasonCode"],
        requestType = vars["CT_RequestType"]
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    
    // Root level
    vars["CT_ResultCode"] = root.TryGetProperty("status", out var status) ? status.GetString() ?? "" : "";
    vars["CT_ResultMessage"] = root.TryGetProperty("errorCode", out var errorCode) ? errorCode.GetString() ?? "" : "";
    
    // jurorInformation block
    if (root.TryGetProperty("jurorInformation", out var jurorInformation))
    {
        vars["CT_EligibleToExcuse"] = jurorInformation.TryGetProperty("eligibleInd", out var eligibleToExcuse) ? eligibleToExcuse.GetBoolean().ToString() : "false";
        vars["CT_ExcuseExemptRequestStatus"] = jurorInformation.TryGetProperty("excuseExemptRequestStatus", out var excuseExemptRequestStatus) ? excuseExemptRequestStatus.GetString() ?? "" : "";
        vars["CT_IneligibleReason"] = jurorInformation.TryGetProperty("inEligibleReason", out var ineligibleReason) ? ineligibleReason.GetString() ?? "" : "";
    }
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogProcessExcusalError
Next=CheckAPIResult_ProcessExcusal

[LogProcessExcusalError]
type=log
var=CT_JurorID,CT_ResultCode,CT_ResultMessage,ApiStatusCode,ApiError,ApiSuccess
Next=StatE_Sorry

! First check status of API call
[CheckAPIResult_ProcessExcusal]
type=branch
var=ApiSuccess
true=CheckProcessExcusalRetrieveResult
Next=LogApiError_ProcessExcusal

[LogApiError_ProcessExcusal]
type=log
var=CT_JurorID,CT_ResultCode,CT_ResultMessage,ApiStatusCode,ApiError,ApiSuccess
Next=StatE_Sorry

