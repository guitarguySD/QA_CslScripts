!--------------------------------------------
! Check Excuse Exemp tDisqualify eligibility
! 
[CheckExcuseEligibility]
type=log
var=CheckExcuseExemptEndpoint

[SetRequestType]
type=changeVariable
CT_RequestType="Excuse"

!========================================
! Check Excuse/Exempt/Disqualify Eligibility
!========================================

[CheckExcuseExemptDisqualify]
type=RestApi
Method=POST
Url=CheckExcuseExemptEndpoint
AuthType=Basic
AuthUsername={NeumoUserId}
AuthPassword={NeumoPassword}
ContentType=application/json
TimeoutSeconds=30
RequestScript="""
    using System.Text.Json;
    var request = new
    {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        jurorID = vars["CT_JurorID"],
        requestType = vars["CT_requestType"]
    };
    return JsonSerializer.Serialize(request);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    vars["CT_ResultCode"] = root.GetProperty("status").GetString() ?? "";
    vars["CT_ResultMessage"] = root.GetProperty("errorCode").GetString() ?? "";
    
    if (root.TryGetProperty("jurorInformation", out var info))
    {
        vars["CT_EligibleToExcuse"] = info.GetProperty("eligibleInd").GetBoolean().ToString();
        var inEligibleReason= info.GetProperty("inEligibleReason").GetString() ?? "";
        if (string.IsNullOrEmpty(ineligibleReason))
        {
            vars["CT_IneligibleReason"] = "";
        }
        else if (ineligibleReason.Equals("IVR_MSG_001", StringComparison.OrdinalIgnoreCase))
        {
            vars["CT_IneligibleReason"] = "It's too close to or past your service date.";
        }
        else
        {
            vars["CT_IneligibleReason"] = ineligibleReason;
        }
        vars["CT_LocationCode"] = info.GetProperty("courtLocationCode").GetString() ?? "";
        vars["CT_LocationName"] = info.GetProperty("courtLocationName").GetString() ?? "";
        vars["CT_requestType"] = info.GetProperty("requestType").GetString() ?? "";
    }
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogCheckExcuseExemptApiError
Next=LogExcuseCheckResult

