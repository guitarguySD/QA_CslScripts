CT_EligibleToExcuse=0
AllowDeferrals = 0
AllowDisqualifications = 0
AllowExcusals=0
Next=VerifyName

[GetPostponementEligibility]
type=RestApi
Method=POST
url=PostponementInfoEndpoint
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        jurorID = vars["CT_JurorID"]
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    
    // Root level
    vars["CT_ResultCode"] = root.TryGetProperty("status", out var status) ? status.GetString() ?? "" : "";
    vars["CT_ResultMessage"] = root.TryGetProperty("errorCode", out var errorCode) ? errorCode.GetString() ?? "" : "";
    
    // jurorInformation block
    if (root.TryGetProperty("jurorInformation", out var jurorInformation))
    {
        vars["PostponeEligible"] = jurorInformation.TryGetProperty("postponeEligible", out var v) ? v.GetString() ?? "" : "";
        vars["PostponeIneligibleReason"] = jurorInformation.TryGetProperty("postponeIneligibleReason", out v) ? v.GetString() ?? "" : "";
        
        if (jurorInformation.TryGetProperty("calculatedPostponeDates", out var postponementDates))
        {
            // Convert date from MMddyyyy format to ISO8601 format
            vars["PostponeDate1"] = postponementDates.GetArrayLength() > 0 && 
                postponementDates[0].GetString()?.Length == 8 &&
                DateTime.TryParseExact(
                    postponementDates[0].GetString(),
                    "MMddyyyy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None,
                    out DateTime dt1)
                ? dt1.ToString("yyyy-MM-ddTHH:mm:ss")
                : "";
                
            vars["PostponeDate2"] = postponementDates.GetArrayLength() > 1 && 
                postponementDates[1].GetString()?.Length == 8 &&
                DateTime.TryParseExact(
                    postponementDates[1].GetString(),
                    "MMddyyyy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None,
                    out DateTime dt2)
                ? dt2.ToString("yyyy-MM-ddTHH:mm:ss")
                : "";
                
            vars["PostponeDate3"] = postponementDates.GetArrayLength() > 2 && 
                postponementDates[2].GetString()?.Length == 8 &&
                DateTime.TryParseExact(
                    postponementDates[2].GetString(),
                    "MMddyyyy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None,
                    out DateTime dt3)
                ? dt3.ToString("yyyy-MM-ddTHH:mm:ss")
                : "";
        }
    }
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogApiError
Next=CheckPostponementInfoAPIResult

[CheckPostponementInfoAPIResult]
type=Branch
var=ApiSuccess
true=CheckPostponementResult
Next=LogApiError ! Error path

[CheckPostponementResult]
type=branch
var=CT_ResultCode
"OK"=LogPPResultCode
Next=SetPostponementIneligible 

[LogPPResultCode]
type=log
var=CT_ResultCode,CT_ResultMessage

[LogPostponementData]
type=log
var=CT_JurorID,CT_ScheduledDate,CT_EligibleToPostpone,PostponeDate1,PostponeDate2,PostponeDate3,CT_ResultCode

! If the API does not return any dates, set postponement ineligible
[CheckPostponementDates]
type=branch
var=PostponeDate1
""=SetPostponementIneligible
Next=CheckExcuseEligibility
