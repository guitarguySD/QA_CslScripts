Next=NoOperator

[NoOperator]
type=Play
msg="NoOperatorAvailable"
msg="HelpDeskHours"
msgstring=HD_OpeningTime%"|D|h:n a/p"
msg="To"
msgstring=HD_ClosingTime%"|D|h:n a/p"
msg="MondayThruFriday"
ttsstring="We are returning you to the main menu"
Next=JurorMenu

[PleaseHold]
type=play
msg="PleaseHoldMsg"
WaitForMsg=True

[logACD1]
type=log
logmsg="Route to ACD"

[SetAcdCallReference]
type=ChangeVariable
@CallReference="AcdCall"

[logACD]
type=log
logtype=ScriptEvent
logmsg="Route to ACD-"%ACD_RouteName

[LogACDRouteName]
type=log
var=ACD_RouteName
Next=RouteCaller

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller.  Note that this block never
!  falls through and executes the Next block.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[RouteCaller]
type=ACD
Command=RouteCall
!OriginationNumber=ACD_OriginationAddress
OriginationNumber=2139720970
RouteName=ACD_RouteName
OnError=AcdRouteError
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnTimeout=RouteTimeout

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call Enters Queue
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[ACDWait1]
!Needed to know if going into queue or not
type=pause
pausesec=1

[LogACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[CheckCaller]
type=ACD
Command=CheckCallStatus
OnError=AcdRouteError
OnTimeout=RouteTimeout

[LogCheckACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[QueuePosition]
type=branch
var=@AcdPositionInQueue
0=YouAreNext
1=CurrentlyOne
OnBelowRange=YouAreNext
OnAboveRange=QueuePositionCheckForBad      !PlayQueuePosition

[YouAreNext]
type=play
msg="NextInQueue"
Next=ACDInQueue

[CurrentlyOne]
type=play
msg="CurrentlyOne"
Next=ACDInQueue

[QueuePositionCheckForBad]  !end dysfunctional calls with bad q position
type=branch
var=@AcdPositionInQueue
CompareType=Integer
999=AcdError
OnBelowRange=PlayQueuePosition
OnAboveRange=AcdError
Next=AcdError

[PlayQueuePosition]
type=play
msg="Currently"
msgstring=@AcdPositionInQueue%"|N"
msg="CallersAhead"

[ACDInQueue]
type=Play
msg="$MusicOnHold1"
msg="Silence"
msg="$MusicOnHold2"
msg="Silence"
msg="$MusicOnHold3"
msg="Silence"
msg="$MusicOnHold4"
msg="Silence"
! Silence is placehold for on hold messages
WaitForMsg=TRUE
Next=CheckCaller


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Call is connecting to ACD Agent.  Play ring. 
!     Queue 4 rings (4X6 sec) to limit logging.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnecting]
type=Play
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
WaitForMsg=TRUE
Next=AcdAgentConnecting


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call is connected to ACD Agent
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnected]
type=Pause
PauseSec=60
next=AcdAgentConnected


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call has returned from ACD 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnFromAcd]
type=Branch
var=@AcdRouteCode
1=CallReturnErrorRoute
2=CallReturnDefaultRoute
3=QueueShutdown
4=QueueFull
5=EndCall	
6=CallReturnAgentTransfer	
7=CallReturnReleaseKeyPressed
8=CallReturnConferenceConnected
9=CallReturnAgentAwol
11=JurorMenu
53=EndCall  
OnBelowRange=AcdError
OnAboveRange=AcdError
logblock=true
Next=AcdError


[CallReturnErrorRoute]
type=Log
LogMsg="Error Route"
Next=QueueShutdown

[CallReturnDefaultRoute]
type=Log
LogMsg="DefaultRoute"
Next=QueueShutdown

[QueueShutdown]
type=Play
msg="QueueShutdown"

[logQueueShutdown]
type=log
logType=ScriptEvent
logmsg="Queue Shutdown"
Next=Exit

[QueueFull]
Type=Play
msg="QueueFull"

[logQueueFull]
type=log
logtype=ScriptEvent
logmsg="QueueFull"
Next=Exit

[CallReturnAgentTransfer]
type=log
logmsg=ACD_Agent
next=ACDInQueue
	
[CallReturnReleaseKeyPressed]
type=log
logmsg="Release Key Pressed"

[AgentPressedRelease]
type=Pause
PauseSec=60
Next=AgentPressedRelease

[CallReturnConferenceConnected]
type=Log
LogMsg="ConferenceConnected"
next=Exit

[RouteTimeout]
type=Play
msg="AcdTimeout"
next=Exit


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller after AWOL
!  Uses Urgent priority.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnAgentAwol]
type=log
logmsg="AWOL"

[RouteCallerAfterAwol]
type=ACD
Command=RouteCall
!OriginationNumber=ACD_OriginationAddress
OriginationNumber=2139720970
RouteName=ACD_RouteName
Priority="Urgent"
OnError=AcdRouteError
next=PauseAfterAWOL

[PauseAfterAWOL]
type=Pause
PauseSec=1

[CheckCallerAfterAWOL]
type=ACD
Command=CheckCallStatus
OnError=AcdError
OnTimeout=AcdError

[QueuePositionAfterAwol]  !end dysfunctional calls with bad q position
type=branch
var=@AcdPositionInQueue
CompareType=Integer
999=AcdError
OnBelowRange=ACDInQueue
OnAboveRange=AcdError
Next=AcdError

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Agent Routes
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[AcdRouteError]
type=Play
FlushPlayQueue=True
Msg="QueueShutdown"
Next=CheckLoopingError

[AcdError]
type=Play
FlushPlayQueue=True
msg="SystemProblem"
WaitForMsg=TRUE
Next=Exit

[CheckLoopingError]
type=branch
var=ErrorCounter
1=Exit
OnAboveRange=Exit
Next=Sorry

[Sorry]
type=Play
ttsstring="We are sorry that you are having trouble. We will now disconnect the call. Please call back later."
WaitForMsg=TRUE
Next=Exit

!--------------------------------------------------
! Page 43 - Admin
!--------------------------------------------------
[StatE_Admin]
type=log
logmsg="Admin"

[AdminFunctions]
type=GetDigits
Var=EnteredRecordPassword
!msg="EnterPassword"
msg="Silence"
MinDigits=4
MaxDigits=4
Terminator=""
MaxTimeouts=0
TimeoutSec=6
OnMaxTimeouts=HangupCall
OnKeyPound=HangupCall
OnKeyStar=HangupCall
Next=CompareAdminPassword

[CompareAdminPassword]
type=branch
var=EnteredRecordPassword
1234=PlayMessagesTest
RecordPassword=StatE_RecordPhrase
Next=Goodbye

[PlayMessagesTest]
type=Play
msg="JuryIdMenu"
Next=Goodbye

[StatE_RecordPhrase]
type=log
Next=Goodbye

!===================================
! End Routines
!===================================
[EndCall]
type=log

[Exit]
type=play
msg="ThankYou"
WaitForMsg=True

[Goodbye]
type=play
msg="Goodbye"
WaitForMsg=True
Next=HangupCall

[HangupCall]
type=CallControl
Command=Disconnect

[TerminateCall]
type=Terminate
!!End Of Script Nothing Goes Below This
