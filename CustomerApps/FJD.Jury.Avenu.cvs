[ResetEnglishLanguage]
type=SetGlobals
Language="English"

[GetInitialVariables]
type=VariableManager
VarList="AssistanceAvailable,OperatorOpen,OperatorClosed,HostAvailable,ONCALL_START_HOUR,ONCALL_END_HOUR,CourtPhoneNumber,CourtFaxNumber"
