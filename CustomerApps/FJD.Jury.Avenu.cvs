!--------------------------------------------------
! Page 32
!--------------------------------------------------
[PostponementConfirmation]
type=log
var=CT_JurorID,CT_SelectedDate

[ExecutePostponementConfirmation]
type=RestApi
Method=POST
Url=PostponementConfirmationEndpoint
RequestScript="""
    using System.Text.Json;
    
    // Convert CT_SelectedDate from ISO8601 format to MMddyyyy format
    string selectedDateFormatted = "";
    if (!string.IsNullOrEmpty(vars["CT_SelectedDate"]) &&
        DateTime.TryParse(vars["CT_SelectedDate"], out DateTime parsedDate))
    {
        selectedDateFormatted = parsedDate.ToString("MMddyyyy");
    }
    
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        jurorID = vars["CT_JurorID"],
        selectedDate = selectedDateFormatted
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    vars["CT_ResultCode"] = root.GetProperty("status").GetString() ?? "";
    vars["CT_ResultMessage"] = root.GetProperty("errorCode").GetString() ?? "";
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogPingStatus
Next=LogPingStatus


