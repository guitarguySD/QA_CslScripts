[TryAnotherDate]
type=log

[CheckRetryCount]
type=branch
var=DateRetryCount
1=StatE_PostponementError
OnAboveRange=StatE_PostponementError

[DeferFailedSorry]
type=play
msg="DeferralSorryTryAgain"
! Sorry we could not defer you to that date. Please try selecting a new date. 

[TrySelectAgain]
type=play
msg="PleaseSelectDate"

[CheckSelected1]
type=branch
var=SelectedDate
1=Skip1

[SelectDate1]
type=play
msg="For"
msgstring=Jury_PostponementDate1%"|D|ddd mmm dd yyyy"
msg="Press1"

[Skip1]
type=branch
var=SelectedDate
2=Skip2

[ForDate2]
type=play
msg="For"
msgstring=Jury_PostponementDate2%"|D|ddd mmm dd yyyy"
msg="Press2"

[Skip2]
type=branch
var=SelectedDate
3=Skip3

[TrySelectAgain2]
type=play
msg="For"
msgstring=Jury_PostponementDate3%"|D|ddd mmm dd yyyy"
msg="Press3"
Next=TrySelectAgainMenu

[Skip3]
type=log


