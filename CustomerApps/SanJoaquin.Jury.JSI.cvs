OnKey2=JuryRecordPhrase
OnKeyPound=BumpRetryCounter
OnKeyStar=BumpRetryCounter
Next=Goodbye

[BumpRetryCounter]
Type=ChangeVariable
decrement=RetryCounter

[CheckRetryCounter2]
Type=Branch
Var=RetryCounter
0=Goodbye
Next=RecordSelectMenu

[RecordOptionalGreeting]
Type=ChangeVariable
PhraseToRecord="OptionalGreeting"
Next=SetOptionalGreetingRecordPath

[SetOptionalGreetingRecordPath]
type=setglobals
!RecordFilePath="D:\Sonant\Voicefiles\Jury\English\"
Next=JuryRecordPhrase

[JuryRecordLanguage]
type=menu
msg="RecordMenuSelectLanguage"
BadKeyMsg="TryAgainDTMF"
MaxBadKeys=3
!OnMaxBadKeys=Goodbye
OnKey1=SetRecordLanguageEnglish
OnKey2=SetRecordLanguageSpanish
OnKey3=SetRecordLanguageCantonese
OnKeyPound=JuryRecordLanguage
OnKeyStar=JuryRecordLanguage
Next=Goodbye

[SetRecordLanguageEnglish]
type=setglobals
!RecordFilePath="D:\Sonant\Voicefiles\English\"
Next=JuryRecordPhrase

[SetRecordLanguageSpanish]
type=setglobals
!RecordFilePath="D:\Sonant\Voicefiles\Spanish\"
Next=JuryRecordPhrase

[SetRecordLanguageCantonese]
type=setglobals
!RecordFilePath="D:\Sonant\Voicefiles\Spanish\"
Next=JuryRecordPhrase

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[JuryRecordPhrase]   ! page 141
Type=ChangeVariable
RetryCounter=3

[JuryRecordPhraseMenu]
type=menu
msg="RecordMenu"
BadKeyMsg="TryAgainDTMF"
MaxBadKeys=3
!OnMaxBadKeys=Goodbye
OnKey1=RecordPhraseToRecord
OnKey2=PlayPhraseToRecord
OnKey3=JuryRecordLanguage
OnKey4=Goodbye
OnKeyPound=DecrementRetryCounter
OnKeyStar=DecrementRetryCounter
Next=Goodbye

[DecrementRetryCounter]
Type=ChangeVariable
decrement=RetryCounter

[CheckRetryCounter3]
Type=Branch
Var=RetryCounter
0=Goodbye
Next=JuryRecordPhraseMenu

[RecordPhraseToRecord]
type=Record
msg="RecordPrompt"
!Terminator="#"
FlushKeys=True
PlayBeep=True
MaxRecordingSec=300
!VoxTimeoutSec=5
WaitForMsg=True
FileName=PhraseToRecord
Next=JuryRecordPhrase

[PlayPhraseToRecord]
type=play
msg=PhraseToRecord
Next=JuryRecordPhrase

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[StatE_DisabledCCC]
type=log
logmsg="Disabled CCC"

[SetDisabledCCC]
type=changevariable
templocation="Jury"
ScreenMsg="Disabled - Caller For Civil"
Next=ACDAvailable

[StatE_DisabledHOJ]
type=log
logmsg="Disabled HOJ"

[SetDisabledHOJ]
type=changevariable
templocation="Jury"
ScreenMsg="Disabled - Caller For Criminal"
Next=ACDAvailable

[ACDAvailable]     !p. 69
Type=log
Var=JurorID,JurorPassword,JurorStatusEnum,ReportingStatus,ReportingDate,ScreenMsg

[GetAssistanceAvailableVar]
type=VariableManager
VarList="AssistanceAvailable"
OnError=LogACDAvailableVMFailure

[CheckAssistanceAvailableForOperator]
Type=Branch
Var=AssistanceAvailable
0=NoOperator
1=PleaseHold
Next=LogACDAvailableVMFailure

[NoOperator]
type=Play
msg="NoOperatorAvailable"
msg="AssistanceHours"
msgstring=OperatorOpen%"|D|h:n a/p"
msg="To"
msgstring=OperatorClosed%"|D|h:n a/p"
msg="MondayThruFriday"
Next=Exit

[LogACDAvailableVMFailure]
type=log
logmsg="ACD Var Man Failure"

[PleaseHold]
type=play
msg="PleaseHoldMsg"
WaitForMsg=True

[CheckForJID]
type=Branch
Var=Jury_JurorID
0=StatE_ACDNoJID
""=StatE_ACDNoJID
"Unknown"=StatE_ACDNoJID
Next=StatE_ACD

[StatE_ACDNoJID]
type=log
logmsg="Route to ACD NoJID"
Next=SetAcdCallReference

[StatE_ACD]
type=log
logmsg="Route to ACD"

[SetAcdCallReference]
type=ChangeVariable
@CallReference="AcdCall"

[acdlog]
type=log
var=screenpopapn

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller.  Note that this block never
!  falls through and executes the Next block.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[RouteCaller]
type=ACD
Command=RouteCall
!OriginationNumber=ACD_OriginationAddress
OriginationNumber=2139720970
RouteName=ACD_RouteName
OnError=AcdRouteError
OnAgentConnecting=AcdAgentConnecting
OnAgentConnected=AcdAgentConnected
OnCallReturn=CallReturnFromAcd
OnTimeout=RouteTimeout

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call Enters Queue
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[ACDWait1]
!Needed to know if going into queue or not
type=pause
pausesec=1

[LogACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[CheckCaller]
type=ACD
Command=CheckCallStatus
OnError=AcdRouteError
OnTimeout=RouteTimeout

[LogCheckACDVars]
type=log
var=@AcdCallStatus,@AcdEstHoldTimeMin,@AcdGroupAsaMin,@AcdGroupName,@AcdGroupStatus,@AcdPositionInQueue,@AcdRouteCode,@AcdTimeInQueue

[QueuePosition]
type=branch
var=@AcdPositionInQueue
0=YouAreNext
1=CurrentlyOne
OnBelowRange=YouAreNext
OnAboveRange=QueuePositionCheckForBad      !PlayQueuePosition

[YouAreNext]
type=play
msg="NextInQueue"
Next=ACDInQueue

[CurrentlyOne]
type=play
msg="CurrentlyOne"
Next=ACDInQueue

[QueuePositionCheckForBad]  !end dysfunctional calls with bad q position
type=branch
var=@AcdPositionInQueue
CompareType=Integer
999=AcdError
OnBelowRange=PlayQueuePosition
OnAboveRange=AcdError
Next=AcdError

[PlayQueuePosition]
type=play
msg="Currently"
msgstring=@AcdPositionInQueue%"|N"
msg="CallersAhead"

[ACDInQueue]
type=Play
msg="$MusicOnHold1"
msg="Silence"
msg="$MusicOnHold2"
msg="Silence"
msg="$MusicOnHold3"
msg="Silence"
msg="$MusicOnHold4"
msg="Silence"
! Silence is placehold for on hold messages
WaitForMsg=TRUE
Next=CheckCaller


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Call is connecting to ACD Agent.  Play ring. 
!     Queue 4 rings (4X6 sec) to limit logging.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnecting]
type=Play
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
msg="$RingTone"
WaitForMsg=TRUE
Next=AcdAgentConnecting


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call is connected to ACD Agent
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[AcdAgentConnected]
type=Pause
PauseSec=60
next=AcdAgentConnected


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	Call has returned from ACD 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnFromAcd]
type=Branch
var=@AcdRouteCode
1=CallReturnErrorRoute
2=CallReturnDefaultRoute
3=QueueShutdown
4=QueueFull
5=EndCall	
6=CallReturnAgentTransfer	
7=CallReturnReleaseKeyPressed
8=CallReturnConferenceConnected
9=CallReturnAgentAwol
11=StatE_ReturnForRegistration
12=StatE_EnglishToSpanishRoute
OnBelowRange=AcdError
OnAboveRange=AcdError
Next=AcdError

[CallReturnErrorRoute]
type=Log
LogMsg="Error Route"
Next=CheckIfLoggedIn

[CallReturnDefaultRoute]
type=Log
LogMsg="DefaultRoute"
Next=CheckIfLoggedIn

[QueueShutdown]
type=Branch
var=ACD_RouteName
"Spanish"=RouteToSpanishVMLog

[PlayQueueShutdown]
type=Play
msg="QueueShutdown"

[StatE_QueueShutdown]
type=log
logmsg="Queue Shutdown"
Next=CheckIfLoggedIn

[QueueFull]
Type=Play
msg="QueueFull"

[StatE_QueueFull]
type=log
logmsg="QueueFull"
Next=CheckIfLoggedIn          !Our offices are open, however there are too many callers currently waiting for operators. If you require operator assistance please call again later. The least busy time of the week to retry your call is from 1:30 to 3:30 on Tuesdays, Wednesdays, and Thursdays. Otherwise please choose from the following options.

[CallReturnAgentTransfer]
type=log
logmsg=ACD_Agent
next=ACDInQueue
	
[CallReturnReleaseKeyPressed]
type=log
logmsg="Release Key Pressed"

[AgentPressedRelease]
type=Pause
PauseSec=60
Next=AgentPressedRelease

[CallReturnConferenceConnected]
type=Log
LogMsg="ConferenceConnected"
next=Exit

[RouteTimeout]
type=Play
msg="AcdTimeout"
next=Exit

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Return Routes
!  
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[StatE_ReturnForRegistration]
type=log
logmsg="Return4Registration"

[ResetVarsForRegistration]
type=changeVariable
GetReportingInstructions=0

! No juror id, send caller to get juror ID
[CheckIfJurorIDSet]
type=branch
var=Jury_JurorID
"UNKNOWN"=GetJurorID
""=GetJurorID
Next=ReturnRefreshJurorInfo

[ReturnRefreshJurorInfo]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetJuror"
OnExecuteError=LogReturnCallerExecuteError
Next=GroupReportingInstructions

[LogReturnCallerExecuteError]
type=log
var=@Result,@ResultMessage,ResultCode,ErrorMessage
Next=StatE_SystemError

[StatE_EnglishToSpanishRoute]
type=log
logmsg="Eng_To_Spanish"

[SetRouteToSpanish]
type=SetGlobals
Language="English"  !!no spanish folder!!

[SetRouteVarSpanish]
type=changeVariable
CallerLanguage="English"  !!no spanish folder!!
ACD_RouteName="Spanish"
Next=SetAcdCallReference



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Route Caller after AWOL
!  Uses Urgent priority.
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[CallReturnAgentAwol]
type=log
logmsg="AWOL"

[RouteCallerAfterAwol]
type=ACD
Command=RouteCall
!OriginationNumber=ACD_OriginationAddress
OriginationNumber=2139720970
RouteName=ACD_RouteName
Priority="Urgent"
OnError=AcdRouteError
next=PauseAfterAWOL

[PauseAfterAWOL]
type=Pause
PauseSec=1

[CheckCallerAfterAWOL]
type=ACD
Command=CheckCallStatus
OnError=AcdError
OnTimeout=AcdError

[QueuePositionAfterAwol]  !end dysfunctional calls with bad q position
type=branch
var=@AcdPositionInQueue
CompareType=Integer
999=AcdError
OnBelowRange=ACDInQueue
OnAboveRange=AcdError
Next=AcdError

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Agent Routes
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

[AcdRouteError]
type=Branch
var=ACD_RouteName
"Spanish"=RouteToSpanishVMLog

[PlayRouteError]
type=Play
FlushPlayQueue=True
Msg="QueueShutdown"
Next=CheckLoopingError

[AcdError]
type=Play
FlushPlayQueue=True
msg="SystemProblem"
WaitForMsg=TRUE
Next=Exit

[CheckLoopingError]
type=branch
var=ErrorCounter
1=Exit
OnAboveRange=Exit
Next=CheckIfLoggedIn

[CheckIfLoggedIn]
type=branch
var=JurorLoggedIn
0=MainMenu
1=MainMenu
Next=StatE_Sorry

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Custom ACD Agent Route to Spanish VM
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 

[RouteToSpanishVMLog]
type=log
logmsg="RT to Spanish VM"
LogType=ScriptEvent

[RouteToSpanishVM]
type=ChangeVariable
Extension=2099925371
! Maria's direct line
Next=TransferPleaseHold

[TransferPleaseHold]
type=log
logmsg="Extension = "%Extension

[TransferPleaseHold2]
type=play
msg="PleaseHoldExtensionTransfer"
WaitForMsg=True

[TransferAttempt]
type=log
logmsg="Xfer Attempts"
LogType=ScriptEvent
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[PlaySilenceToPauseForHangup]
type=play
msg="Silence"
WaitForMsg=True

[BridgeTransferHold]
type=CallControl
Command=Hold
PartyName="Inbound"
ResultVar="HoldResult"
OnError=BTLogCallControlHoldError
Next=LogBTPhoneNumber

[BTLogCallControlHoldError]
type=Log
Logmsg="HoldResult = "%HoldResult
Next=BTError

[LogBTPhoneNumber]
type=Log
Logmsg="TransferPhoneNumber = "%Extension

[BTCall]
type=Call
DestinationNumber=Extension
OriginationNumber="2096456053"
PartyName="GeneralTransfer"
CallResultVar="CallResult"
OnCallError=LogCallBTError
Next=BTPauseBeforePutSecondCallOnHold

[LogCallBTError]
type=Log
Logmsg="CallResult = "%CallResult
Next=BTError

[BTPauseBeforePutSecondCallOnHold]
type=Pause
PauseMSec=500

[BTTakeCallOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=LogCallControlHoldError

[BTStopOnHoldPlay]
type=play
flushplayqueue=true

[BTBridgeCalls]
type=CallControl
Command=Bridge
OnError=LogCallControlBridgeTransferError
Next=HangupCall

[LogCallControlBridgeTransferError]
type=Log
Logmsg="CallControlBridgeError"
Next=BTErrorOffHold

[BTErrorOffHold]
type=CallControl
Command=OffHold
PartyName="Inbound"
OnError=LogCallControlHoldError
Next=BTError

[LogCallControlHoldError]
type=log
logmsg="HoldError"

[BTError]
type=Play
FlushPlayQueue=True
Next=SystemError

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!========================================
!End Plays & Routines
!========================================
[StatE_Sorry]   ! page 070
type=log
logmsg="Too Many Errors"

[SetScreenMsgForSorry]
Type=ChangeVariable
ScreenMsg="Problem: Caller made too many errors"

[PlaySorry]
type=play
msg="WeAreSorry"
Next=ACDAvailable

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[StatE_SystemError]   ! page 070
type=log
logmsg="System Error"

[SetScreenMsgForSystemError]
Type=ChangeVariable
ScreenMsg="Problem: System Error"

[SystemError]
type=play
msg="SystemProblem"
Next=ACDAvailable

