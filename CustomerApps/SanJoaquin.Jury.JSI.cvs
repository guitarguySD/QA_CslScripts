!========================================
!Main Menu
!========================================
!
! As we have learned, if you sent a "PlayOption" this affects both the variable in the message 
! as well as the corresponding DTMF Key
!
[ConstructMainMenu]   ! page 033 & 034 & 35
Type=branch
Var=Jury_StatusEnum
"Available"=SetAvailableOptions
"AssignedToCase"=SetAssignedOptions
"Eligible"=SetEligibleOptions
"InService"=SetServingOptions
"Pool"=SetPoolOptions
"ServiceComplete"=SetCompletedOptions
"Summoned"=SetSummonedOptions
"Unknown"=SetUnknownOptions
"JSIDown"=SetNOJSIAPI
Next=SetUnknownOptions


!--------------------------------------------------
! Juror Menu Options
! 
! 1 - Deferrals
! 2 - FAQs (Always Available)
! 3 - Request an disqualification
! 4 - Temporary Excusal
! 5 - Enter Juror Id
! 6 - Payment info
! 7 - Work Cert
! 0 - Assistance
! # - Hear options again
! * - Hear options again
!-----------------------------------------------
! Menu options for each STATE.
! 
[SetUnknownOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 1
@PlayOption6 = 1
@PlayOption7 = 0
Next=CheckGlobalOptions

[SetNOJSIAPI]
type=changevariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 1
@PlayOption7 = 0
Next=CheckGlobalOptions

[SetCompletedOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
@PlayOption7 = 0
Next=CheckGlobalOptions

[SetEligibleOptions]
type=changeVariable
@PlayOption1 = Jury_IsEligibleToReschedule
@PlayOption2 = 1
@PlayOption3 = 1
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
@PlayOption7 = 0
Next=CheckGlobalOptions

[SetPoolOptions]
type=changeVariable
@PlayOption1 = Jury_IsEligibleToReschedule
@PlayOption2 = 1
@PlayOption3 = 1
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
@PlayOption7 = 0
Next=CheckGlobalOptions

[SetSummonedOptions]
type=changeVariable
@PlayOption1 = Jury_IsEligibleToReschedule
@PlayOption2 = 1
@PlayOption3 = 1
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption6 = 0
@PlayOption7 = 0
Next=CheckGlobalOptions

[SetAvailableOptions]
type=changeVariable
@PlayOption1 = Jury_IsEligibleToReschedule
@PlayOption2 = 1     
@PlayOption3 = 1
@PlayOption4 = 4     ! 
@PlayOption5 = 0     ! 
@PlayOption6 = 0     ! 
@PlayOption7 = 0
Next=CheckGlobalOptions


[SetServingOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0
@PlayOption4 = 1
@PlayOption5 = 0
@PlayOption6 = 0
@PlayOption7 = 0
Next=CheckGlobalOptions


[SetAssignedOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 1
@PlayOption3 = 0 
@PlayOption4 = 0 
@PlayOption5 = 0
@PlayOption6 = 0 
@PlayOption7 = 0
Next=CheckGlobalOptions

! 1 - Deferrals
! 2 - FAQs (Always Available)
! 3 - Request an disqualification
! 4 - Temporary Excusal
! 5 - Enter Juror Id
! 6 - Payment info
! 7 - Work Cert
! 0 - Assistance
! # - Hear options again
! * - Hear options again
!--------------------------------------------------
! Check global menu Options
! 
[CheckGlobalOptions]
type=log

!--------------------------------------------------
! If AllowDeferrals is False, turn off Deferrals
! 
[CheckGlobalDeferrals]
type=branch
var=AllowDeferrals
0=SetNoDeferrals
Next=CheckGlobalDisqualifications

[SetNoDeferrals]
type=ChangeVariable
@PlayOption1=0

!---------------------------------------------------------------
! If AllowDisqualifications is False, turn off Disqualifications
! 
[CheckGlobalDisqualifications]
type=branch
var=AllowDisqualifications
0=SetNoDisqualifications
Next=CheckGlobalExcusals

[SetNoDisqualifications]
type=changeVariable
@PlayOption3 = 0

!---------------------------------------------------------------
! If AllowExcusals is False, turn off Disqualifications
! 
[CheckGlobalExcusals]
type=branch
var=AllowExcusals
0=SetNoExcusals
Next=MainMenu

[SetNoExcusals]
type=changeVariable
@PlayOption4 = 0
Next=MainMenu

!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!
[MainMenu]   ! page 036
type=Recognize
NoInputTimeOutMSec=10000
!RecognizerFailureMsg="SpeechRecSystemError"
grammar="MainMenu"
PromptMsg="Say","MainReschedule"|X|1,"MainAttendanceDates"|X|2,"MainWorkCert"|X|3,"MainFAQ","AccessJurorRecord"|X|5,"MainPaymentInfo"|X|6,"MainStaff"|X|7,"MakeChoice"
PromptMsgDTMF="MainMenuGreeting","MainMenu1"|X|1,"MainMenu2"|X|2,"MainMenu3"|X|3,"MainMenu4"|X|4,"MainMenu5"|X|5,"MainMenu6"|X|6,"MainMenu7"|X|7,"MainMenu0","MainMenuFinal"
Onkey1=StatE_DateReschedule
Onkey2=StatE_FAQs
Onkey3=StatE_RequestDisqual
Onkey4=StatE_RequestExcusal
Onkey5=GetJurorID
Onkey6=StatE_PaymentInfo
Onkey7=StatE_WorkCertificate
!OnKey9=AutopostponeTest
OnKey0=SetScreenMsgForMainMenu
OnkeyStar=ConstructMainMenu
Onkeypound=ConstructMainMenu
OnResult:"Reschedule"=StatE_DateReschedule
OnResult:"Attendance"=StatE_AttendanceDates
