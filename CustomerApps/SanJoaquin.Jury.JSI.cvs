[ServiceComplete]                       ! Changed from NotRequiredToReport
Type=Play
Msg="Group"
MsgString=Jury_ReportingGroup  
Msg="For"
MsgString=Jury_GroupReportingDate%"|D|ddd mmm dd yyyy"
Msg="IsNotRequiredToReport"

[ServiceCompleteRecBlock]
type=Recognize
NoInputTimeOutMSec=10000
PromptMsg="RepeatMessage","InquiriesMenu","HangupMenu"
PromptMsgDTMF="RepeatMessageDTMF","ToSpeakWithStaffMemberDTMF","InquiriesMenuDTMF","HangupMenuDTMF"
grammar="Inquiries"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="Silence"   
