type=changeVariable
ScreenMsg="Transfer: Postponement"
Next=ACDAvailable

[PostponementConfirmation]
type=changeVariable
Jury_TypeCode="PP"
Jury_ReasonCode="LP"

[RequestPostponement]
Type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="ApplyPostponement"
!OnExecuteError=StatE_PostponementError
OnExecuteError=TryAnotherDate
Next=CheckPostponementResult

[StatE_PostponementError]
type=log
var=Jury_Result,Jury_NewReportingDate,Jury_AlternateReportingDate
Next=StatE_SystemError

[CheckPostponementResult]
type=Branch
var=Jury_Result
"Ok"=StatE_SuccessfulDeferral
Next=StatE_PostponementError

[StatE_SuccessfulDeferral]
type=log

[PlaySuccessfulPostponeMessage]
