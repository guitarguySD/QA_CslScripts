! Check Call-In Window  page 025 - 
! If the caller is in the call-in Window, use the Jury_ReportingGroup and
! go get their group reporting instructions.
!
[CheckTimeWindows]
Type=log

[CheckJuryGroupZero]
type=branch
var=Jury_ReportingGroup
0=HandleGroupZero
Next=CheckReportingWeek

[CheckReportingWeek]
type=Branch
var=ReportingWeekState
"BeforeReportingWeek"=GenericReportingInstructions
"isReportingWeek"=GroupReportingInstructions
"PastReportingWeek"=PastReportingWeek
Next=GenericReportingInstructions

!--------------------------------------
! Past Reporting Week - Send to Agent
[PastReportingWeek]
type=log

[PastReportingWeekMenu] ! Why is this person not marked FTA
type=Play
msg="ReportingDatePast"

[SetScreenMsgForReportDatePast]
Type=ChangeVariable
ScreenMsg="Past Report Date"
Next=ACDAvailable

!---------------------------
[HandleGroupZero]
type=log

[PlayReportingInstructionsGroup0]
Type=Play
msg="ReportGroup0"
MsgString=Jury_ReportingDate%"|D|ddd mmm dd yyyy"
msg="at"
msgstring=Jury_ReportingTime%"|D|h:n a/p"
msg="at"
msg=CourtName
msg="LocatedAt"
msg=CourtAddress

[PlaySpecificInstructionsMenu]
type=Menu
msg="HearAgainContinueDTMF"
msg="ParkingInfo"
OnKey1=ConstructMainMenu
OnKey2=ParkingInformation
OnKey0=SetScreenMsgForReportDateTime
OnKeyStar=PlayReportingInstructionsGroup0
OnKeyPound=PlayReportingInstructionsGroup0



