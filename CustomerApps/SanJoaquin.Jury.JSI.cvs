OnResult:"Information"=StatE_FAQs
OnResult:"Repeat"=ConstructMainMenu
OnResult:"Agent"=SetScreenMsgForMainMenu
OnResult:"JurorRecord"=GetJurorID
OnResult:PaymentInfo=PaymentInfo
OnResult:Hangup=EndCall
OnDTMFError=SetScreenMsgForMainMenu
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
ConfidenceThreshold=30
SuccessMsg="SuccessMsg"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="ShiftToDTMF"

