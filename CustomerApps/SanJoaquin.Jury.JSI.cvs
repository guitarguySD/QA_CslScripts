! End Routines
!===================================
[Exit]
type=play
msg="ThankYou"
WaitForMsg=True

[Goodbye]
type=play
msg="Goodbye"
WaitForMsg=True
Next=HangupCall

[EndCall]
type=changevariable
ACD_AgentData=Jury_JurorID%","%Jury_Name

[checkaccessjsi]
type=branch
var=AccessJSI
0=EndCallRec

[DisconnectJSIPort]
Type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="Jury_Disconnect"
OnExecuteError=EndCallRec

[EndCallRec]
type=EndRecognitionSession

[HangupCall]
type=CallControl
Command=Disconnect

[TerminateCall]
type=Terminate

