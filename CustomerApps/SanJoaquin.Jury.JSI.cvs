!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
! This is the entry point for callers after they have entered
! their JurorID (rather than group number). 
!
! Error conditions (No instructions, group number not found) are
! treated as system errors because the Group Number comes from the DB
! and the user has no ability to re-enter the number if they even know it.
!
[GroupReportingInstructions]
type=log
var=Jury_JurorID,Jury_ReportingGroup,Jury_ReportingDate,ReportingWeekState,Jury_IsCallInWindow,Jury_IsReportingDay,Jury_IsPastFTACutOffTime

!retrieve Group Reporting Instructions----
[GetGroupReportingInstructions]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetGroupReportingInstructions"
OnExecuteError=GetGroupInstDLLError
Next=LogGroupReportingInfo

[GetGroupInstDLLError]
Type=Log
LogMsg="Error: Get Group Info"
Next=StatE_SystemError

[LogGroupReportingInfo]
type=log
Var=Jury_Result,Jury_ReportingGroup,Jury_IsGroupInstructionAvailable,Jury_GroupStatusEnum,Jury_GroupReportingDate,Jury_GroupReportingLocation,Jury_GroupReportingTime,Jury_GroupReportingCallbackTime

[CheckInstructionsAvailable]
type=Branch
var=Jury_IsGroupInstructionAvailable
0=InstructionsCurrentlyNotAvailable
1=GroupFoundCheck

[InstructionsCurrentlyNotAvailable]
type=play
msg="InstructionsNotAvailable"
Next=ConstructMainMenu

[GroupFoundCheck]   
Type=Branch
Var=Jury_Result
"Ok"=CheckIsPastReportingDay
Next=GroupInstrNotOk

[GroupInstrNotOk]
type=Play
msg="SorryNoInstructions"
Next=ConstructMainMenu

!-----------------------------------------------
! Check is Past Reporting Day
[CheckIsPastReportingDay]
type=Branch
var=Jury_IsPastReportingDay
0=CheckIsReportingDay
1=PastReportingDay
Next=PastReportingDay

!--------------------------------------
! Past Reporting Day - Send to Agent
[PastReportingDay]
type=log

[PastReportingDayMenu] ! Why is this person not marked FTA
type=Play
msg="ReportingDatePast"

[SetScreenMsgForReportDayPast]
Type=ChangeVariable
ScreenMsg="Past Report Date"
Next=ACDAvailable

!---------------------------------------
! Check if today is Reporting Day
! Juror is not past their reporting day
[CheckIsReportingDay]
type=Branch
var=Jury_IsReportingDay
0=CheckCallinWindow
1=CheckIsRequiredToReport

[CheckIsRequiredToReport]
type=Branch
var=Jury_GroupStatusEnum
"RequiredToReport"=CheckPastFTACutoff
Next=CheckCallinWindow

[CheckPastFTACutoff]
type=Branch
var=Jury_IsPastFTACutOffTime
0=PlayTodayIsReportingDay	! It's their reporting day but they can still report
1=PastReportingDay			! It's their reporting date but too late - send to agent

[PlayTodayIsReportingDay]
type=Play
msg="TodayIsReportingDay"
Next=ProcessGroupReportingInstructions !This skips the callin window check, plays their instructions because it's their reporting day before FTA cutoff

!---------------------------------------------
! Check if it's in the evening callin window
[CheckCallinWindow]
type=Branch
var=Jury_IsCallInWindow
0=ReportingDayCheck
1=ProcessGroupReportingInstructions

[ReportingDayCheck]	!This section is probably not needed, the reporting day check was done elsewhere already. 
type=log

[SetVarsToCheckBooleans]	! Check if it's their reporting day AND they are required to Report
type=ChangeVariable
Jury_fn_i_Expression="Jury_IsReportingDay==true && Jury_GroupStatusEnum=='RequiredToReport'"
Jury_fn_i_VariableName="BooleanResult"

[ExecuteEvaluateExpression2]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="fn_EvaluateBooleanExpression"
OnExecuteError=LogEvalBoolError

[LogEvalBoolError]
type=log
var=Result,ResultCode,ResultMessage

[CheckBooleanResult2]
type=Branch
var=Jury_BooleanResult	! isReportingDay & required to report
0=CallbackInEvening
1=CheckPastFTACutoff	! if true, check if it's past the FTA cutoff time
Next=CallbackInEvening

[CheckPastFTACutoff2]
type=Branch
var=Jury_IsPastFTACutOffTime
0=SetComeInAnywayFlag
1=PastReportingWeek

[SetComeInAnywayFlag]
type=changeVariable
ComeInAnywayFlag=1
Next=ProcessGroupReportingInstructions

[CallbackInEvening]
type=Play
msg="CallbackThisEvening1"
msgstring=Jury_VMCallbackTime%"|D|h:n a/p"
msg="CallbackThisEvening2"
Next=ConstructMainMenu

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[ProcessGroupReportingInstructions]
type=log

[CheckGroupStatusEnum]
type=Branch
var=Jury_GroupStatusEnum
"ServiceCompleted"=StatE_ServiceComplete
"RequiredToReport"=StatE_RequiredToReport
"CallbackRequired"=StatE_CallbackRequired
Next=StatE_SystemError


