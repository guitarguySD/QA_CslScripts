! San Joaquin Court Jury
!  - based on Sacramento script same date
!
!   2011-01-26 dwg, updated for san joaquin, group number from database.
!   Refer to the call flow. This version is specific to San Joaquin. 
!   The Group Number is retrieved from the database - NO Interactive Group Number entry.
!   Options 2 & 3 on main menu are never offered. 
!
! 03/08/11 - dwg - This version with Emergency message plus path to whole application
! 03/22/11 - tb  - Changed TransferDialString to 82870
! 09/29/11 - tb  - commented out SafetyDisconnectJSIPort block because when JSI has delays this disconnect is causing our transfers to fail
! 04/01/2014 - RR - Changed Transfer Dial String to ##6650 for new voip phone system from 82870
! 7/2/14	RR - changed transfer dial string to 5700
! 12/5/14	RR - Fixed after hours issue with Assistance Available.
! 03/29/24  EB - CCS to CVS script conversion; updated ACDAvailable block
! 05/16/24  EB - Disallow disquals and excusals; rename PostponementDate to Jury_PostponementDate
! 05/30/24  EB - Changed var HolidayToday to IsHoliday
! 07/24/24	EB	-	Route to spanish agent
! version 10 - postponement test
! 07/26/24  DG - Group 0 reporting instructions fix
! 08/01/24 RR - Added spanish route to spanish group
! 08/02/24 EB - Jury_VMCallbackTime
! 08/06/24 EB - CheckInstructionsAvailable
! 08/07/24 DG - Added notes, small fix to Reporting Day check
! 08/27/24 DG - Postponedate error handling change
! 09/11/24 DG - Fixed isHoliday, HolidayToday callin window issue
! 10/30/24 RR - Added JSINoOptions on Main menu when HostAvailable=0
! 01/23/25 EB - isHoliday is used for DLL call in calculations
[ScriptSetup]
type=SetGlobals
Language="English"
MaxCallSec=9000
MaxCallErrors=8
OnMaxCallSec=HangupCall
OnMaxCallErrors=HangupCall
OnCallDisconnect=HangupCall
