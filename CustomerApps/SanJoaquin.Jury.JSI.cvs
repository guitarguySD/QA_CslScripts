msg="DeferralGranted1"
msgstring=Jury_NewReportingDate%"|D|ddd mmm dd yyyy"
msg="DeferralGranted2"

[DeferralGrantedMenu]
type=menu
msg="DeferralGrantedMenu"
OnKey9=Exit
OnKey0=SetScreenMsgDeferralGranted
OnKeyStar=PlaySuccessfulPostponeMessage


[SetScreenMsgDeferralGranted]
type=changeVariable
ScreenMsg="Transfer: Deferral Granted"
Next=ACDAvailable

