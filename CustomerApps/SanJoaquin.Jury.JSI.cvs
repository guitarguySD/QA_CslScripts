!========================================
! Set System Defaults
!========================================
[BlockDefaults]
Type=SetDefaults
!DefaultWaitForMsg=0     	! False
DefaultIgnoreMissingMsg=1    	! True
DefaultFlushKeys=0     		! False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=StatE_Sorry
DefaultTimeOutSec=5
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=StatE_Sorry
DefaultLogCall=1     		! True
DefaultLogMenu=1     		! True
DefaultLogGetDigits=1     	! True
DefaultLogPlay=1     		! True
DefaultTerminator=""

[GetInitialVariables]
type=VariableManager
VarList="HostAvailable,HolidayToday,isHoliday,AssistanceAvailable,OperatorOpen,OperatorClosed,RecordPassword,PhraseToRecord,TestModePassword,Jury_VMCallbackTime"
OnError=LogInitialValues

[LogInitialValues]
type=log
logmsg="Caller Number= "%@OriginationAddress%" Dialed Number= "%@DestinationAddress

[Greeting]
Type=Play
Msg="Greeting"
Msg="OptionalGreeting"

[CheckHolidayToday]
Type=Branch
Var=HolidayToday
1=PlayHolidayToday
Next=CheckHostAvailable

[PlayHolidayToday]
Type=Play
Msg="HolidayMessage"
Next=CheckHostAvailable

[CheckHostAvailable]
type=Branch
var=HostAvailable
1=CheckASRAvailable
0=DBDownMsg

[DBDownMsg]
type=play
msg="dbdown"

[DisableJSILookup]
type=changevariable
Jury_StatusEnum="JSIDown"
Next=CheckASRAvailable


!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[CheckASRAvailable]   ! page 004
type=Branch
var=@RecognizeDtmfMode
1=SetModeToDTMF

[ASRHelps]
type=Play
!Msg="ASRHelps"
msg="silence"
next=LanguageCheck

[SetModeToDTMF]
Type=ChangeVariable
@RecognizeDtmfMode=1

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[LanguageCheck]   ! page 05
Type=Branch
var=@RecognizeDtmfMode
0=ASRPath

[DTMFPath]
Type=Menu
Msg="EnglishMenuDTMF"
Msg="LanguageMenuDTMF"
OnKey1=DBAvailable
OnKey2=SpanishSelected
OnKey3=DBAvailable
OnKey4=DBAvailable
OnKey5=DBAvailable
OnKey6=DBAvailable
OnKey7=DBAvailable
OnKey8=DBAvailable
OnKey9=DBAvailable
OnKey0=DBAvailable		!rr changed while onsite per discussion with Shana (5/21/2010)
!OnKey0=ACDAvailable
OnKeyPound=StatE_Admin
MaxBadKeys=2
BadKeyMsg="InvalidSelectionDTMF"
OnMaxBadKeys=DBAvailable
TimeOutSec=4
MaxTimeOuts=0
TimeOutMsg="TimeoutDTMF"
OnMaxTimeOuts=DBAvailable
FlushKeys=True
Next=DBAvailable

[ASRPath]
type=Recognize
NoInputTimeOutMSec=1500
!RecognizerFailureMsg="SpeechRecSystemError"
PromptMsg="EnglishLanguage","LanguageMenu" 
PromptMsgDTMF="EnglishMenuDTMF","LanguageMenuDTMF"        
Grammar="Language"
ResultFormat=DigitsorResult
MisrecognizeMsg="TryAgain"
BadKeyMsg="InvalidSelectionDTMF"
HelpMsg="StandardHelp"
OnKey1=StatE_EnglishDTMF
OnKey2=StatE_SpanishDTMF
OnKey0=SetScreenMsgLanguage
OnKeyPound=StatE_Admin
OnResult:English=StatE_EnglishASR !1 
OnResult:Espanol=StatE_SpanishASR !2 
OnResult:Operator=SetScreenMsgLanguage !0
OnResult:Repeat=ASRPath
!ShiftToDTMFMsg="silence"
MaxRetryCount=1
OnMaxRetries=DBAvailable
OnDTMFError=StatE_EnglishDTMF
SuccessMsg="SuccessMsg" 
!OnRecognitionError=DBAvailable
ConfidenceThreshold=30
Next=DBAvailable

[SetScreenMsgLanguage]
type=changevariable
ACD_RouteName=TempLocation%CallerLanguage

[SetScreenMsgLanguage1]
Type=ChangeVariable
ScreenMsg="LanguageMenu"
Next=ACDAvailable

[OnDtmfErrorLanguageCheck]
type=Play
Msg="TryAgainDTMF"
Next=LanguageCheck

[OnOtherResultLanguageCheck]
type=play
msg="ShiftToDTMF"

[OnDtmfErrorLanguageCheckShiftDTMF]
type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec8]
type=EndRecognitionSession

[StatE_DTMF8]
Type=Log
LogMsg="Change to DTMF"
Next=LanguageCheck

[StatE_EnglishDTMF]
Type=Log
LogMsg="Chose English DTMF"

[SetModeToEnglishDTMF]
Type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec8e]
type=EndRecognitionSession
Next=SetModeToEnglishLanguage

[StatE_EnglishASR]
Type=Log
LogMsg="English ASR"

[SetModeToEnglishLanguage]
type=setglobals
Language="English"
Next=DBAvailable

[StatE_SpanishDTMF]
Type=Log
LogMsg="Chose Spanish DTMF"

[SetModeToSpanishDTMF]
Type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec8s]
type=EndRecognitionSession
Next=SpanishSelected

[StatE_SpanishASR]
Type=Log
LogMsg="Chose ASR"
Next=SpanishSelected

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!========================================
!Spanish Selected
!========================================
[SpanishSelected]   ! page 06
Type=Log
LogMsg="Calls Spanish"

[SetSpanish]
type=changevariable
CallerLanguage="Spanish"
ACD_RouteName="Spanish"


[NonEnglishJuror]
Type=play
msg="NonEnglishJuror"

[NonEnglishJurorMenu]
type=menu
msg="NonEnglishJurorMenu"
OnKey1=DBAvailable
OnKey0=SetScreenMsgNonEnglishJuror
OnKeyStar=NonEnglishJuror
OnKeyPound=NonEnglishJurorMenu

[SetScreenMsgNonEnglishJuror]
type=changevariable
ScreenMsg="NonEnglish Juror"
Next=ACDAvailable

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[DBAvailable]   ! If Db is down, go direct to Construct Main Menu
Type=Branch
Var=HostAvailable
1=JurorRecord
0=ConstructMainMenu


!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[JurorRecord]   ! page 018
type=Recognize
NoInputTimeOutMSec=10000
!RecognizerFailureMsg="SpeechRecSystemError"
!IntroMsg=""
!IntroMsgDTMF=""
PromptMsg="QuickAccessMenu"
PromptMsgDTMF="QuickAccessMenuDTMF"
grammar="PersonalRecord"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
ShiftToDTMFMsg="Silence"   
OnKey1=GetJurorID
OnKey2=StatE_FAQs
OnKey0=SetScreenMsgJurorRecord
OnKeyPound=StatE_Admin
OnKeyStar=JurorRecord
OnResult:JurorRecord=GetJurorID     !2
OnResult:Information=StatE_FAQs !3
OnResult:Repeat=JurorRecord 
OnDTMFError=StatE_Sorry
OnMaxRetries=StatE_Sorry
OnOtherResult=OnOtherResultJurorRecord
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
ConfidenceThreshold=20
SuccessMsg="SuccessMsg"

[SetScreenMsgJurorRecord]
type=changeVariable
ScreenMsg="Requested Agent: Juror Record"
Next=ACDAvailable

[OnDtmfErrorJurorRecord]
type=Play
Msg="TryAgainDTMF"
Next=JurorRecord

[OnOtherResultJurorRecord]
type=play
msg="TryAgain"
Next=JurorRecord

[OnDtmfErrorJurorRecordShiftDTMF]
type=ChangeVariable
@RecognizeDtmfMode=1

[EndRec30]
type=EndRecognitionSession

[StatE_DTMF30]
Type=Log
LogMsg="Change to DTMF"
Next=JurorRecord


!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[GetJurorID]   ! page 021
type=changeVariable
RetryCounter=0

[SetNameRetry]
Type=ChangeVariable
NameRetry=0
Next=GetJurorIDBlock

[DBUnavailable]
Type=ChangeVariable
UnknownID=1

[DataUnavailable]
Type=Play
Msg="DataUnavailable"
Next=Exit

[GetJurorIDBlock]
type=Recognize
NoInputTimeOutMSec=10000
!RecognizerFailureMsg="SpeechRecSystemError"
IntroMsg="GetIDIntro"
IntroMsgDTMF="GetIDIntro"
PromptMsg="EnterJurorID"
PromptMsgDTMF=EnterJurorIDMsg
!grammar="JurorIDNumber"
grammar="builtin:grammar/digits?minlength=7;maxlength=9"
HelpMsg="StandardHelp"
DTMFTerminator="#"
MinDigitsMsg="ExpectingSevenDTMF"
MisrecognizeMsg="TryAgain"
!TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnResult:Agent=SetScreenMsgForGetID
OnKeyStar=GetJurorID
Var=Jury_JurorID
ResultFormat=Digits
ResultLengthMin=1
ResultLengthMax=10
!OnRecognitionError=SetScreenMsgForGetIDOnError
!OnDTMFTimeout=SetScreenMsgForGetIDOnError
OnDTMFError=SetScreenMsgForGetIDOnError
MaxRetryCount=2
BadKeyMsg="InvalidSelection"
!TimeoutMsg="Timeout"
!TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="Thanks"
ConfidenceThreshold=30
Next=CheckJurorIDLength

[CheckJurorIDLength]
type=branch
var=@recognizeLength
0=ACDAvailable
1=ACDAvailable
7=VerifyBadgeNumber
8=VerifyBadgeNumber
9=VerifyBadgeNumber
Next=JurorIDIncrementRetry

[VerifyBadgeNumber]
type=log
logmsg="Verify Badge number "%Jury_JurorID

[VerifyBadgeNumberMenu]
type=Recognize
PromptMsg="DidYouSay",Jury_JurorID|C
PromptMsgDTMF="BadgeNumberWas",Jury_JurorID|C,"VerifyIDMenuDTMF"
Grammar="YesNoStaff"
OnResult:Yes=RetrieveRecord
OnResult:No=IncrementJurorIDRetry
OnResult:Agent=SetScreenMsgForGetIDOnError
OnOtherResult=OnOtherResultVerifyBadge
OnKey0=SetScreenMsgForGetIDOnError
OnKey1=RetrieveRecord
OnKey2=IncrementJurorIDRetry
!RecognizerFailureMsg="SpeechRecSystemError"
OnDTMFError=SetScreenMsgForGetIDOnError
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
!TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
BadKeyMsg="InvalidSelection"
MaxRetryCount=2
!TimeoutMsg="Timeout"
!TimeoutMsgDTMF="TimeoutDTMF"
ConfidenceThreshold=30
SuccessMsg="SuccessMsg"

[OnOtherResultVerifyBadge]
type=play
msg="TryAgain"

[IncrementJurorIDRetry]
type=changeVariable
increment=RetryCounter

[CheckCounterAgain]
type=branch
var=retryCounter
3=SetScreenMsgForGetIDOnError
Next=GetJurorIDBlock

[JurorIDIncrementRetry]
type=changevariable
increment=RetryCounter

[CheckJurorIDRetryCounter]
type=branch
var=retryCounter
3=SetScreenMsgForGetIDOnError
OnBelowRange=PlayExpectingSevenDigits
OnAboveRange=SetScreenMsgForGetIDOnError

[PlayExpectingSevenDigits]
type=play
msg="ExpectingSevenDTMF"
Next=GetJurorIDBlock
!
!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!
[SetScreenMsgForGetIDOnError]
Type=ChangeVariable
ScreenMsg="Problem: ENTERING Juror ID #"
Next=StatE_Sorry

[SetScreenMsgForGetID]
Type=ChangeVariable
ScreenMsg="Requested Staff: ENTERING ID #"
Next=ACDAvailable

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!========================================
!Retrieve Record
!========================================
[RetrieveRecord]   ! page 026
Type=log

[HoldForRecord]
Type=Play
Msg="HoldForRecord"

[LogJury_JurorID]
Type=Log
LogMsg=Jury_JurorID

[ExecuteRecordRetrieval]
Type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetJurorRecord"
OnExecuteError=StatE_SystemError

[LogGetJurorRecordResult]
type=log
logmsg="JurorID = "%Jury_JurorID%", JSI Get Record Result ="%Jury_Result

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[CheckRetrieveResult]  
Type=Branch
Var=Jury_Result
"Ok"=StatE_RecordFound
"JurorNotFound"=StatE_RecordNotFound     
"JurorMismatch"=StatE_RecordNotFound
"SystemError"=StatE_SystemError
Next=StatE_SystemError

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
! Record Found
[StatE_RecordFound]
Type=Log
var=Jury_JurorID,Jury_StatusEnum,Jury_LastName,Jury_ReportingDate,Jury_ReportingLocationID

[CheckTestMode]
type=Branch
var=WindowTestMode
0=LogMoreJurorInfo
1=GetTimeWindowsFromVM

[GetTimeWindowsFromVM] !For testing purposes
type=VariableManager
varlist="Jury_JurorID,Jury_IsReportingWeek,Jury_IsPastReportingWeek,Jury_IsCallInWindow,Jury_IsReportingDay,Jury_IsPastFTACutoffTime"
OnError=StatE_SystemError

[LogMoreJurorInfo]
type=log
var=Jury_JurorID,Jury_IsEligibleToReschedule,Jury_isEligibleForExcusal,Jury_IsReportingWeek,Jury_IsReportingDay,Jury_IsCallInWindow,Jury_IsPastFTACutOffTime,Jury_IsPastReportingDay,Jury_IsPastReportingWeek

!"SUPCT"=StocktonReportingInfo
!"LODI"=LodiReportingInfo
!"TRACY"=TracyReportingInfo
!"MAN"=MantecaReportingInfo
[SetLocationSpecificMessages]
type=changevariable
CourtParking="CourtParking"%Jury_ReportingLocationID
CourtName="CourtName"%Jury_ReportingLocationID
CourtAddress="CourtAddress"%Jury_ReportingLocationID
CourtReportOn="CourtReportOn"%Jury_ReportingLocationID

[DetermineReportingWeekState]
type=log
var=Jury_IsReportingWeek,Jury_IsPastReportingWeek

[CheckIsPastReportingWeek]
type=branch
var=Jury_IsPastReportingWeek
1=SetIsPastReportingWeek
0=CheckIsReportingWeek

[SetisPastReportingWeek]
type=changevariable
ReportingWeekState="PastReportingWeek"
Next=logReportingWeekState

[CheckIsReportingWeek]
type=branch
var=Jury_IsReportingWeek
1=SetIsReportingWeek
0=CheckIsBeforeReportingWeek

[SetIsReportingWeek]
type=changevariable
ReportingWeekState="isReportingWeek"
Next=logReportingWeekState

[CheckIsBeforeReportingWeek]
type=ChangeVariable
Jury_fn_i_Expression="Jury_IsReportingWeek==false && Jury_IsPastReportingWeek==false"
Jury_fn_i_VariableName="BooleanResult"

[ExecuteEvaluateExpression]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="fn_EvaluateBooleanExpression"
OnExecuteError=logCheckError
Next=CheckBooleanResult1

[LogCheckError]
type=log
var=Result,ResultMessage
Next=StatE_SystemError

[CheckBooleanResult1]
type=Branch
var=Jury_BooleanResult
0=LogReportingWeekError
1=SetBeforeReportingWeek

[SetBeforeReportingWeek]
type=changevariable
ReportingWeekState="BeforeReportingWeek"
Next=logReportingWeekState

[LogReportingWeekError]
type=log
logmsg="Error calculating Reporting Week window"

[logReportingWeekState]
type=log
var=ReportingWeekState
Next=VerifyName

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
! Record not found
[StatE_RecordNotFound]
Type=Log
LogMsg="Record not found"
Next=RecordNotFound


!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!========================================
!RecordNotFound
!========================================
[RecordNotFound]   ! page 041
type=Recognize
NoInputTimeOutMSec=10000
!RecognizerFailureMsg="SpeechRecSystemError"
IntroMsg="RecordNotFound",Jury_JurorID|C
IntroMsgDTMF="RecordNotFound",Jury_JurorID|C
PromptMsg="RecordNotFoundMenu"
PromptMsgDTMF="RecordNotFoundMenuDTMF"
grammar="ReenterID"
HelpMsg="StandardHelp"
MisrecognizeMsg="TryAgain"
