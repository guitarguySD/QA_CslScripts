! Application Self test
! 
[SelfTest]
type=log
logmsg="ExSelfTest"

![bypassselftestwhenemergencytrue]
!type=branch
!var=UseEmergencyReportingInstructions
!1=ST_RetrievalOK

[STSetVars]
type=changeVariable
