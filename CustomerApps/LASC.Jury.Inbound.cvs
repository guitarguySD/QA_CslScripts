Decrement=RemainingDatesAvailable

[LogPPDateVarsNextSet]
type=log
var=AvailableDateCounter,RemainingDatesAvailable,PostponementDateCount,PostponementDateCurrentIndex,PostponementDate
Next=CheckNumberOfAvailableDates

