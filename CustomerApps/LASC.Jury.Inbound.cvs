NoInputTimeOutMSec=2000
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnDTMFError=StatE_Sorry
OnDTMFTimeout=Exit
RecognizeFailureMsg="Silence"
SuccessMsg="OK"

!--------------------------------------------------
! Main Menu
!--------------------------------------------------
[MainMenu]
type=play
msg="MainMenu"

[CheckFirstTimeForGJMsg]
type=branch
var=FirstTimeMainMenu
1=CheckJurorTypeForGJMsg
0=SetFirstTimeFalse

[CheckJurorTypeForGJMsg]
type=branch
var=JurorTypeEnum
"Grand"=PlayNotPermittedToTransfer
Next=SetFirstTimeFalse

[PlayNotPermittedToTransfer]
type=play
msg="NotPermittedTransfer"

[SetFirstTimeFalse]
type=changeVariable
FirstTimeMainMenu=0
Next=BranchForMainMenuSettings

[BranchForMainMenuSettings]
type=branch
var=JurorStatusEnum
"Candidate"=Exit
"Exempt"=SetExcusedOptions
"FTA"=FTA
"Non-Responded FTA"=FTA
"OSC Issued"=SetScreenMainMenuError
"Panel"=SetServingOptions
"Postponed"=SetDeferredOptions
"Responded FTA"=FTA
"Summoned"=SetSummonedOptions
"Undefined"=SetUndefinedOptions
"Undeliverable"=SetScreenMainMenuError
"Unqualified"=SetUnqualifiedOptions
"Sanctioned"=SetSanctionedOptions
"Pending"=SetPendingOptions
"SummonException"=SetUndefinedOptions
!"Excused"=SetExcusedOptions
Excused=Exit
Next=SetScreenMainMenuError

[SetScreenMainMenuError]
type=changeVariable
ScreenMsg="Transfer JurorStatus "%JurorStatusEnum
Next=ACDAvailable

!-----------------------------------------------
! Menu options for each STATE.
! 
[SetUndefinedOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 0
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption0 = 1
@PlayOption9 = 1
Next=CheckGlobalDeferrals

[SetPendingOptions]
type=changeVariable
@PlayOption1 = 0
@PlayOption2 = 0
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 1
@PlayOption0 = 1
@PlayOption9 = 1
Next=CheckGlobalDeferrals

[SetSanctionedOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 0
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals

[SetPoolOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 0
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals

[SetSummonedOptions]
type=branch
var=HasPreviousFailedToAppear
1=SetSummonedFTAOptions

[SetSummonedOptions2]
type=changeVariable
!@PlayOption1 = IsEligibleForPostponement
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 1
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals

[SetSummonedFTAOptions]
type=changeVariable
!@PlayOption1 = IsEligibleForPostponement
@PlayOption1 = 0
@PlayOption2 = 0
@PlayOption3 = 0
@PlayOption4 = 0
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals

[SetExcusedOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 0     
@PlayOption5 = 0
@PlayOption0 = 1
Next=CheckGlobalDeferrals


[SetDeferredOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 1     
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals

[SetQualifiedOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 1     
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals


[SetServingOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 1
@PlayOption5 = 1
@PlayOption0 = 1
Next=CheckGlobalDeferrals


[SetServiceEndedOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 1
@PlayOption5 = 0
@PlayOption0 = 1
Next=CheckGlobalDeferrals


[SetUnqualifiedOptions]
type=changeVariable
@PlayOption1 = IsEligibleForPostponement
@PlayOption2 = IsEligibleForExcusal
@PlayOption3 = IsEligibleForTransfer
@PlayOption4 = 0
@PlayOption5 = 0
@PlayOption0 = 1
Next=CheckGlobalDeferrals


!--------------------------------------------------
! If AllowDeferrals is False, turn off Deferrals
! 
[CheckGlobalDeferrals]
type=branch
var=AllowDeferrals
0=SetNoDeferrals
Next=CheckGlobalExcusals

[SetNoDeferrals]
type=ChangeVariable
@PlayOption1=0

!---------------------------------------------------------------
! If AllowExcusals is False, turn off Disqualifications
! 
[CheckGlobalExcusals]
type=branch
var=AllowExcusals
0=SetNoExcusals
Next=CheckGlobalTransfers

[SetNoExcusals]
type=changeVariable
@PlayOption2 = 0
Next=CheckGlobalTransfers

!---------------------------------------------------------------
! If AllowTransfers is False, turn off Transfers
! 
[CheckGlobalTransfers]
type=branch
var=AllowTransfers
0=SetNoTransfers
Next=CheckGJTransfer

[SetNoTransfers]
type=changeVariable
@PlayOption3 = 0
Next=CheckGJTransfer

!---------------------------------------------------------------
! Grand Jurors cannot transfer. Hard coded. Record from db is wrong.
! 
[CheckGJTransfer]
type=branch
var=JurorTypeEnum
"Petit"=LastCheckOfOptions
"Grand"=SetNoGJTransfers

[SetNoGJTransfers]
type=changeVariable
@PlayOption3=0
Next=LastCheckOfOptions

!-------------------------------------------------------
! This checks that the caller has at least two options
! 
[LastCheckOfOptions]
type=changeVariable
fn_i_Expression="(@playOption1=='0' && @playOption2=='0' && @playOption3=='0' && @playOption4=='0')"
fn_i_VariableName="NoMainMenuOptions"

[ExecuteCheckNoMainMenuOptions]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="fn_EvaluateBooleanExpression"
OnExecuteError=CheckNoMainMenuOptionsResult
Next=CheckNoMainMenuOptionsResult

[CheckNoMainMenuOptionsResult]
type=branch
var=NoMainMenuOptions
0=MainMenuBlock
1=SetNoOptionsOptions
Next=SetNoOptionsOptions

[SetNoOptionsOptions]
type=changeVariable
@playOption0=1
@playOption9=1

[LogPlayOptionsForMainMenu]
type=log
var=JurorID,@playOption1,@playOption2,@playOption3,@playOption4,@playOption5,@playOption6,@playOption7,@playOption8,@playOption9,@playOption0,IsEligibleForPostponement,IsEligibleForExcusal,IsEligibleForTransfer
next=MainMenuBlock

!--------------------------------------------------
! Juror Menu Block
!--------------------------------------------------
[MainMenuBlock] 
type=Recognize
PromptMsg="YourOptionsAre","MainMenu1"|X|1,"MainMenu2"|X|2,"MainMenu3"|X|3,"MainMenu4"|X|4,"MainMenu5"|X|5,"MainMenu9"|X|9,"MainMenu0"|X|0,"OrHearAgain"
PromptMsgDTMF="MainMenu1DTMF"|X|1,"MainMenu2DTMF"|X|2,"MainMenu3DTMF"|X|3,"MainMenu4DTMF"|X|4,"MainMenu5DTMF"|X|5,"MainMenu9DTMF"|X|9,"MainMenu0DTMF"|X|0,"MainMenuLastDTMF"
Grammar="MainMenu.grxml"
OnKey1=StatE_RequestPostponement
OnKey2=StatE_RequestExcusal
OnKey3=StatE_RequestTransfer
OnKey4=StatE_WorkCertificate
OnKey5=OrientationBegins
OnKey9=Exit
OnKey0=SetScreenMainMenuBlock
OnKeyStar=MainMenu
OnKeyPound=JurorDisposition
OnResult:Postpone=StatE_RequestPostponement
OnResult:Excuse=StatE_RequestExcusal
OnResult:Transfer=StatE_RequestTransfer
OnResult:WorkCert=StatE_WorkCertificate
OnResult:Agent=SetScreenMainMenuBlock
OnResult:HearAgain=MainMenu
OnResult:Repeat=MainMenu
OnResult:EndCall=Exit
FlushKeys=1
MaxRetryCount=3
OnMaxRetries=StatE_Sorry
ShiftToDTMFMsg="ShiftToDTMF"
OnDTMFError=StatE_Sorry
OnDTMFTimeout=Exit
OnOtherResult=StatE_Sorry
BadKeyMsg="InvalidSelectionDTMF"        
NoInputTimeOutMSec=2000
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="SuccessMsg"
RecognizeFailureMsg="Silence"
MisrecognizeMsg="TryAgain"
Next=StatE_Sorry

[SetScreenMainMenuBlock]
type=changeVariable
ScreenMsg="Transfer JurorStatus "%JurorStatusEnum
Next=ACDAvailable

!--------------------------------------------------
! Request Postponement
!--------------------------------------------------
[StatE_RequestPostponement]
type=log
logmsg="Postponement"

[SetPostponePlayOptionsFalse]
type=changeVariable
@playOption1=0
@playOption2=0
@playOption3=0
@playOption4=0
@playOption5=0
@playOption6=0
@playOption7=0
@playOption8=0
@playOption9=0
@playOption0=0

[GetPostponementDates]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetPostponementDates"
OnExecuteError=CheckGetPostponementDatesResult
Next=CheckGetPostponementDatesResult

[LogGetPostponementExecuteError]
type=log
var=@Result,@ResultMessage,ResultCode,ErrorMessage
Next=StatE_SystemError

[CheckGetPostponementDatesResult]
type=branch
var=ResultCode
"OK"=SetPostponementCounters
Next=StatE_SystemError

![SetNumberOfAvailableDates]  !For testing
!type=changeVariable
!PostponementDateCount=0

[SetPostponementCounters]
type=changeVariable
RemainingDatesAvailable=PostponementDateCount

[LogPostponementVars]
type=log
var=PostponementDate,PostponementDateCount,PostponementDateCurrentIndex

[CheckNumberOfAvailableDates]
type=branch
var=RemainingDatesAvailable
CompareType=Integer
6=SetSixAvailablePostponementDates
5=SetAvailableDatesLimited
4=SetAvailableDatesLimited
3=SetAvailableDatesLimited
2=SetAvailableDatesLimited
1=SetAvailableDatesLimited
0=NoPostponementDatesAvailable
OnAboveRange=SetSixAvailablePostponementDates
OnBelowRange=NoPostponementDatesAvailable

[SetSixAvailablePostponementDates]
type=changeVariable
NumberOfAvailableDates=6
AvailableDateCounter=1
Next=GetSetOfAvailableDates

[SetAvailableDatesLimited]
type=changeVariable
NumberOfAvailableDates=RemainingDatesAvailable
AvailableDateCounter=1
Next=GetSetOfAvailableDates

!-------------------------------------
! Get Postponement Dates loop
!-------------------------------------
[GetSetOfAvailableDates]
type=log

[SetTheAppropriateDateVar]
type=branch
var=AvailableDateCounter
1=SetPPDate1
2=SetPPDate2
3=SetPPDate3
4=SetPPDate4
5=SetPPDate5
6=SetPPDate6

[SetPPDate1]
type=changeVariable
@playOption1=1
postponeDate1=PostponementDate
Next=GetNextPostponementDate

[SetPPDate2]
type=changeVariable
@playOption2=1
postponeDate2=PostponementDate
Next=GetNextPostponementDate

[SetPPDate3]
type=changeVariable
@playOption3=1
postponeDate3=PostponementDate
Next=GetNextPostponementDate

[SetPPDate4]
type=changeVariable
@playOption4=1
postponeDate4=PostponementDate
Next=GetNextPostponementDate

[SetPPDate5]
type=changeVariable
@playOption5=1
postponeDate5=PostponementDate
Next=GetNextPostponementDate

[SetPPDate6]
type=changeVariable
@playOption6=1
postponeDate6=PostponementDate
Next=FinishPPSetup

[GetNextPostponementDate]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetNextPostponementDate"
OnExecuteError=LogGetNextPostponementExecuteError
Next=UpdatePPDateVariables

[LogGetNextPostponementExecuteError]
type=log
var=@Result,@resultMessage,ResultCode,ResultMessage

[UpdatePPDateVariables]
type=changeVariable
Increment=AvailableDateCounter
Decrement=RemainingDatesAvailable

[LogPPDateVars]
type=log
var=AvailableDateCounter,RemainingDatesAvailable,PostponementDateCount,PostponementDateCurrentIndex,PostponementDate

[CheckAvailableDateCounter]
type=branch
var=AvailableDateCounter
NumberOfAvailableDates=SetTheAppropriateDateVar
OnBelowRange=SetTheAppropriateDateVar
OnAboveRange=FinishPPSetup

[FinishPPSetup]
type=log
var=postponeDate1,postponeDate2,postponeDate3,postponeDate4,postponeDate5,postponeDate6
Next=SetCountersForRequestDeferral

[SetCountersForRequestDeferral]
type=ChangeVariable
RetryCounter=0

!--------------------------------------------------
! Select from available postponement dates
!--------------------------------------------------
[SelectDate]
type=branch
var=NumberOfAvailableDates
6=SelectFromSixDates
5=SelectFromFiveDates
4=SelectFromFourDates
3=SelectFromThreeDates
2=SelectFromTwoDates
1=SelectFromOneDate
0=NoPostponementDatesAvailable
OnBelowRange=NoPostponementDatesAvailable
OnAboveRange=SelectFromSixDates

!--------------------------------
! Select Postponement Date SIX
!--------------------------------
[SelectFromSixDates]
type=Recognize
PromptMsg="PleaseSelect","One",postponeDate1"|D|mmm dd yyyy"
PromptMsg="Two",postponeDate2"|D|mmm dd yyyy"
PromptMsg="Three",postponeDate3"|D|mmm dd yyyy"
PromptMsg="Four",postponeDate4"|D|mmm dd yyyy"
PromptMsg="Five",postponeDate5"|D|mmm dd yyyy"
PromptMsg="Six",postponeDate6"|D|mmm dd yyyy"
PromptMsg="YourPostponeOptionsAre"
!PromptMsg="HearAgain"
PromptMsgDTMF="For",postponeDate1"|D|mmm dd yyyy","Press1"
PromptMsgDTMF="For",postponeDate2"|D|mmm dd yyyy","Press2"
PromptMsgDTMF="For",postponeDate3"|D|mmm dd yyyy","Press3"
PromptMsgDTMF="For",postponeDate4"|D|mmm dd yyyy","Press4"
PromptMsgDTMF="For",postponeDate5"|D|mmm dd yyyy","Press5"
PromptMsgDTMF="For",postponeDate6"|D|mmm dd yyyy","Press6"
PromptMsgDTMF="ToHearMoreDates","ReturnMain8"
PromptMsgDTMF="HearAgainDTMF"
Grammar="SelectDate.grxml"
OnKey1=SetPostponeDate1
OnKey2=SetPostponeDate2
OnKey3=SetPostponeDate3
OnKey4=SetPostponeDate4
OnKey5=SetPostponeDate5
OnKey6=SetPostponeDate6
OnKey7=GetNextSetOfDates
OnKey8=MainMenu
OnKey0=SetScreenMsgPostponement
OnKeyStar=SelectFromSixDates
OnKeyPound=SelectFromSixDates
OnResult:One=SetPostponeDate1
OnResult:Two=SetPostponeDate2
OnResult:Three=SetPostponeDate3
OnResult:Four=SetPostponeDate4
OnResult:Five=SetPostponeDate5
OnResult:Six=SetPostponeDate6
OnResult:MainMenu=MainMenu
OnResult:More=GetNextSetOfDates
OnResult:HearAgain=SelectFromSixDates
OnResult:Agent=SetScreenMsgPostponement
FlushKeys=1
MaxRetryCount=3
OnMaxRetries=StatE_Sorry
ShiftToDTMFMsg="ShiftToDTMF"
OnDTMFError=StatE_Sorry
OnDTMFTimeout=Exit
OnOtherResult=StatE_Sorry
BadKeyMsg="InvalidSelectionDTMF"        
NoInputTimeOutMSec=2000
TimeoutMsgDTMF="TimeoutDTMF"
SuccessMsg="SuccessMsg"
RecognizeFailureMsg="Silence"
MisrecognizeMsg="TryAgain"
Next=StatE_Sorry

