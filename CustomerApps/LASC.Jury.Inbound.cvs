type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="GetNextPostponementDate"
OnExecuteError=LogGetNextPostponementExecuteError

[UpdatePPDateVariablesNextSet]
