!========================================
! Set System Defaults
!========================================
[BlockDefaults]
Type=SetDefaults
!DefaultWaitForMsg=0     	! False
DefaultIgnoreMissingMsg=1    	! True
DefaultFlushKeys=0     		! False
DefaultBadKeyMsg="InvalidEntry"
DefaultMaxBadKeys=3
DefaultOnMaxBadKeys=StatE_Sorry
DefaultTimeOutSec=5
DefaultTimeOutMsg="NoInput"
DefaultMaxTimeOuts=3
DefaultOnMaxTimeOuts=StatE_Sorry
DefaultLogCall=1     		! True
DefaultLogMenu=1     		! True
DefaultLogGetDigits=1     	! True
DefaultLogPlay=1     		! True
DefaultTerminator=""

! JurorState maintains the state of the juror and controls flow
! in the script. 
! 
[SetJurorStateUNDEFINED] 
type=changeVariable
JurorStatusEnum="Undefined"
FirstRetrieval=1 

[GetInitialVariables]
type=VariableManager
VarList="CallbackFifoDisabled,CallbackAvailable,JuryServicesNumber,CriminalGJPhoneNumber,PayrollPhoneNumber,HIMPPhoneNumber,PermanentExcusePhoneNumber,SanctionsPhoneNumber,DayOfTheWeek,AssistanceAvailable,HolidayToday,OpeningTime,ClosingTime,CallinStartTime,CallinEndTime,MiddayCallinStartTime,MiddayCallinEndTime,OrientationCutoffTime,UseEmergencyReportingInstructions,AllowDeferrals,AllowExcusals,AllowTransfers,DBDown,TestRetrievalFailures"
OnError=LogVMError1
Next=BranchOnCallType

[LogVMError1]
type=log

[SetInitialVariablesOnVMError]
type=changeVariable
AssistanceAvailable=0
HolidayToday=0
ClosingTime="17:00:00"
OpeningTime="09:00:00"
CallinStartTime="17:00:00"
CallinEndTime="19:00:00"
MiddayCallinStartTime="11:00:00"
MiddayCallinEndTime="13:00:00"
OrientationCutoffTime="17:00:00"
AllowDeferrals = 1
AllowExcusals=1
AllowTransfers=1
UseEmergencyReportingInstructions=0
DBDown=0


[BranchOnCallType]
type=Branch
var=@CallType
1=GetCourtPhoneNumbers
!3=MaintenanceMode
!4=OverloadMode
10=SetCallbackCall
Next=GetCourtPhoneNumbers

[SetCallbackCall]
type=ChangeVariable
CallbackCall=1

[LogCallID]
type=log
var=@CallID
Next=StartCallback

[GetCourtPhoneNumbers]
type=VariableManager
Varlist="CourtPhone01,CourtPhone02,CourtPhone03,CourtPhone04,CourtPhone05,CourtPhone07,CourtPhone08,CourtPhone09,CourtPhone10,CourtPhone11,CourtPhone14,CourtPhone15,CourtPhone16,CourtPhone17,CourtPhone20,CourtPhone21,CourtPhone23,CourtPhone24,CourtPhone25,CourtPhone26,CourtPhone30,CourtPhone31,CourtPhone32,CourtPhone35,CourtPhone36,CourtPhone40,CourtPhone42,CourtPhone43,CourtPhone44,CourtPhone45,CourtPhone46,CourtPhone47,CourtPhone48,CourtPhone49,CourtPhone50,CourtPhone51"
OnError=LogVMError2
Next=CheckMaintenanceMode

[LogVMError2]
type=log
logmsg="Error getting court phone numbers"
Next=StatE_CallStarts

!---------------------------
! Maintenance Mode
! 
[CheckMaintenanceMode]
type=VariableManager
Varlist="MaintenanceMode,MaintenanceStartTime,MaintenanceEndTime"
OnError=LogVMError3
Next=MaintenanceModeCheck

[LogVMError3]
type=log
logmsg="Error getting court phone numbers"
Next=StatE_CallStarts

[MaintenanceModeCheck]
type=branch
var=MaintenanceMode
0=StatE_CallStarts
1=PlayMaintenanceMode
Next=StatE_CallStarts

[PlayMaintenanceMode]
type=play
msg="MaintenanceMode1"
Next=Exit

{
[PlayMaintenanceMode]
type=menu
msg="Maintenance1"
msgstring=MaintenanceStartTime%"|D|h:n a/p"
msg="To"
msgstring=MaintenanceEndTime%"|D|h:n a/p"
msg="Maintenance2"
msgstring=MaintenanceEndTime%"|D|h:n a/p"
msg="Maintenance3"
OnKeyPound=StatE_Admin
TimeoutSec=1
MaxTimeouts=0
OnMaxTimeouts=Exit
Next=Exit
}
!---------------------------
! Call Start
[StatE_CallStarts]
type=log
logmsg="Call Starts"

[LogStartSpeechRec]
type=log

[StartSpeechRecognitionSession]
type=StartRecognitionSession
OnError=SessionStartError
Next=Greeting

[SessionStartError]
type=log

!--------------------------------------------------
! Greeting
!--------------------------------------------------
! 
[Greeting]
type=log

[GlobalOptionalGreeting]
type=play
Msg="Greeting"
Msg="Silence"
Msg="Silence"
msg="Notice"
msg="GlobalOptionalGreeting"
IgnoreMissingMsg=true
DoNotUseCache=true

[LanguageMenu]
type=branch
var=@RecognizeDtmfMode
0=LanguageASR
1=LanguageDTMF

[LanguageASR]
Type=Recognize
PromptMsg="LanguageEnglish","Silence","SpanishLanguage"   
PromptMsgDTMF="SpanishLanguage"      
Grammar="Language.grxml"
ResultFormat=DigitsOrResult
MisrecognizeMsg="TryAgain"
BadKeyMsg="TryAgain"
OnKey1=StatE_EnglishDTMF
OnKey2=StatE_SpanishDTMF
OnKey3=StatE_EnglishDTMF
OnKey4=StatE_EnglishDTMF
OnKey5=StatE_EnglishDTMF
OnKey6=StatE_EnglishDTMF
OnKey7=StatE_EnglishDTMF
OnKey8=StatE_EnglishDTMF
OnKey9=StatE_EnglishDTMF
OnKey0=StatE_EnglishDTMF
OnKeyStar=StatE_EnglishDTMF
OnKeyPound=StatE_Admin
OnResult:English=StatE_EnglishASR 
OnResult:Spanish=StatE_SpanishASR 
NoInputTimeOutMSec=500
MaxRetryCount=0
OnMaxRetries=StatE_EnglishDTMF
OnRecognitionError=CheckForKeystroke
OnDTMFError=StatE_EnglishDTMF
SuccessMsg="SuccessMsg" 
RecognizeFailureMsg="Silence"
ConfidenceThreshold=20

[CheckForKeystroke]
type=menu
OnKey1=StatE_EnglishDTMF
OnKey2=StatE_SpanishDTMF
OnKey3=StatE_EnglishDTMF
OnKey4=StatE_EnglishDTMF
OnKey5=StatE_EnglishDTMF
OnKey6=StatE_EnglishDTMF
OnKey7=StatE_EnglishDTMF
OnKey8=StatE_EnglishDTMF
OnKey9=StatE_EnglishDTMF
OnKey0=StatE_EnglishDTMF
OnKeyStar=StatE_EnglishDTMF
OnKeyPound=StatE_EnglishDTMF
MaxTimeouts=0
TimeOutSec=1
OnMaxTimeouts=StatE_EnglishASR

[LanguageDTMF]
Type=Recognize
PromptMsg="LanguageEnglish","SpanishLanguage"   
PromptMsgDTMF="SpanishLanguage"      
Grammar="Language.grxml"
ResultFormat=DigitsOrResult
MisrecognizeMsg="TryAgain"
BadKeyMsg="TryAgain"
OnKey1=StatE_EnglishDTMF
OnKey2=StatE_SpanishDTMF
OnKey3=StatE_EnglishDTMF
OnKey4=StatE_EnglishDTMF
OnKey5=StatE_EnglishDTMF
OnKey6=StatE_EnglishDTMF
OnKey7=StatE_EnglishDTMF
OnKey8=StatE_EnglishDTMF
OnKey9=StatE_EnglishDTMF
OnKey0=StatE_EnglishDTMF
OnKeyStar=StatE_EnglishDTMF
OnKeyPound=StatE_Admin
OnResult:English=StatE_EnglishASR 
OnResult:Spanish=StatE_SpanishASR 
NoInputTimeOutMSec=1500
MaxRetryCount=0
OnMaxRetries=StatE_EnglishDTMF
!OnRecognitionError=CheckForKeystroke
OnDTMFError=StatE_EnglishDTMF
SuccessMsg="SuccessMsg" 
RecognizeFailureMsg="Silence"
ConfidenceThreshold=20

