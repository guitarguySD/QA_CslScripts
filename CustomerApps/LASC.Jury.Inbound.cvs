!---------------------------
! Get Work Phone Number
!---------------------------
[GetWorkNumber]
type=recognize
PromptMsg="WorkPhone"
PromptMsgDTMF="WorkPhoneDTMF"
Grammar="Telephone.grxml"
var=WorkPhoneNumber
DTMFTerminator="#"
!MinDigitsMsg="ExpectingTenDigits"
!MaxDigitsMsg="ExpectingTenDigits"
MisrecognizeMsg="TryAgain"
TimeoutMsgDTMF="TryAgainDTMF"
ShiftToDTMFMsg="ShiftToDTMF"
OnKeyStar=GetWorkNumber
ResultFormat=Digits
!ResultLengthMin=10
!ResultLengthMax=10
!OnResult:NoCode=SetScreenMsgWorkPhoneNumber
OnDTMFError=StatE_Sorry
OnDTMFTimeout=Exit
BadKeyMsg="InvalidSelectionDTMF"
!TimeoutMsg="Timeout"
NoInputTimeOutMSec=2000
TimeoutMsgDTMF="TimeoutDTMF"
RecognizeFailureMsg="Silence"
SuccessMsg="Thanks"
!Next=GetHomeNumber
FlushKeys=True
Next=CheckWorkPhoneLength

[CheckWorkPhoneLength]
type=branch
var=@RecognizeLength
0=LogSkipWorkPhone
1=PlayWorkExpecting10Digits
2=PlayWorkExpecting10Digits
3=PlayWorkExpecting10Digits
4=PlayWorkExpecting10Digits
5=PlayWorkExpecting10Digits
6=PlayWorkExpecting10Digits
7=PlayWorkExpecting10Digits
8=PlayWorkExpecting10Digits
9=PlayWorkExpecting10Digits
10=PlayOKWorkPhone
OnAboveRange=PlayWorkExpecting10Digits
OnBelowRange=PlayWorkExpecting10Digits

[PlayWorkExpecting10Digits]
type=play
msg="ExpectingTenDigits"
Next=GetWorkNumber

[LogSkipWorkPhone]
type=log
logmsg="Juror "%JurorID%" skipped entering their work phone."

[PlayOKSkipWorkPhone]
type=play
msg="OK"
msg="Thanks"
Next=GetHomeNumber

[PlayOKWorkPhone]
type=play
msg="OK"
flushkeys=true

[MarkWorkPhoneNumberEntered]
type=changeVariable
HasEnteredBioInfo=1
Next=GetHomeNumber

[SetScreenMsgWorkPhoneNumber]
type=changeVariable
ScreenMsg="Trouble entering work phone"
Next=ACDAvailable

