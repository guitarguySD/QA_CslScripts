Next=DirectToCourtroomMenu

[PlayDashBusService]
type=play
msg="DashBusService"
Next=DirectToCourtroomMenu

!---------------------------
! Alternate location
! When UseAlternateLocation = 1, the text in ReportingMessage is voiced using TTS.
! The format can be plain text or SSML as determined by the value of ReportingMessageType
! Both of these variables are fetched from JMIS in the Get Reporting Instructions API call. 
! 
[PlayAlternateLocation]
type=log

[SetAlternateParkingInfo]
type=changevariable
CourtParking="CourtParking100"

[CheckMsgType]
type=branch
var=ReportingMessageType
"Text"=VoicePlainTextTTS
"SSML"=VoiceSSMLTTS
Next=VoicePlainTextTTS

[VoicePlainTextTTS]
type=play
TTSString=ReportingMessage
TTSFormat="Text"
Next=DirectToCourtroomMenu

[VoiceSSMLTTS]
type=play
TTSString=ReportingMessage
TTSFormat="SSML"
Next=DirectToCourtroomMenu

