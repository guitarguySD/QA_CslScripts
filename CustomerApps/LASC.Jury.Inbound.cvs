!----------------------------
! Check Qualification Responses
! Felony = Yes may be offset by RightsRestored = Yes
!----------------------------
[CheckQualificationResponses]
type=ChangeVariable
AnswerSum=Q1Answer+Q2Answer+Q3Answer+Q4Answer+Q5Answer+Q6Answer+Q6GJAnswer+Q7Answer+Q8Answer+Q9Answer+Q10Answer+QMalfeasanceAnswer+QIncarceratedAnswer+QFelonyProbationAnswer+QRegisteredSexOffenderAnswer

[CheckAnswerSum]
type=branch
var=AnswerSum
"0"=MayBeQualified	! If it's zero, no disqualifications
"1"=CheckFelony		! If it's 1, felony may not actually be disqualifying
OnAboveRange=MayBeDisqualified

[CheckFelony]	! check to see if rights have been restored
type=ChangeVariable
fn_i_Expression="IsConvictedOfFelony=='Yes' && IsFelonyRestored=='Yes'"
fn_i_VariableName="RightsRestored"

[LogCheckFelonyInput]
type=log
var=IsConvictedOfFelony,IsFelonyRestored,fn_i_Expression,fn_i_VariableName 

[ExecuteCheckFelonyRightsRestored]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="fn_EvaluateBooleanExpression"
OnExecuteError=CheckFelonyResult
Next=LogCheckFelonyResult

[LogCheckFelonyError]
type=log
var=@Result,@ResultMessage,ResultCode,ErrorMessage
Next=StatE_SystemError

[LogCheckFelonyResult]
type=log
var=RightsRestored

[CheckFelonyResult]
type=branch
var=RightsRestored
0=CheckSpecificDisqualificationOnly
1=MayBeQualified

!----------------------------------------------------------------------------------
! Special Single Disqualification check
! If any one and only one of (IsEnglishProficient,IsCountyResident,IsPeaceOfficer)
! is disqualifying, caller goes down a special path
[CheckSpecificDisqualificationOnly]
type=log
var=JurorID,IsEnglishProficient,IsCountyResident,IsPeaceOfficer

[CalculateIsOneOfSpecialSingleDisqualifications]
type=changeVariable
!fn_i_Expression="((IsEnglishProficient=='No' ^ IsCountyResident=='No') ^ IsPeaceOfficer=='Yes')"
fn_i_Expression="(((IsEnglishProficient=='No' ^ IsCountyResident=='No') ^ IsPeaceOfficer=='Yes') ^ IsMilitary =='Yes')"
fn_i_VariableName="SpecialSingleDisqualOnly"

[ExecuteSpecialSingleDisqual]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="fn_EvaluateBooleanExpression"
OnExecuteError=CheckSpecialDisqualsResult
Next=CheckSpecialDisqualsResult

[LogCheckSpecialDisqualError]
type=log
var=@Result,@ResultMessage,ResultCode,ErrorMessage
Next=StatE_SystemError

[CheckSpecialDisqualsResult]
type=log
var=JurorID,IsEnglishProficient,IsCountyResident,IsPeaceOfficer,IsMilitary,SpecialSingleDisqualOnly
Next=MayBeDisqualified

!----------------------------
! May Be Qualified
!----------------------------
[MayBeQualified]
type=play
msg="MayBeQualified"
msg=QualReason1
msg=QualReason2
msg=QualReason3
msg=QualReason4
msg=QualReason5
msg=QualReason6GJ
msg=QualReason6
msg=QualReasonMalfeasance
msg=QualReason7
msg=QualReason8
msg=QualReason9
msg=QualReason10
msg=QualReasonIncarcerated
msg=QualReasonFelonyProbation
msg=QualReasonRegisteredSexOffender

[MayBeQualifiedMenu]
