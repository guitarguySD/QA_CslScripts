!---------------------------
[UpdateQualified2]
type=branch
var=JurorTypeEnum
"Petit"=QualifyPetit
"Grand"=QualifyGrand
Next=StatE_SystemError

!-------------------------
! Qualify Petit
[QualifyPetit]
type=log
!type=changeVariable
!IsSignedUnderPenalty="Yes"

[SubmitQualifiedAffidavitConfirmation]
type=ExecuteRoutine
DLL="Cvp.Universal.DllLoader\Sonant.Cvp.Universal.DllLoader.dll"
Routine="SubmitQualifyQuestionnaire"
OnExecuteError=LogUpdateQualified2ExecuteError
Next=CheckUpdateQualified2Result

[LogUpdateQualified2ExecuteError]
type=log
var=@Result,@ResultMessage,ResultCode,ErrorMessage
Next=CheckUpdateQualified2Result

[CheckUpdateQualified2Result]
type=branch
var=ResultCode
"OK"=UpdateQualified2Success
Next=StatE_SystemError

[UpdateQualified2Success]
type=play
msg="CertifiedQualified"
Next=CheckRegistrationWindow

