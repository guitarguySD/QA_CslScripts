!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!========================================
!Spanish Selected
!========================================
[SpanishSelected]   ! page 06
Type=Log
LogMsg="Calls Spanish"

[SetSpanish]
type=changevariable
CallerLanguage="Spanish"

[SetToSpanishLanguage]
type=setglobals
Language="Spanish"
Next=NE_CheckDBDown

!========================================
!Russian Selected
!========================================
[RussianSelected]   ! page 06
Type=Log
LogMsg="Calls Russian"

[SetRussian]
type=changevariable
CallerLanguage="Russian"

[SetToRussianLanguage]
type=setglobals
Language="Russian"
Next=NE_CheckDBDown

!===================================
! Non English
[NE_CheckDBDown]
type=Branch
var=DbDown
0=NonEnglishJuror
1=NE_PlayDbDown

[NE_PlayDbDown]
type=play
msg="JSIDbDownContinue"
Next=Exit

[NonEnglishJuror]
Type=play
msg="NonEnglishJuror"

[NonEnglishJurorMenu]
type=menu
msg="NonEnglishJurorMenu"
OnKey1=ContinueInEnglish
OnKey2=NE_GetJurorIdStart
OnKeyStar=NonEnglishJuror
OnKeyPound=NonEnglishJurorMenu

[ContinueInEnglish]
type=play
msg="NE_ContinueInEnglish"
WaitForMsg=true

[RestLanguageToEnglish]
type=SetGlobals
Language="English"
Next=SetModeToEnglishDTMF

!=======================================================================
! NonEnglish - Get Juror ID
!=======================================================================
[NE_GetJurorIdStart]
type=changeVariable
ErrorCounter=0

[NE_GetJurorID]
type=GetDigits
msg="NE_EnterJurorIDDTMF"
var=Jury_JurorID
MinDigits=7
MaxDigits=10
Terminator="#*"
CountVar=BadgeLength
Next=NE_CheckBadgeLength

[NE_CheckBadgeLength]
type=Branch
var=BadgeLength
9=NE_VerifyBadgeNumber
OnAboveRange=NE_ExpectingNine
OnBelowRange=NE_ExpectingNine

[NE_ExpectingNine]
type=play
msg="ExpectingNineDTMF"
Next=NE_GetJurorId


[NE_VerifyBadgeNumber]
type=play
msg="NE_BadgeNumberIsDTMF"
msgstring=Jury_JurorID

[NE_VerifyBadgeMenu]
type=menu
msg="NE_VerifyBadgeMenuDTMF"
OnKey1=NE_RetrieveRecord
OnKey2=ReenterJid

[ReenterJid]
type=changeVariable
increment=ErrorCounter

[CheckErrorCounter]
type=branch
var=ErrorCounter
2=StatE_Sorry
OnBelowRange=NE_GetJurorId
OnAboveRange=StatE_Sorry

!-------------------------------------
! NE Retrieve Record
[NE_RetrieveRecord]
Type=Branch
Var=HostAvailable
0=NE_SetUnknownID
Next=NE_HoldForRecord

[NE_SetUnknownID]
Type=ChangeVariable
UnknownID=1

[NE_DataUnavailable2]
Type=Play
Msg="DataUnavailable"
Next=Exit

[NE_HoldForRecord]
Type=Play
Msg="HoldForRecord"
Msg="Silence"
WaitForMsg=true

[NE_LogJury_JurorID]
Type=Log
var=Jury_JurorID

[NE_HoldMusicForGetJurorRecord]
type=Play
msg="$MusicOnHold1"
msg="Silence"
msg="$MusicOnHold2"
msg="Silence"
msg="$MusicOnHold3"
msg="Silence"
msg="$MusicOnHold4"
msg="Silence"


[NE_ExecuteRecordRetrieval]
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.dll"
Routine="Jury_GetJurorRecord"
OnExecuteError=StatE_SystemError

[NE_DoneHolding]
type=play
FlushPlayQueue=true

[NE_LogGetJurorRecordResult]
type=log
var=Jury_JurorID,Jury_Result
!logmsg="Jury_Result="%Jury_Result

!+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[NE_CheckRetrieveResult]   ! Guardian redirected to system error  page 023
Type=Branch
Var=Jury_Result
0=NE_RecordFound
25=NE_RecordNotFound
23=NE_RecordNotFound
1=StatE_ClientError
2=StatE_ClientError
3=StatE_ServerError
4=StatE_ServerError
5=StatE_CommunicationError
6=StatE_CommunicationError
7=StatE_CommunicationError
8=StatE_CommunicationError
9=StatE_CommunicationError
10=StatE_CommunicationError
11=StatE_ClientError
12=StatE_ClientError
13=StatE_ClientError
14=StatE_ClientError
15=StatE_ClientError
16=StatE_JSIError
17=StatE_JSIError
18=StatE_JSIError
19=StatE_JSIError
20=StatE_JSIError
21=StatE_JSIError
22=StatE_JSIError
24=StatE_JSIError
Next=StatE_SystemError

[NE_RecordNotFound]
type=log
var=Jury_JurorID

[NE_PlayRecordNotFound]
type=play
msg="NE_RecordNotFound"
msgstring=Jury_JurorId
msg="NE_PleaseTryAgain"
Next=NE_GetJurorID

[NE_RecordFound]
type=log
var=Jury_JurorId

[NE_VerifyName]
type=log
logmsg=Jury_Name

[NE_SpellName]
type=play
msg="NE_VerifyName"
msgstring=Jury_LastName%"|C"

[NE_VerifyNameMenu]
type=menu
msg="NE_VerifyNameMenu"
OnKey1=NE_CheckStatus
OnKey2=NE_GetJurorID

[NE_CheckStatus]
Type=Branch
Var=Jury_Status
"P"=NE_StatusIsIorP
"A"=NE_AllOther
"B"=NE_StatusIsCorB
"R"=NE_AllOther
"C"=NE_StatusIsCorB
"I"=NE_StatusIsIorP
"F"=NE_StatusIsF
"X"=NE_StatusIsCorB
Next=NE_AllOther

[NE_AllOther]
type=play
msg="NE_AllOtherStatuses"
WaitForMsg=true

[SetScreenMsgNEAllOther]
Type=ChangeVariable
ScreenMsg="Spanish, Status issue"
JSI_OperatorMessageCode=1
Next=ACDAvailable


[NE_StatusIsCorB]
type=play
msg="NE_StatusCorB"
WaitForMsg=true
Next=Exit

[NE_StatusIsF]
type=play
msg="NE_StatusF"
WaitForMsg=true
Next=Exit

[NE_StatusIsIorP]
type=log

[NE_FTACheck]
Type=Branch
Var=Jury_HasFailedToAppear
0=NE_Disqualify
1=NE_JurorFTA         
Next=NE_Disqualify

[NE_JurorFTA]
type=log
Next=NE_Disqualify

!----------------------------------------
! Disqualification Menu
! 
[NE_Disqualify]
type=menu
msg="NE_QualifyMenuDTMF"
OnKey1=NE_Language
OnKey2=NE_NonCitizen
Onkey8=NE_Qualified
OnKey0=SetScreenMsgNEDisqualify

!--------------------
! Requested Agent
[SetScreenMsgNEDisqualify]
Type=ChangeVariable
ScreenMsg="Spanish, Disqualify"
JSI_OperatorMessageCode=1
Next=ACDAvailable

!-----------------------
! Caller thinks they are qualified
[NE_Qualified]
type=play
msg="NE_ContinueInEnglish"

[NE_ResetToEnglish]
type=changeVariable
CallerLanguage="English"

[SetToEnglishLanguage]
type=setglobals
Language="English"
Next=NameIsValid

!------------------------------------------------------------
! Qualification or disqualification
! 
[NE_Language]
type=changeVariable
Jury_TypeCode="DP"
Jury_ReasonCode="LG"
PerjuryNoticeMsg="ExcuseMsgDPLG"
Next=NE_AutoApproved

[NE_NonCitizen]
type=changeVariable
Jury_TypeCode="DP"
Jury_ReasonCode="NC"
PerjuryNoticeMsg="ExcuseMsgDPNC"
Next=NE_AutoApproved

[NE_AutoApproved]
type=play
msg=PerjuryNoticeMsg

! 1 = under POP, all is true
! 2 = back to previous menu
[NE_AutoApprovedMenu]
type=menu
msg="NE_PerjuryMenuDTMF"
OnKey1=NE_ProcessRequest
OnKey2=NE_Disqualify
Onkey0=SetScreenMsgNEAutoApprove

! On key 0
[SetScreenMsgNEAutoApprove]
Type=ChangeVariable
ScreenMsg="Disqualification, Spanish"
JSI_OperatorMessageCode=1
Next=ACDAvailable

! On key 1
[NE_ProcessRequest]
type=log
var=Jury_JurorID,Jury_TypeCode,Jury_ReasonCode

[NE_UpdateDisqusal]  
Type=ExecuteRoutine
DLL="SonantJsiCvpClient.dll"
Routine="Jury_ServiceEnd"
OnExecuteError=StatE_SystemError

[NE_LogNEDisqusalResult]
type=log
var=Jury_JurorID,Jury_Result, Jury_TypeCode, Jury_ReasonCode

[NE_CheckUpdateDisqusalResult]
Type=Branch
Var=Jury_Result
0=NE_SuccessfulDisqusal
Next=NE_UnsuccessfulDisqual

!-------------------------------------
! Disqualification failed
[NE_UnsuccessfulDisqual]
type=log
logType=ScriptEvent
logmsg="NE_Disqual_Failed"

!----------------------
! Check if juror was FTA
[NE_FailedFTACheck]
Type=Branch
Var=Jury_HasFailedToAppear
0=NE_PlayProblemTransfer
1=NE_PlayFTAProblem       
Next=NE_PlayProblemTransfer

!------------------------------
! Unsuccesful disqual - Juror FTA
[NE_PlayFTAProblem]
type=play
msg="NE_FTADisqualProblem"
WaitForMsg=true

[NE_LogDisqualFailedFTA]
type=log
logType=ScriptEvent
logmsg="NE_Disqual_FTA"

[SetScreenMessageNE_FTADisqual]
type=changevariable
ScreenMsg="NonEnglish Disqual FTA"
Next=ACDAvailable

!-----------------------------------------
! Unsuccesful disqual - some other problem
[NE_PlayProblemTransfer]
type=play
msg="NE_SorryProblem"
WaitForMsg=true

[SetScreenMsgNE_DisqusalFailed]
type=changeVariable
ScreenMsg="NonEnglish Excusal Failed"
Next=ACDAvailable

!-----------------------------------------
! Successful NonEnglish Disqualification
[NE_SuccessfulDisqusal]
type=log
logType=ScriptEvent
logmsg="NE_Disqual_Success"

[NE_PlaySuccessDisqual]
type=play
msg="DisqualGranted"
WaitForMsg=true
Next=Exit
