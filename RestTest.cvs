!======================================
! Ping endpoint
[PingRestApiCall]
type=RestApi
Method=POST
!Url="https://fjd-sandbox.avenujury.com/base/rest/ivr/ping"
Url=PingEndpoint
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"]
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    vars["ApiStatus"] = root.GetProperty("status").GetString() ?? "";
    vars["ApiErrorCode"] = root.GetProperty("errorCode").GetString() ?? "";
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=PingLogStatus
Next=PingLogStatus

[PingLogStatus]
type=Log
Var=ApiStatusCode,ApiSuccess,ApiError,ApiJurorInformation,ApiStatus,ApiErrorCode

[CheckPingStatus]
type=play
ttsstring="Neumo test complete. NeumoAPI status was"
msgstring=ApiStatus%"|C"
ttsstring="Getting Juror information. Please wait."

!======================================
! Get Juror Info
[PlayTestingGetJuror]
type=Play
ttsstring="Testing Get Juror Info API. Please wait."

[SetJurorInfoRequest]
type=ChangeVariable
JurorId="000032283"
JurorDOB="01011961"

[NeumoGetJurorInfoApiCall]
type=RestApi
Method=POST
!Url="https://fjd-sandbox.avenujury.com/base/rest/ivr/jurorinfo"
url=GetJurorInfoEndpoint
!ContentType="application/json"
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        jurorID = vars["JurorId"],
        dob = vars["JurorDOB"]
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
using System.Text.Json;

var root = JsonDocument.Parse(response).RootElement;

// Root level
vars["CT_ResultCode"]    = root.TryGetProperty("status",    out var status)    ? status.GetString()    ?? "" : "";
vars["CT_ResultMessage"] = root.TryGetProperty("errorCode", out var errorCode) ? errorCode.GetString() ?? "" : "";

// jurorInformation block
if (root.TryGetProperty("jurorInformation", out var juror))
{
    vars["CT_JurorState"]        = juror.TryGetProperty("personStatus",      out var v) ? v.GetString() ?? "UNKNOWN" : "UNKNOWN";
    vars["CT_JurorID"]           = juror.TryGetProperty("jurorID",           out v) ? v.GetString() ?? "" : "";

    vars["CT_DOB"]               = juror.TryGetProperty("dob",               out v) ? v.GetString() ?? "" : "";

    vars["CT_FirstName"]         = juror.TryGetProperty("nameFirst",         out v) ? v.GetString() ?? "" : "";
    vars["CT_FirstInitial"]      = juror.TryGetProperty("nameFirst",         out v) ? (v.GetString() ?? "").Substring(0, Math.Min(1, (v.GetString() ?? "").Length)) : "";
    vars["CT_LastName"]          = juror.TryGetProperty("nameLast",          out v) ? v.GetString() ?? "" : "";
    vars["CT_FullName"]          = $"{vars["CT_FirstName"]} {vars["CT_LastName"]}".Trim();
    vars["CT_Middle"]            = juror.TryGetProperty("nameMiddle",        out v) ? v.GetString() ?? "" : "";
    vars["CT_NameSuffix"]        = juror.TryGetProperty("nameSuffix",        out v) ? v.GetString() ?? "" : "";
    vars["CT_ReportingStatus"]   = juror.TryGetProperty("reportingStatus",   out v) ? v.GetString() ?? "" : "";
    // Combine JurorState and ReportingStatus 
    vars["CT_JurorState"] = vars["CT_JurorState"] == "Qualified" ? $"{vars["CT_JurorState"]}{vars["CT_ReportingStatus"]}" : vars["CT_JurorState"];
    vars["CT_ScheduledDate"]     = juror.TryGetProperty("reportingDate",     out v) && v.GetString()?.Length == 8 && DateTime.TryParseExact(v.GetString(), "MMddyyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime schDt) ? schDt.ToString("yyyy-MM-ddTHH:mm:ss") : "";

    vars["CT_ScheduledTime"]     = juror.TryGetProperty("reportingTime",     out v) ? v.GetString() ?? "" : "";
    vars["CT_LocationCode"]      = juror.TryGetProperty("courtLocationCode", out v) ? v.GetString() ?? "" : "";
    vars["CT_LocationName"]      = juror.TryGetProperty("courtLocationName", out v) ? v.GetString() ?? "" : "";
    vars["CT_Street1"]           = juror.TryGetProperty("street",            out v) ? v.GetString() ?? "" : "";
    vars["CT_Street2"]           = juror.TryGetProperty("street2",           out v) ? v.GetString() ?? "" : "";
    vars["CT_City"]              = juror.TryGetProperty("city",              out v) ? v.GetString() ?? "" : "";
    vars["CT_State"]             = juror.TryGetProperty("state",             out v) ? v.GetString() ?? "" : "";
    vars["CT_Zipcode"]           = juror.TryGetProperty("zipCode",           out v) ? v.GetString() ?? "" : "";

    vars["CT_ServiceStartDate"]  = juror.TryGetProperty("serviceStartDate",  out v) && v.GetString()?.Length == 8 && DateTime.TryParseExact(v.GetString(), "MMddyyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime ssdDt) ? ssdDt.ToString("yyyy-MM-ddTHH:mm:ss") : "";

    vars["CT_ServiceEndDate"]    = juror.TryGetProperty("serviceEndDate",    out v) && v.GetString()?.Length == 8 && DateTime.TryParseExact(v.GetString(), "MMddyyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime sedDt) ? sedDt.ToString("yyyy-MM-ddTHH:mm:ss") : "";

    vars["CT_ReportingAtAfter"]  = juror.TryGetProperty("reportingAtAfter",  out v) ? v.GetString() ?? "" : "";

    vars["CT_BioComplete"]       = juror.TryGetProperty("bioComplete",       out v) ? v.GetBoolean().ToString() : "";
    vars["CT_PendingReview"]     = juror.TryGetProperty("pendingReview",     out v) ? (v.GetBoolean() ? "1" : "0") : "0";
    vars["CT_PoolID"]            = juror.TryGetProperty("poolID",            out v) ? v.GetString() ?? "" : "";
    vars["CT_LastPaymentAmount"] = juror.TryGetProperty("lastPaymentAmount", out v) ? v.GetString() ?? "" : "";

    vars["CT_LastPaymentDate"]   = juror.TryGetProperty("lastPaymentDate",   out v) && v.GetString()?.Length == 8 && DateTime.TryParseExact(v.GetString(), "MMddyyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime lpdDt) ? lpdDt.ToString("yyyy-MM-ddTHH:mm:ss") : "";

    vars["CT_LastMileage"]       = juror.TryGetProperty("lastMileage",       out v) ? v.GetString() ?? "" : "";
}
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogGetJurorInfoApiCallStatus
Next=LogGetJurorInfoApiCallStatus

[LogGetJurorInfoApiCallStatus]
type=Log
Var=ApiStatusCode,ApiSuccess,ApiError,ApiStatus

[LogRawJsonResponse]
type=Log
Var=rawJsonResponse

[LogJurorInfo]
type=Log
Var=CT_JurorState,CT_JurorID,CT_DOB,CT_FirstName,CT_FirstInitial,CT_LastName,CT_Middle,CT_NameSuffix,CT_ReportingStatus,CT_ScheduledDate,CT_ScheduledTime,CT_LocationCode,CT_LocationName,CT_Street1,CT_Street2,CT_City,CT_State,CT_Zipcode,CT_ServiceStartDate,CT_ServiceEndDate,CT_ReportingAtAfter,CT_BioComplete,CT_PendingReview,CT_PoolID,CT_LastPaymentAmount,CT_LastPaymentDate,CT_LastMileage

[LogDateParsing]
type=Log
Var=CT_ScheduledDate

[PlayGetJUrorStatus]
type=play
ttsstring="Neumo Get Juror info test complete. NeumoAPI status was"
msgstring=ApiStatus%"|C"
ttsstring="The name associated with the juror ID is"
msgstring=CT_LastName%"|C"

[GetPostponementInfo]
type=RestApi
Method=POST
!Url="https://fjd-sandbox.avenujury.com/base/rest/ivr/postponementinfo"
url=PostponementInfoEndpoint
!ContentType="application/json"
RequestScript="""
    using System.Text.Json;
    var requestBody = new {
        userId = vars["NeumoUserId"],
        password = vars["NeumoPassword"],
        jurorID = vars["JurorId"]
    };
    return JsonSerializer.Serialize(requestBody);
"""
ResponseScript="""
    using System.Text.Json;
    var root = JsonDocument.Parse(response).RootElement;
    
    // Root level
    vars["ApiStatus"] = root.TryGetProperty("status", out var status) ? status.GetString() ?? "" : "";
    vars["ApiErrorCode"] = root.TryGetProperty("errorCode", out var errorCode) ? errorCode.GetString() ?? "" : "";
    
    // jurorInformation block
    if (root.TryGetProperty("jurorInformation", out var jurorInformation))
    {
        vars["PostponeEligible"] = jurorInformation.TryGetProperty("postponeEligible", out var v) ? v.GetString() ?? "" : "";
        vars["PostponeIneligibleReason"] = jurorInformation.TryGetProperty("postponeIneligibleReason", out v) ? v.GetString() ?? "" : "";
        
        if (jurorInformation.TryGetProperty("calculatedPostponeDates", out var postponementDates))
        {
            vars["PostponeDate1"] = postponementDates.GetArrayLength() > 0 ? postponementDates[0].GetString() ?? "" : "";
            vars["PostponeDate2"] = postponementDates.GetArrayLength() > 1 ? postponementDates[1].GetString() ?? "" : "";
            vars["PostponeDate3"] = postponementDates.GetArrayLength() > 2 ? postponementDates[2].GetString() ?? "" : "";
        }
    }
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=LogPostponeApiCallStatus
Next=LogPostponeApiCallStatus

[LogPostponeApiCallStatus]
type=Log
Var=ApiStatusCode,ApiSuccess,ApiError,JurorInformation,ApiStatus

Next=RestTestMenu

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Minnesota REST API + ForEach Test
!
!  Calls MNCIS EligibleCasesForPayments API (Basic auth).
!  Parses the JSON response, then uses ForEach to iterate
!  over cases (outer loop) and payors (inner loop), logging
!  key fields at each level.
!
!  Flow:
!    RestApiTest
!      ? RestApiLogStatus
!        ? IterateCases  (MoveNext, outer loop)
!            OnSuccess ? ProcessCase (ElementScript: extract case fields + payors JSON)
!              ? LogCase
!                ? StartPayorIteration (MoveFirst, resets inner loop per case)
!                    OnSuccess ? LogPayor
!                      ? IteratePayors (MoveNext, inner loop)
!                          OnSuccess ? LogPayor  (loops back)
!                          OnComplete ? IterateCases  (advance outer loop)
!                    OnComplete ? IterateCases  (zero payors: advance outer loop)
!            OnComplete ? RestApiTestDone
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[MnApiTest]
type=Log

! --- Step 1: Call the API ---
[RestApiTest]
type=RestApi
Method=GET
Url="https://devqais.courts.state.mn.us/deve/webservices/MncisPayments/v1/EligibleCasesForPayments?CaseNumber=43-VB-25-4"
AuthType=Basic
AuthUsername="courts.state.mn.us/PaymentService"
AuthPassword="A+g6+NA4Jb8D%3%3$c~2~!87"
!Headers="accept": "text/plain"
TimeoutSeconds=30
ResponseScript="""
    var cases = JsonDocument.Parse(response).RootElement.GetProperty("cases");
	
    vars["ApiCasesJson"] = cases.GetRawText();
    vars["ApiCaseCount"] = cases.GetArrayLength().ToString();
"""
StatusCodeVar=ApiStatusCode
SuccessVar=ApiSuccess
ErrorVar=ApiError
OnError=RestApiTestError
Next=RestApiLogStatus

! --- Log API outcome before iterating ---
[RestApiLogStatus]
type=Log
Var=ApiStatusCode,ApiSuccess,ApiCaseCount
Next=IterateCases

! --- Outer loop: iterate cases ---
[IterateCases]
type=ForEach
ArrayVar=ApiCasesJson
CountVar=ApiCaseCount
CurrentVar=ApiCaseIdx
ElementScript="""
    vars["ApiCaseNumberResult"] = element.GetProperty("caseNumber").GetString() ?? "";
    vars["ApiCaseCategory"]     = element.GetProperty("caseCategory").GetString() ?? "";
    vars["ApiCaseType"]         = element.GetProperty("baseCaseType").GetString() ?? "";
    vars["ApiCaseEligible"]     = element.GetProperty("caseIsEligibleForPayment").GetBoolean().ToString();
    vars["ApiCaseStatus"]       = element.GetProperty("currentCaseStatusDescription").GetString() ?? "";
	
    var payors = element.GetProperty("payors");
    vars["ApiPayorsJson"]  = payors.GetRawText();
    vars["ApiPayorCount"]  = payors.GetArrayLength().ToString();
"""
OnSuccess=LogCase
OnError=RestApiTestError
OnComplete=RestApiTestDone

! --- Log case-level fields ---
[LogCase]
type=Log
Var=ApiCaseIdx,ApiCaseCount,ApiCaseNumberResult,ApiCaseCategory,ApiCaseType,ApiCaseEligible,ApiCaseStatus,ApiPayorCount
Next=IteratePayors

! --- Start inner loop at first payor (resets state for each case) ---
[IteratePayors]
type=ForEach
ArrayVar=ApiPayorsJson
ElementScript="""
    vars["ApiPayorName"] = element.GetProperty("name").GetString() ?? "";
    vars["ApiPayorEligible"] = element.GetProperty("payorIsEligibleForPayment").GetBoolean().ToString() ?? "";
    vars["ApiPayorAmount"] = element.GetProperty("currentAmountDue").GetDecimal().ToString() ?? "";
"""
OnSuccess=LogPayor
OnError=RestApiTestError
OnComplete=IterateCases

! --- Log payor-level fields ---
[LogPayor]
type=Log
Var=ApiPayorIdx,ApiPayorCount,ApiPayorName,ApiPayorEligible,ApiPayorAmount
Next=IteratePayors

! --- All cases processed ---
[RestApiTestDone]
type=Log
LogMsg="RestApi+ForEach test complete"
Next=RestTestMenu

! --- API call failed ---
[RestApiTestError]
type=Log
Var=ApiStatusCode,ApiError
Next=RestTestMenu


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!	TestComplete
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
[TestComplete]
type=Log

[ThankYouGoodbyeExit]
type=play
msg="Thankyou"

[Goodbye]
type=play
msg="Goodbye"
WaitForMsg=TRUE
Next=EndCall

[MenuError]
type=log
next=Goodbye

[ExitOnMaxCallSec]
type=log
next=Goodbye

[ExitOnMaxCallErrors]
type=log
next=Goodbye

[ExitOnScriptError]
type=log
next=Goodbye

[EndCallWithDisconnectHandler]                                 
type=SetGlobals
AllowOnDisconnect=False
next=EndCall

[CallDisconnectHandler]
type=Log

! Disable OnDisconnect
[EndCall]
type=SetGlobals
AllowOnDisconnect=False

! Branch here to end call with the disconnect handler
[EndCall2]                                 
type=CallControl
Command=Disconnect

[FinalBlock]
type=Terminate
LogMsg="Terminating ..."

[FinalFinalBlock]
type=Terminate